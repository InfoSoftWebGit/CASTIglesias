@{
    ViewBag.Title = L["Grupos"].Value;
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<link rel="stylesheet" href="https://cdn.datatables.net/2.0.3/css/dataTables.bootstrap5.min.css" />
<style>
    .ui-autocomplete { z-index: 9999 !important; }
    /* La fila del grupo se pulsa para abrir su ficha de encargados y miembros. */
    #tablaGrupos tbody tr.fila-grupo { cursor: pointer; }
    #tablaGrupos tbody tr.fila-detalle-abierta > td { background-color: #EEF2FB !important; }
</style>

<ol class="breadcrumb mb-4 mt-4">
    <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">@L["Información"]</a></li>
    <li class="breadcrumb-item active">@L["Grupos"]</li>
</ol>

<div class="card">
    <div class="card-header">
        <i class="fas fa-users me-1"></i> @L["Lista de Grupos"]
    </div>
    <div class="table-responsive">
        <div class="row mb-3">
            <div class="col-12">
                <button data-permiso="GruposCrearEditar" type="button" class="btn btn-success" onclick="abrirModalGrupos()">@L["Añadir nuevo grupo"]</button>
            </div>
        </div>

        <table id="tablaGrupos" class="table table-bordered table-striped border-top" style="width: 100%">
            <thead>
                <tr>
                    <th>@L["Zona"]</th>
                    <th>@L["Descripción"]</th>
                    <th>@L["Encargados"]</th>
                    <th>@L["Acciones"]</th>
                </tr>
            </thead>
            <tbody></tbody>
        </table>
    </div>
</div>

<div class="modal fade" id="FormModalGrupos" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true" data-bs-backdrop="static">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header text-white" style="background-color: #1E3A8A;">
                <h5 class="modal-title" id="exampleModalLabel">@L["Datos del nuevo grupo"]</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="@L["Cerrar"]"></button>
            </div>
            <div class="modal-body">
                <input id="txtid" type="hidden" value="0" />
                <div class="row g-2">
                    <div class="col-sm-12">
                        <label class="form-label">@L["Zona"]</label>
                        <select id="cboZona" class="form-select">
                            <option value="0" disabled selected>@L["Selecciona una zona"]</option>
                        </select>
                    </div>
                    <div class="col-sm-12">
                        <label class="form-label">@L["Descripción"]</label>
                        <input type="text" class="form-control" id="txtDescripcion" placeholder="@L["Descripción del grupo"]" autocomplete="off" />
                    </div>
                    <div class="col-sm-12">
                        <label class="form-label">@L["Encargados"]</label>
                        <input type="text" class="form-control mb-2" id="txtBuscarEncargado" placeholder="@L["Busca un miembro para añadir…"]" />
                        <div id="contenedorEncargados" class="border rounded p-2" style="min-height:48px; background:#f8f9fa; display:none;">
                            <table class="table table-sm mb-0" id="tablaEncargadosModal">
                                <tbody id="tbodyEncargados"></tbody>
                            </table>
                        </div>
                        <small class="text-muted">@L["Escribe al menos 2 letras para buscar. Pulsa sobre el nombre para añadirlo."]</small>
                    </div>
                </div>
                <div class="row mt-3">
                    <div class="col-12">
                        <div id="mensajeError" class="alert alert-danger d-none"></div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">@L["Cerrar"]</button>
                <button type="button" class="btn btn-primary" onclick="GuardarGrupo()">@L["Guardar"]</button>
            </div>
        </div>
    </div>
</div>

@section scripts {
    <script src="https://cdn.datatables.net/2.0.3/js/dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/2.0.3/js/dataTables.bootstrap5.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="https://cdn.jsdelivr.net/npm/gasparesganga-jquery-loading-overlay@2.1.7/dist/loadingoverlay.min.js"></script>
    <script src="https://code.jquery.com/ui/1.14.0/jquery-ui.min.js"></script>

    <script>
        // Textos traducidos que consume el JavaScript de esta vista.
        //
        // Se AMPLÍA window.T (ya declarado en el layout) en lugar de declarar un
        // "const T" propio: comparten ámbito global y una segunda declaración
        // const lanza SyntaxError que tumba este bloque <script> entero.
        window.T = Object.assign(window.T || {}, {
            descripcionGrupoVacia: @Json.Serialize(L["La descripción del grupo no puede estar vacía."].Value),
            eliminarGrupo:         @Json.Serialize(L["¿Desea eliminar este grupo?"].Value),
            error:                 @Json.Serialize(L["Error"].Value),
            estasSeguro:           @Json.Serialize(L["¿Estás seguro?"].Value),
            no:                    @Json.Serialize(L["No"].Value),
            si:                    @Json.Serialize(L["Sí"].Value),
            datosNuevoGrupo:       @Json.Serialize(L["Datos del nuevo grupo"].Value),
            editarGrupo:           @Json.Serialize(L["Editar grupo"].Value),
            encargados:            @Json.Serialize(L["Encargados"].Value),
            miembrosDelGrupo:      @Json.Serialize(L["Miembros del grupo"].Value),
            sinEncargados:         @Json.Serialize(L["Este grupo no tiene encargados asignados."].Value),
            sinMiembrosGrupo:      @Json.Serialize(L["Este grupo no tiene miembros asignados."].Value),
            cargando:              @Json.Serialize(L["Cargando..."].Value),
            errorDetalleGrupo:     @Json.Serialize(L["No se ha podido cargar el detalle del grupo."].Value),
            grupoGrande:           @Json.Serialize(L["Grupo numeroso"].Value),
            grupoGrandeAviso:      @Json.Serialize(L["Este grupo supera las 10 personas. Se recomienda abrir otro grupo en esta misma zona."].Value),
            personas:              @Json.Serialize(L["personas"].Value)
        });

        const urlBuscarMiembros = '@Url.Action("BuscarMiembros", "Economia")';
        const urlDetalleGrupo = '@Url.Action("DetalleGrupo", "Mantenedor")';

        // A partir de cuántas personas se avisa de que conviene dividir el grupo.
        // El aviso es una recomendación pastoral: no impide guardar ni asignar a nadie.
        const MAX_MIEMBROS_GRUPO = 10;
        let encargadosList = []; // array de nombres seleccionados
        let tabladata;
        let filaSeleccionada;

        function renderEncargados() {
            const tbody = $("#tbodyEncargados");
            tbody.empty();
            if (encargadosList.length === 0) {
                $("#contenedorEncargados").hide();
                return;
            }
            $("#contenedorEncargados").show();
            encargadosList.forEach(nombre => {
                tbody.append(`<tr>
                    <td>${nombre}</td>
                    <td style="width:36px">
                        <button type="button" class="btn btn-danger btn-sm p-1 px-2" onclick="quitarEncargado('${nombre.replace(/'/g, "\\'")}')">
                            <i class="fas fa-times"></i>
                        </button>
                    </td>
                </tr>`);
            });
        }

        function quitarEncargado(nombre) {
            encargadosList = encargadosList.filter(n => n !== nombre);
            renderEncargados();
        }

        $(document).ready(function () {
            $("#txtBuscarEncargado").autocomplete({
                source: (req, resp) => {
                    $.get(urlBuscarMiembros, { busqueda: req.term, tipoBusqueda: 'nombre' }, res => {
                        resp((res.data || []).map(m => ({
                            label: (m.nombre_miembro || '') + ' ' + (m.apellidos_miembro || ''),
                            value: (m.nombre_miembro || '') + ' ' + (m.apellidos_miembro || '')
                        })));
                    });
                },
                minLength: 2,
                select: (e, ui) => {
                    const nombre = ui.item.value.trim();
                    if (nombre && !encargadosList.includes(nombre))
                        encargadosList.push(nombre);
                    renderEncargados();
                    setTimeout(() => $("#txtBuscarEncargado").val(''), 0);
                    return false;
                }
            });

            if ($.fn.DataTable.isDataTable("#tablaGrupos")) {
                $("#tablaGrupos").DataTable().clear().destroy();
            }

            tabladata = $("#tablaGrupos").DataTable({
                responsive: true,
                order: [[0, 'asc']],
                ajax: {
                    url: '@Url.Action("ListarGrupos", "Mantenedor")',
                    type: "GET",
                    dataType: "json",
                    dataSrc: "data"
                },
                columns: [
                    { data: "nombre_zona", defaultContent: T.mSinZona },
                    {
                        data: "descripcion",
                        defaultContent: "",
                        // Junto a la descripción se muestra el aviso de grupo numeroso,
                        // para que se vea sin tener que desplegar la ficha del grupo.
                        render: function (dato, tipo, fila) {
                            const descripcion = esc(dato || "");
                            // En ordenación/búsqueda/exportación se devuelve solo el texto.
                            if (tipo !== 'display') return dato || "";
                            return descripcion + badgeGrupoNumeroso(fila.total_miembros);
                        }
                    },
                    { data: "encargados", defaultContent: "" },
                    {
                        defaultContent: `
                            <div class="d-flex justify-content-center gap-2">
                                <button data-permiso="GruposCrearEditar" type="button" class="btn btn-primary btn-sm btn-editarGrupo">
                                    <i class="fas fa-pen"></i>
                                </button>
                                <button data-permiso="GruposEliminar" type="button" class="btn btn-danger btn-sm btn-eliminarGrupo">
                                    <i class="fas fa-trash"></i>
                                </button>
                            </div>
                        `,
                        orderable: false,
                        searchable: false,
                        width: "100px"
                    }
                ],
                // Marca cada fila real de grupo (las cabeceras de zona que añade el
                // drawCallback no pasan por aquí) para que se vea que es pulsable.
                createdRow: function (row) {
                    $(row).addClass("fila-grupo");
                },
                drawCallback: function (settings) {
                    var api = this.api();
                    var rows = api.rows({ page: 'current' }).nodes();
                    var lastZona = null;

                    api.column(0, { page: 'current' }).data().each(function (zona, i) {
                        if (lastZona !== zona) {
                            $(rows).eq(i).before(
                                '<tr style="background-color:#EEF2FB;">' +
                                '<td colspan="4" style="color:#1E3A8A; font-weight:700; padding:8px 12px; border-bottom:2px solid #1E3A8A;">' +
                                '<i class="fas fa-map-marker-alt me-2"></i>' + (zona || T.mSinZona) +
                                '</td></tr>'
                            );
                            lastZona = zona;
                        }
                    });
                },
                language: window.dtLang ? { url: window.dtLang } : {},
                initComplete: function () {
                    $('#tablaGrupos thead').css({
                        'background-color': '#1E3A8A',
                        'color': 'white',
                        'text-align': 'center'
                    });
                }
            });

            // Pulsar sobre la fila abre/cierra la ficha del grupo (encargados y miembros).
            $("#tablaGrupos tbody").on("click", "tr", function (e) {
                // Los botones de acción tienen sus propios manejadores.
                if ($(e.target).closest("button").length) return;

                const fila = tabladata.row(this);
                // Las cabeceras de zona que inserta drawCallback no son filas de la tabla.
                if (!fila.any()) return;

                if (fila.child.isShown()) {
                    fila.child.hide();
                    $(this).removeClass("fila-detalle-abierta");
                    return;
                }

                const data = fila.data();
                fila.child(`<div class="p-3 text-muted"><i class="fas fa-spinner fa-spin me-2"></i>${T.cargando}</div>`).show();
                $(this).addClass("fila-detalle-abierta");

                $.get(urlDetalleGrupo, { idGrupo: data.iD_grupo })
                    .done(function (res) {
                        // Si se cerró la ficha mientras cargaba, no se repinta.
                        if (!fila.child.isShown()) return;

                        if (res.error) {
                            fila.child(`<div class="p-3 text-danger">${res.mensaje || T.errorDetalleGrupo}</div>`).show();
                            return;
                        }
                        fila.child(renderDetalleGrupo(res)).show();
                    })
                    .fail(function () {
                        if (!fila.child.isShown()) return;
                        fila.child(`<div class="p-3 text-danger">${T.errorDetalleGrupo}</div>`).show();
                    });
            });

            $("#tablaGrupos tbody").on("click", ".btn-editarGrupo", function () {
                filaSeleccionada = $(this).closest("tr");
                const data = tabladata.row(filaSeleccionada).data();
                abrirModalGrupos(data);
            });

            $("#tablaGrupos tbody").on("click", ".btn-eliminarGrupo", function () {
                const fila = $(this).closest("tr");
                const data = tabladata.row(fila).data();

                Swal.fire({
                    title: T.estasSeguro,
                    text: T.eliminarGrupo,
                    icon: "warning",
                    showCancelButton: true,
                    confirmButtonText: T.si,
                    cancelButtonText: T.no
                }).then(result => {
                    if (result.isConfirmed) {
                        $.ajax({
                            url: '@Url.Action("EliminarGrupo", "Mantenedor")',
                            type: "POST",
                            data: { id: data.iD_grupo },
                            success: function (res) {
                                if (res.resultado) {
                                    tabladata.row(fila).remove().draw();
                                } else {
                                    Swal.fire(T.error, res.mensaje, "error");
                                }
                            },
                            error: function () {
                                Swal.fire(T.error, T.mNoEliminar, "error");
                            }
                        });
                    }
                });
            });
        });

        // Escapa el texto que viene de la base de datos antes de inyectarlo en el HTML.
        function esc(valor) {
            return $("<div>").text(valor == null ? "" : valor).html();
        }

        // Distintivo de aviso para los grupos que pasan del máximo recomendado.
        // Devuelve cadena vacía si el grupo aún está por debajo del umbral.
        function badgeGrupoNumeroso(totalMiembros) {
            const total = totalMiembros || 0;
            if (total <= MAX_MIEMBROS_GRUPO) return "";

            return ` <span class="badge bg-warning text-dark ms-2" title="${esc(T.grupoGrandeAviso)}">
                        <i class="fas fa-triangle-exclamation me-1"></i>${total} ${T.personas}
                     </span>`;
        }

        // Ficha desplegable de un grupo: a la izquierda los encargados, a la derecha los
        // miembros asignados al grupo. Ambos llegan ya con nombre y apellidos separados.
        function renderDetalleGrupo(res) {
            const encargados = res.encargados || [];
            const miembros = res.miembros || [];

            // El mismo aviso que la fila, aquí explicado en texto porque hay sitio.
            const aviso = miembros.length > MAX_MIEMBROS_GRUPO
                ? `<div class="alert alert-warning py-2 px-3 mb-3">
                       <i class="fas fa-triangle-exclamation me-2"></i>
                       <strong>${T.grupoGrande}:</strong> ${T.grupoGrandeAviso}
                   </div>`
                : "";

            const listaEncargados = encargados.length === 0
                ? `<div class="text-muted">${T.sinEncargados}</div>`
                : `<ul class="list-unstyled mb-0">` + encargados.map(en => `
                    <li class="mb-1">
                        <i class="fas fa-user-tie me-2 text-secondary"></i>
                        ${esc((en.nombre_miembro || '') + ' ' + (en.apellidos_miembro || '')).trim()}
                        ${en.telefono_movil ? `<small class="text-muted ms-2">${esc(en.telefono_movil)}</small>` : ''}
                    </li>`).join('') + `</ul>`;

            const listaMiembros = miembros.length === 0
                ? `<div class="text-muted">${T.sinMiembrosGrupo}</div>`
                : `<ul class="list-unstyled mb-0">` + miembros.map(m => `
                    <li class="mb-1">
                        <i class="fas fa-user me-2 text-secondary"></i>
                        ${esc((m.nombre_miembro || '') + ' ' + (m.apellidos_miembro || '')).trim()}
                        ${m.telefono_movil ? `<small class="text-muted ms-2">${esc(m.telefono_movil)}</small>` : ''}
                    </li>`).join('') + `</ul>`;

            return `
                <div class="p-3" style="background:#f8f9fa;">
                    ${aviso}
                    <div class="row">
                        <div class="col-md-6 mb-3 mb-md-0">
                            <h6 style="color:#1E3A8A; font-weight:700;">${T.encargados}</h6>
                            ${listaEncargados}
                        </div>
                        <div class="col-md-6">
                            <h6 style="color:#1E3A8A; font-weight:700;">
                                ${T.miembrosDelGrupo} <span class="badge bg-secondary">${miembros.length}</span>
                            </h6>
                            ${listaMiembros}
                        </div>
                    </div>
                </div>`;
        }

        function cargarZonas(idZonaSeleccionada) {
            $.ajax({
                url: '@Url.Action("ListarZonas", "Mantenedor")',
                type: "GET",
                success: function (res) {
                    const cbo = $("#cboZona");
                    cbo.empty().append('<option value="0" disabled selected>Selecciona una zona</option>');
                    if (res.data && res.data.length > 0) {
                        res.data.forEach(function (z) {
                            cbo.append($("<option>").val(z.iD_zona).text(z.nombre_zona));
                        });
                    }
                    if (idZonaSeleccionada && idZonaSeleccionada !== 0) {
                        cbo.val(idZonaSeleccionada);
                    }
                }
            });
        }

        function abrirModalGrupos(json = null) {
            // El mismo modal sirve para alta y edición (GuardarGrupos decide por el ID),
            // así que el título se ajusta para que no diga siempre "nuevo grupo".
            $("#exampleModalLabel").text(json?.iD_grupo
                ? `${T.editarGrupo}: ${json.descripcion || ''}`.trim()
                : T.datosNuevoGrupo);

            $("#txtid").val(json?.iD_grupo || 0);
            $("#txtDescripcion").val(json?.descripcion || "");
            $("#txtBuscarEncargado").val("");
            $("#mensajeError").addClass("d-none").text("");

            // Poblar lista de encargados desde el string guardado
            const encStr = json?.encargados || "";
            encargadosList = encStr ? encStr.split(',').map(n => n.trim()).filter(n => n) : [];
            renderEncargados();

            cargarZonas(json?.iD_zona || null);

            const modal = new bootstrap.Modal(document.getElementById("FormModalGrupos"));
            modal.show();
        }

        function GuardarGrupo() {
            const descripcion = $("#txtDescripcion").val().trim();

            if (descripcion === "") {
                $("#mensajeError").removeClass("d-none").text(T.descripcionGrupoVacia);
                return;
            }

            const idZona = parseInt($("#cboZona").val()) || 0;
            const nombreZona = idZona > 0 ? $("#cboZona option:selected").text() : T.mSinZona;

            const Grupo = {
                iD_grupo: parseInt($("#txtid").val()) || 0,
                descripcion: descripcion,
                encargados: encargadosList.join(', '),
                iD_zona: idZona
            };

            $(".modal-body").LoadingOverlay("show", { text: "Cargando..." });

            $.ajax({
                url: '@Url.Action("GuardarGrupos", "Mantenedor")',
                type: "POST",
                data: Grupo,
                success: function (data) {
                    $(".modal-body").LoadingOverlay("hide");

                    const grupoDisplay = { ...Grupo, nombre_zona: nombreZona };

                    if (Grupo.iD_grupo === 0) {
                        if (data.resultado !== 0) {
                            grupoDisplay.iD_grupo = data.resultado;
                            tabladata.row.add(grupoDisplay).draw(false);
                            bootstrap.Modal.getInstance(document.getElementById("FormModalGrupos")).hide();
                        } else {
                            $("#mensajeError").removeClass("d-none").text(data.mensaje);
                        }
                    } else {
                        if (data.resultado) {
                            const fila = tabladata.row(filaSeleccionada);
                            // Se cierra la ficha desplegada: sus encargados ya no son los que muestra.
                            if (fila.child.isShown()) {
                                fila.child.hide();
                                $(filaSeleccionada).removeClass("fila-detalle-abierta");
                            }
                            // El formulario no toca los miembros del grupo, así que se
                            // conserva el contador para no perder el aviso de grupo numeroso.
                            grupoDisplay.total_miembros = fila.data().total_miembros || 0;
                            fila.data(grupoDisplay).draw(false);
                            filaSeleccionada = null;
                            bootstrap.Modal.getInstance(document.getElementById("FormModalGrupos")).hide();
                        } else {
                            $("#mensajeError").removeClass("d-none").text(data.mensaje);
                        }
                    }
                },
                error: function () {
                    $(".modal-body").LoadingOverlay("hide");
                    $("#mensajeError").removeClass("d-none").text(T.mErrorAjax);
                }
            });
        }
    </script>
}
