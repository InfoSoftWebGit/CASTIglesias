@{
    ViewData["Title"] = L["Calendario de Servicios"].Value;
}

<div class="container-fluid px-4" id="paginaCalendario">
    <h1 class="mt-4">@L["Calendario de Servicios"]</h1>
    <ol class="breadcrumb mb-4">
        <li class="breadcrumb-item"><a href="@Url.Action("Index", "Home")">@L["Inicio"]</a></li>
        <li class="breadcrumb-item">@L["Control"]</li>
        <li class="breadcrumb-item active">@L["Calendarios"]</li>
    </ol>

    <div class="row">
        <!-- Formulario de configuración -->
        <div class="col-lg-9">
            <div class="card mb-4">
                <div class="card-header">
                    <i class="fas fa-calendar-alt me-1"></i>
                    @L["Configuración del calendario"]
                </div>
                <div class="card-body">
                    <div class="row g-4">

                        <!-- Tipo de calendario -->
                        <div class="col-12">
                            <label class="form-label fw-semibold">@L["Tipo de calendario"]</label>
                            <div class="d-flex gap-4 flex-wrap">
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="tipoCalendario"
                                           id="tipoSeguridad" value="1" checked />
                                    <label class="form-check-label" for="tipoSeguridad">
                                        <i class="fas fa-shield-alt me-1 text-warning"></i>
                                        @L["Seguridad y Bienvenida"]
                                    </label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="tipoCalendario"
                                           id="tipoAlabanza" value="2" />
                                    <label class="form-check-label" for="tipoAlabanza">
                                        <i class="fas fa-music me-1 text-success"></i>
                                        @L["Alabanza"]
                                    </label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="tipoCalendario"
                                           id="tipoAudiovisuales" value="3" />
                                    <label class="form-check-label" for="tipoAudiovisuales">
                                        <i class="fas fa-video me-1 text-info"></i>
                                        @L["Audiovisuales"]
                                    </label>
                                </div>
                            </div>
                        </div>

                        <!-- Culto -->
                        <div class="col-md-6">
                            <label for="cboCulto" class="form-label fw-semibold">@L["Culto / Servicio"]</label>
                            <select id="cboCulto" class="form-select">
                                <option value="">@L["— Selecciona un culto —"]</option>
                            </select>
                        </div>

                        <!-- Periodicidad -->
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">@L["Periodicidad"]</label>
                            <div class="d-flex gap-3 flex-wrap">
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="periodicidad"
                                           id="perSemanal" value="semanal" />
                                    <label class="form-check-label" for="perSemanal">
                                        @L["Semanal"] <small class="text-muted">(1 semana)</small>
                                    </label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="periodicidad"
                                           id="perMensual" value="mensual" checked />
                                    <label class="form-check-label" for="perMensual">
                                        @L["Mensual"] <small class="text-muted">(1 mes)</small>
                                    </label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="periodicidad"
                                           id="perTrimestral" value="trimestral" />
                                    <label class="form-check-label" for="perTrimestral">
                                        @L["Trimestral"] <small class="text-muted">(3 meses)</small>
                                    </label>
                                </div>
                            </div>
                        </div>

                        <!-- Fecha de inicio -->
                        <div class="col-md-6">
                            <label for="txtFechaInicio" class="form-label fw-semibold">@L["Fecha de inicio"]</label>
                            <input type="date" id="txtFechaInicio" class="form-control" />
                        </div>

                    </div>

                    <div class="mt-4">
                        <button class="btn btn-primary" id="btnGenerar" onclick="generarCalendario()">
                            <i class="fas fa-calendar-check me-1"></i>
                            @L["Generar calendario"]
                        </button>
                    </div>
                </div>
            </div>

            <!-- Resultado del calendario -->
            <div id="panelCalendario" class="d-none">
                <div class="card mb-4">
                    <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
                        <span>
                            <i class="fas fa-table me-1"></i>
                            <span id="lblTituloCalendario">@L["Calendario"]</span>
                        </span>
                        <div class="d-flex gap-2 no-print flex-wrap">
                            <button class="btn btn-primary btn-sm" id="btnGuardarCalendario" data-permiso="AjustesCrearEditar"
                                    onclick="guardarCalendario()" title="@L["Guardar este calendario para consultarlo después"]">
                                <i class="fas fa-save me-1"></i> @L["Guardar"]
                            </button>
                            <button class="btn btn-success btn-sm" onclick="exportarExcel()" title="@L["Exportar solo este culto"]">
                                <i class="fas fa-file-excel me-1"></i> Excel
                            </button>
                            <button class="btn btn-outline-success btn-sm" onclick="exportarExcelTodos()" title="@L["Exportar todos los cultos en un Excel combinado"]">
                                <i class="fas fa-file-excel me-1"></i> @L["Excel Combinado"]
                            </button>
                            <button class="btn btn-danger btn-sm" onclick="exportarPdf()">
                                <i class="fas fa-file-pdf me-1"></i> @L["PDF / Imprimir"]
                            </button>
                        </div>
                    </div>
                    <div class="card-body p-0">
                        <div id="subtituloCalendario" class="px-3 pt-3 pb-1 text-muted small fst-italic"></div>
                        <div class="table-responsive">
                            <table class="table table-bordered table-sm mb-0" id="tablaCalendario">
                                <thead id="theadCalendario" class="table-dark"></thead>
                                <tbody id="tbodyCalendario"></tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Calendarios guardados: se consultan sin volver a generarlos -->
            <div class="card mb-4 no-print">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <span><i class="fas fa-folder-open me-1"></i> @L["Calendarios guardados"]</span>
                    <button class="btn btn-outline-secondary btn-sm" onclick="cargarGuardados()">
                        <i class="fas fa-rotate"></i>
                    </button>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-sm table-hover mb-0 align-middle">
                            <thead class="table-light">
                                <tr>
                                    <th>@L["Culto / Servicio"]</th>
                                    <th>@L["Tipo de calendario"]</th>
                                    <th>@L["Periodicidad"]</th>
                                    <th>@L["Período"]</th>
                                    <th class="text-end">@L["Acciones"]</th>
                                </tr>
                            </thead>
                            <tbody id="tbodyGuardados"></tbody>
                        </table>
                    </div>
                    <div class="px-3 py-2 text-muted small fst-italic">
                        @L["Los calendarios se borran solos unos días después de terminar su período."]
                    </div>
                </div>
            </div>

            <!-- Sin resultados / error -->
            <div id="panelVacio" class="d-none">
                <div class="alert alert-warning">
                    <i class="fas fa-exclamation-triangle me-2"></i>
                    <span id="msgVacio"></span>
                </div>
            </div>
        </div>

        <!-- Ayuda lateral -->
        <div class="col-lg-3 no-print">
            <div class="card mb-4 border-info">
                <div class="card-header bg-info text-white">
                    <i class="fas fa-info-circle me-1"></i> @L["Ayuda"]
                </div>
                <div class="card-body small text-muted">
                    <p><strong>@L["Tipos de calendario:"]</strong></p>
                    <ul class="ps-3">
                        <li><i class="fas fa-shield-alt text-warning me-1"></i>
                            <strong>@L["Seguridad y Bienvenida:"]</strong> acomodadores, porteros, bienvenida.
                        </li>
                        <li><i class="fas fa-music text-success me-1"></i>
                            <strong>@L["Alabanza:"]</strong> @L["tabla transpuesta (fechas como columnas, instrumentos como filas). Requiere campo"] <em>@L["Ministra"]</em> configurado.
                        </li>
                        <li><i class="fas fa-video text-info me-1"></i>
                            <strong>@L["Audiovisuales:"]</strong> @L["proyección, sonido, emisión."]
                        </li>
                    </ul>
                    <p><strong>@L["Rotación automática:"]</strong><br>
                       @L["Las personas se distribuyen de forma equitativa. Si hay 2 pianistas y el culto necesita 1, se alternarán."]</p>
                    <p><strong>@L["Requisito previo:"]</strong><br>
                       @L["Los roles del culto se configuran en"] <strong>@L["Configuración de la aplicación → Servicios"]</strong>.<br>
                       @L["Los miembros deben tener asignado su rol en sus fichas de ministerio."]</p>
                    <p class="mb-0"><strong>@L["Ministra (Alabanza):"]</strong><br>
                       @L["Marca el campo"] <em>@L["¿Puede ministrar?"]</em> @L["en la vista de Servicios del ministerio de Alabanza para que el miembro aparezca en la fila \"Ministra\"."]</p>
                </div>
            </div>
        </div>
    </div>
</div>

@section scripts {
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<style>
    /* ── Tabla calendario ────────────────────────────────────────────────────── */
    #tablaCalendario {
        font-size: 15px;
        border-collapse: separate;
        border-spacing: 0;
    }
    #tablaCalendario thead th {
        background-color: #1E3A8A;
        color: #fff;
        font-weight: 600;
        font-size: 14px;
        letter-spacing: .04em;
        text-transform: uppercase;
        padding: 12px 14px;
        border: 1px solid rgba(255,255,255,.15);
        white-space: nowrap;
        word-break: keep-all;
    }
    #tablaCalendario thead th:first-child { border-radius: 8px 0 0 0; }
    #tablaCalendario thead th:last-child  { border-radius: 0 8px 0 0; }

    #tablaCalendario tbody tr { transition: background .15s; }
    #tablaCalendario tbody tr:nth-child(odd)  td { background-color: #fff; }
    #tablaCalendario tbody tr:nth-child(even) td { background-color: #f5f8ff; }
    #tablaCalendario tbody tr:hover td { background-color: #e8eeff !important; }

    #tablaCalendario tbody td {
        padding: 10px 14px;
        vertical-align: middle;
        border: 1px solid #e2e8f0;
        font-size: 15px;
        line-height: 1.5;
    }
    /* Columna fecha en estándar */
    #tablaCalendario tbody td:first-child {
        font-weight: 600;
        color: #1E3A8A;
        white-space: nowrap;
    }

    /* Fila Ministra (Alabanza transpuesto) */
    #tablaCalendario tr.fila-ministra td:first-child {
        font-weight: 700; color: #1E3A8A; background-color: #dbeafe !important;
    }
    #tablaCalendario tr.fila-ministra td { background-color: #eff6ff !important; }

    /* Fila Zona Responsable */
    #tablaCalendario tr.fila-zona td:first-child {
        font-weight: 700; color: #166534; background-color: #dcfce7 !important;
    }
    #tablaCalendario tr.fila-zona td { background-color: #f0fdf4 !important; }

    /* Badge "sin datos" */
    .badge-vacio {
        color: #94a3b8; font-style: italic; font-size: 13px;
    }

    /* Persona sustituible (solo en los calendarios guardados) */
    .servidor-editable {
        cursor: pointer; border-radius: 6px; padding: 1px 4px;
        display: inline-block;
    }
    .servidor-editable:hover { background-color: #eff6ff; }
    .servidor-editable i { opacity: .35; }
    .servidor-editable:hover i { opacity: 1; }
    /* Al imprimir no se ve el lapicero: el papel no se puede pinchar */
    @@media print { .servidor-editable i { display: none; } }

    /* Card resultado */
    #panelCalendario .card {
        border: none;
        box-shadow: 0 4px 20px rgba(30,58,138,.10);
        border-radius: 12px;
        overflow: hidden;
    }
    #panelCalendario .card-header {
        background: linear-gradient(135deg, #1E3A8A 0%, #2563EB 100%);
        color: #fff;
        font-size: 16px;
        font-weight: 600;
        padding: 14px 20px;
        border-bottom: none;
    }
    #subtituloCalendario {
        font-size: 13px;
        color: #64748b;
        padding: 10px 20px 4px;
        border-bottom: 1px solid #e2e8f0;
    }

    /* ── Responsive móvil ───────────────────────────────────────────────────── */
    @@media (max-width: 767.98px) {
        /* Tabla compacta */
        #tablaCalendario {
            font-size: 11px;
        }
        #tablaCalendario thead th {
            font-size: 10px;
            padding: 7px 6px;
            letter-spacing: 0;
            min-width: unset !important;
            white-space: normal;
            word-break: break-word;
        }
        #tablaCalendario tbody td {
            padding: 6px 6px;
            font-size: 11px;
            line-height: 1.3;
        }
        /* Quitar nowrap para que el contenido pueda romper línea */
        #tablaCalendario tbody td:first-child {
            white-space: normal;
            min-width: 72px;
        }
        /* Scroll horizontal suave con sombra indicadora */
        .table-responsive {
            -webkit-overflow-scrolling: touch;
            overflow-x: auto;
            border-radius: 0 0 12px 12px;
            background:
                linear-gradient(to right, white 20%, rgba(255,255,255,0)),
                linear-gradient(to right, rgba(255,255,255,0), white 80%) 0 100%,
                radial-gradient(farthest-side at 0 50%, rgba(0,0,0,.10), rgba(0,0,0,0)),
                radial-gradient(farthest-side at 100% 50%, rgba(0,0,0,.10), rgba(0,0,0,0)) 0 100%;
            background-repeat: no-repeat;
            background-color: white;
            background-size: 40px 100%, 40px 100%, 14px 100%, 14px 100%;
            background-position: 0 0, 100%, 0 0, 100%;
            background-attachment: local, local, scroll, scroll;
        }
        /* Hint de scroll */
        .table-responsive::after {
            content: '← desliza para ver más →';
            display: block;
            text-align: center;
            font-size: 10px;
            color: #94a3b8;
            padding: 4px 0 6px;
            font-style: italic;
        }
        /* Card header: apilar título y botones */
        #panelCalendario .card-header {
            flex-direction: column;
            align-items: flex-start !important;
            gap: 8px !important;
            padding: 10px 14px;
            font-size: 13px;
        }
        #panelCalendario .card-header .d-flex.gap-2 {
            width: 100%;
            justify-content: flex-end;
        }
        #panelCalendario .card-header .btn-sm {
            font-size: 11px;
            padding: 4px 8px;
        }
        /* Subtítulo */
        #subtituloCalendario {
            font-size: 11px;
            padding: 8px 14px 4px;
        }
        /* Formulario de configuración */
        #paginaCalendario .card-body {
            padding: 12px;
        }
        #paginaCalendario .row.g-4 {
            --bs-gutter-y: 0.75rem;
        }
        /* Badges en Zona Responsable */
        .badge {
            font-size: 10px;
        }
    }

    @@media print {
        .sb-topnav,
        #layoutSidenav_nav,
        footer,
        .no-print,
        ol.breadcrumb,
        h1.mt-4,
        #paginaCalendario > .row > .col-lg-9 > .card:first-of-type,
        #panelVacio {
            display: none !important;
        }
        #panelCalendario {
            display: block !important;
        }
        #layoutSidenav_content {
            margin-left: 0 !important;
            padding: 0 !important;
        }
        main.sb-content { padding-top: 0 !important; }
        .container-fluid { padding-left: 0 !important; padding-right: 0 !important; }
        .card { border: 1px solid #cbd5e1 !important; box-shadow: none !important; }
        .card-header {
            background-color: #1E3A8A !important; color: white !important;
            print-color-adjust: exact; -webkit-print-color-adjust: exact;
        }
        .table-dark th {
            background-color: #1E3A8A !important; color: white !important;
            print-color-adjust: exact; -webkit-print-color-adjust: exact;
        }
        #tablaCalendario tbody tr:nth-child(odd) td {
            background-color: #f5f8ff !important;
            print-color-adjust: exact; -webkit-print-color-adjust: exact;
        }
        #tablaCalendario tr.fila-ministra td {
            background-color: #eff6ff !important;
            print-color-adjust: exact; -webkit-print-color-adjust: exact;
        }
        #tablaCalendario tr.fila-ministra td:first-child {
            background-color: #dbeafe !important;
            print-color-adjust: exact; -webkit-print-color-adjust: exact;
        }
        #tablaCalendario tr.fila-zona td {
            background-color: #f0fdf4 !important;
            print-color-adjust: exact; -webkit-print-color-adjust: exact;
        }
        @@page { margin: 1.5cm; size: landscape; }
    }
</style>

<script>
        // Textos traducidos de esta vista. Se AMPLÍA window.T (ya declarado
        // en el layout): un segundo "const T" lanzaría SyntaxError.
        window.T = Object.assign(window.T || {}, {
            periodo: @Json.Serialize(L["Período"].Value),
            mCambiarServidor:         @Json.Serialize(L["Cambiar a quien sirve"].Value),
            mDejarSinCubrir:          @Json.Serialize(L["— Dejar sin cubrir —"].Value),
            mSeleccionaPersona:       @Json.Serialize(L["Selecciona una persona"].Value),
            mGuardarCambio:           @Json.Serialize(L["Guardar cambio"].Value),
            mNoGuardarCalendario:     @Json.Serialize(L["No se pudo guardar el calendario."].Value),
            mSinCalendariosGuardados: @Json.Serialize(L["Todavía no hay calendarios guardados."].Value),
            mEliminarCalendario:      @Json.Serialize(L["¿Eliminar este calendario guardado?"].Value),
            mModificado:              @Json.Serialize(L["Modificado"].Value)
        });

    // Cabeceras para las exportaciones, que usan fetch en lugar de jQuery.
    // El $.ajaxPrefilter del layout solo alcanza a $.ajax, así que aquí el token
    // antifalsificación hay que añadirlo a mano o el servidor rechaza la petición.
    function cabecerasJson() {
        const token = document.querySelector('input[name="__RequestVerificationToken"]');
        return {
            'Content-Type': 'application/json',
            'RequestVerificationToken': token ? token.value : ''
        };
    }

    const urlCultos               = '@Url.Action("ObtenerCultos",          "Calendario")';
    const urlGenerar              = '@Url.Action("GenerarCalendario",      "Calendario")';
    const urlExportarExcel        = '@Url.Action("ExportarExcel",          "Calendario")';
    const urlExportarExcelAgrupado = '@Url.Action("ExportarExcelAgrupado", "Calendario")';
    const urlGuardar              = '@Url.Action("Guardar",                "Calendario")';
    const urlListarGuardados      = '@Url.Action("ListarGuardados",        "Calendario")';
    const urlObtenerGuardado      = '@Url.Action("ObtenerGuardado",        "Calendario")';
    const urlCandidatos           = '@Url.Action("ObtenerCandidatos",      "Calendario")';
    const urlCambiarServidor      = '@Url.Action("CambiarServidor",        "Calendario")';
    const urlEliminarGuardado     = '@Url.Action("EliminarGuardado",       "Calendario")';
    const dias = window.TDIAS;

    let requestActual = null;
    // ID del calendario guardado que se está viendo. 0 = recién generado, sin guardar.
    // Solo en uno guardado se puede sustituir a una persona: el cambio necesita saber
    // qué fila de la BBDD tocar.
    let calendarioGuardadoId = 0;

    const TIPO_SEGURIDAD     = 1;
    const TIPO_ALABANZA      = 2;
    const TIPO_AUDIOVISUALES = 3;

    $(document).ready(function () {
        const hoy = new Date();
        $('#txtFechaInicio').val(hoy.toISOString().slice(0, 10));

        $.get(urlCultos, res => {
            if (!res.success) return;
            (res.data || []).forEach(c => {
                $('#cboCulto').append($('<option>').val(c.id_culto)
                    .text(`${c.nombre} — ${dias[c.dia_semana] || ''}`));
            });
        });

        cargarGuardados();

        // Delegado: las celdas se repintan cada vez, así que el clic se escucha en la tabla
        $('#tbodyCalendario').on('click', '.servidor-editable', function () {
            sustituirServidor($(this).data('asig'));
        });
    });

    function obtenerRequest() {
        const idCulto = parseInt($('#cboCulto').val());
        if (!idCulto) {
            Swal.fire({ icon: 'warning', title: T.mSeleccionaCulto, toast: true, position: 'top-end', showConfirmButton: false, timer: 2500 });
            return null;
        }
        return {
            idCulto,
            periodicidad:   $('input[name=periodicidad]:checked').val(),
            tipoCalendario: parseInt($('input[name=tipoCalendario]:checked').val()),
            fechaInicio:    $('#txtFechaInicio').val()
        };
    }

    function generarCalendario() {
        const req = obtenerRequest();
        if (!req) return;
        requestActual = req;
        calendarioGuardadoId = 0;   // lo que se genera todavía no está guardado

        const btn = $('#btnGenerar');
        btn.prop('disabled', true).html('<i class="fas fa-spinner fa-spin me-1"></i> Generando…');

        $.ajax({
            url: urlGenerar,
            type: 'POST',
            contentType: 'application/json',
            data: JSON.stringify(req),
            success(res) {
                btn.prop('disabled', false).html('<i class="fas fa-calendar-check me-1"></i> Generar calendario');
                if (!res.success) {
                    $('#panelCalendario').addClass('d-none');
                    $('#panelVacio').removeClass('d-none');
                    $('#msgVacio').text(res.mensaje);
                    return;
                }
                $('#panelVacio').addClass('d-none');
                if (req.tipoCalendario === TIPO_ALABANZA)
                    renderAlabanza(res.data);
                else
                    renderEstandar(res.data);
                $('#panelCalendario').removeClass('d-none');
            },
            error() {
                btn.prop('disabled', false).html('<i class="fas fa-calendar-check me-1"></i> Generar calendario');
                Swal.fire('Error', T.mNoGenerarCalendario, 'error');
            }
        });
    }

    /* ── Layout estándar (Seguridad / Audiovisuales): filas=fechas, cols=roles ── */
    function renderEstandar(cal) {
        const tipo = cal.tipoCalendario;
        const [icono, tipoLabel, color] = tipo === TIPO_AUDIOVISUALES
            ? ['<i class="fas fa-video me-2"></i>', 'Audiovisuales', '#0e7490']
            : ['<i class="fas fa-shield-alt me-2"></i>', T.mSeguridadBienvenida, '#b45309'];

        actualizarCabeceras(cal,
            `${icono}Calendario de ${tipoLabel} — ${esc(cal.nombreCulto)}`);

        const roles = cal.roles || [];
        let th = '<tr><th style="min-width:110px">Fecha</th><th>Día</th>';
        roles.forEach(r => { th += `<th>${esc(r)}</th>`; });
        $('#theadCalendario').html(th + '</tr>');

        let tb = '';
        (cal.entradas || []).forEach(e => {
            const dia = e.diaSemana.length
                ? e.diaSemana[0].toUpperCase() + e.diaSemana.slice(1) : '';
            tb += `<tr>
                <td class="text-nowrap">${formatFecha(e.fecha)}</td>
                <td style="color:#475569">${esc(dia)}</td>`;
            roles.forEach(r => { tb += renderCelda(e, r); });
            tb += '</tr>';
        });
        $('#tbodyCalendario').html(tb);
    }

    /* ── Layout Alabanza: filas=roles, columnas=fechas (transpuesto) ── */
    function renderAlabanza(cal) {
        actualizarCabeceras(cal,
            `<i class="fas fa-music me-2"></i>Cronograma de Alabanza — ${esc(cal.nombreCulto)}`);

        const entradas = cal.entradas || [];
        const roles    = cal.roles    || [];

        // Cabecera: primera col = "Rol", luego una col por fecha
        let th = '<tr><th style="min-width:160px">Rol / Instrumento</th>';
        entradas.forEach(e => {
            const d = new Date(e.fecha);
            const dStr = d.toLocaleDateString('es-ES', { day: '2-digit', month: '2-digit', year: '2-digit' });
            const dayAb = e.diaSemana.length > 0
                ? e.diaSemana[0].toUpperCase() + e.diaSemana.slice(1, 3) : '';
            th += `<th class="text-center" style="min-width:120px">${dStr}<br><small style="font-weight:400;letter-spacing:0">${dayAb}</small></th>`;
        });
        $('#theadCalendario').html(th + '</tr>');

        let tb = '';
        roles.forEach(rol => {
            const esMinistra = rol.toLowerCase().includes('ministra');
            const esZona     = rol === 'Zona Responsable';
            const claseRow   = esMinistra ? 'fila-ministra' : esZona ? 'fila-zona' : '';

            tb += `<tr class="${claseRow}"><td>${esc(rol)}</td>`;
            entradas.forEach(e => { tb += renderCelda(e, rol, esZona); });
            tb += '</tr>';
        });
        $('#tbodyCalendario').html(tb);
    }

    /* ── helpers ─────────────────────────────────────────────────────── */
    function actualizarCabeceras(cal, titulo) {
        $('#lblTituloCalendario').html(titulo);
        const fi = formatFecha(cal.fechaInicio);
        const ff = formatFecha(cal.fechaFin);
        const perMap = { semanal: 'Semanal', mensual: 'Mensual', trimestral: 'Trimestral' };
        const perLabel = perMap[cal.periodicidad] || cal.periodicidad;
        $('#subtituloCalendario').html(
            `${T.periodo}: <strong>${fi}</strong> – <strong>${ff}</strong> &nbsp;|&nbsp; ${perLabel}`);
    }

    function renderPersonas(personas, esZona = false) {
        if (!personas || !personas.length)
            return '<span class="badge-vacio">—</span>';
        return personas.map(p => nombreServidor(p, esZona)).join('<br>');
    }

    // Un hueco sin cubrir llega como cadena vacía desde un calendario guardado
    function nombreServidor(p, esZona) {
        if (!p || p === '—') return '<span class="badge-vacio">—</span>';
        if (esZona) return `<span class="badge bg-success px-2">${esc(p)}</span>`;
        return esc(p);
    }

    /* Celda del calendario. En uno guardado, cada persona es pinchable para
       sustituirla; en uno recién generado no hay nada que tocar todavía. */
    function renderCelda(entrada, rol, esZona = false) {
        const personas = (entrada.asignaciones   && entrada.asignaciones[rol])   || [];
        const ids      = (entrada.idsAsignacion  && entrada.idsAsignacion[rol])  || [];

        if (!calendarioGuardadoId || !ids.length)
            return `<td class="text-center">${renderPersonas(personas, esZona)}</td>`;

        const contenido = ids.map((id, i) =>
            `<span class="servidor-editable" role="button" tabindex="0" data-asig="${id}"
                   title="${T.mCambiarServidor}">${nombreServidor(personas[i], esZona)}
             <i class="fas fa-pen-to-square text-primary ms-1 small"></i></span>`).join('<br>');

        return `<td class="text-center">${contenido}</td>`;
    }

    /* ── Guardar, consultar y sustituir ──────────────────────────────── */
    function guardarCalendario() {
        if (!requestActual) {
            Swal.fire({ icon: 'warning', title: T.mGeneraCalendarioPrimero, toast: true, position: 'top-end', showConfirmButton: false, timer: 2500 });
            return;
        }
        $.ajax({
            url: urlGuardar, type: 'POST', contentType: 'application/json',
            data: JSON.stringify(requestActual),
            success(res) {
                if (!res.success) { Swal.fire('Error', res.mensaje, 'error'); return; }
                Swal.fire({ icon: 'success', title: res.mensaje, toast: true, position: 'top-end', showConfirmButton: false, timer: 3000 });
                cargarGuardados();
                verGuardado(res.id);
            },
            error() { Swal.fire('Error', T.mNoGuardarCalendario, 'error'); }
        });
    }

    function cargarGuardados() {
        $.get(urlListarGuardados, res => {
            const cuerpo = $('#tbodyGuardados').empty();
            if (!res.success || !(res.data || []).length) {
                cuerpo.append(`<tr><td colspan="5" class="text-center text-muted py-3">${T.mSinCalendariosGuardados}</td></tr>`);
                return;
            }
            const tipos = { 1: T.mSeguridadBienvenida, 2: 'Alabanza', 3: 'Audiovisuales' };
            const pers  = { semanal: 'Semanal', mensual: 'Mensual', trimestral: 'Trimestral' };
            res.data.forEach(c => {
                cuerpo.append(`<tr>
                    <td>${esc(c.nombre_culto)}</td>
                    <td>${esc(tipos[c.tipo_calendario] || '')}</td>
                    <td>${esc(pers[c.periodicidad] || c.periodicidad)}</td>
                    <td>${formatFecha(c.fecha_inicio)} – ${formatFecha(c.fecha_fin)}
                        ${c.modificado ? `<span class="badge bg-warning text-dark ms-1">${T.mModificado}</span>` : ''}</td>
                    <td class="text-end text-nowrap">
                        <button class="btn btn-sm btn-outline-primary" onclick="verGuardado(${c.id})">
                            <i class="fas fa-eye"></i></button>
                        <button class="btn btn-sm btn-outline-danger" data-permiso="AjustesEliminar"
                                onclick="eliminarGuardado(${c.id})"><i class="fas fa-trash"></i></button>
                    </td></tr>`);
            });
            // Vuelve a aplicar el ocultado de botones por permiso a lo recién pintado
            if (typeof aplicarPermisosEnDom === 'function') aplicarPermisosEnDom(cuerpo[0]);
        });
    }

    function verGuardado(id) {
        $.get(urlObtenerGuardado, { id }, res => {
            if (!res.success) { Swal.fire('Error', res.mensaje, 'error'); return; }
            const cal = res.data;
            calendarioGuardadoId = cal.id;
            // El Excel del calendario guardado debe salir con los cambios hechos a mano,
            // así que se exporta por ID en lugar de volver a generarlo.
            requestActual = {
                idCulto: cal.idCulto, periodicidad: cal.periodicidad,
                tipoCalendario: cal.tipoCalendario, fechaInicio: cal.fechaInicio,
                idGuardado: cal.id
            };
            $('#panelVacio').addClass('d-none');
            if (cal.tipoCalendario === TIPO_ALABANZA) renderAlabanza(cal); else renderEstandar(cal);
            $('#panelCalendario').removeClass('d-none');
            document.getElementById('panelCalendario').scrollIntoView({ behavior: 'smooth' });
        });
    }

    function eliminarGuardado(id) {
        Swal.fire({
            title: T.mEliminarCalendario, icon: 'warning', showCancelButton: true,
            confirmButtonText: T.siEliminar || 'Sí, eliminar', cancelButtonText: T.cancelar || 'Cancelar'
        }).then(r => {
            if (!r.isConfirmed) return;
            $.post(urlEliminarGuardado, { id }, res => {
                if (!res.success) { Swal.fire('Error', res.mensaje, 'error'); return; }
                if (calendarioGuardadoId === id) {
                    calendarioGuardadoId = 0;
                    $('#panelCalendario').addClass('d-none');
                }
                cargarGuardados();
            });
        });
    }

    /* Sustituir a quien sirve: solo se puede elegir entre quienes tienen ese rol. */
    function sustituirServidor(idAsignacion) {
        $.get(urlCandidatos, { idAsignacion }, async res => {
            if (!res.success) { Swal.fire('Error', res.mensaje, 'error'); return; }

            const opciones = { 0: T.mDejarSinCubrir };
            (res.data || []).forEach(c => { opciones[c.id] = c.nombre; });

            const { value: idMiembro, isConfirmed } = await Swal.fire({
                title: T.mCambiarServidor,
                input: 'select',
                inputOptions: opciones,
                inputPlaceholder: T.mSeleccionaPersona,
                showCancelButton: true,
                confirmButtonText: T.mGuardarCambio,
                cancelButtonText: T.cancelar || 'Cancelar'
            });
            if (!isConfirmed) return;

            $.ajax({
                url: urlCambiarServidor, type: 'POST', contentType: 'application/json',
                data: JSON.stringify({ idAsignacion, idMiembro: parseInt(idMiembro) || 0 }),
                success(r) {
                    if (!r.success) { Swal.fire('Error', r.mensaje, 'error'); return; }
                    verGuardado(calendarioGuardadoId);
                    cargarGuardados();
                },
                error() { Swal.fire('Error', T.mNoGuardarCalendario, 'error'); }
            });
        });
    }

    async function exportarExcelTodos() {
        const idsCultos = $('#cboCulto option').map(function() {
            const v = parseInt(this.value);
            return isNaN(v) || v <= 0 ? null : v;
        }).get().filter(Boolean);

        if (!idsCultos.length) {
            Swal.fire({ icon: 'warning', title: T.mSinCultos, toast: true, position: 'top-end', showConfirmButton: false, timer: 2500 });
            return;
        }
        const req = {
            idsCultos,
            periodicidad:   $('input[name=periodicidad]:checked').val(),
            tipoCalendario: parseInt($('input[name=tipoCalendario]:checked').val()),
            fechaInicio:    $('#txtFechaInicio').val()
        };
        try {
            const resp = await fetch(urlExportarExcelAgrupado, {
                method: 'POST',
                headers: cabecerasJson(),
                body: JSON.stringify(req)
            });
            const ct = resp.headers.get('Content-Type') || '';
            if (ct.includes('application/json')) {
                const json = await resp.json();
                Swal.fire('Error', json.mensaje || T.mErrorDesconocido, 'error');
                return;
            }
            if (!resp.ok) { Swal.fire('Error', T.mNoGenerarExcelComb, 'error'); return; }
            const blob   = await resp.blob();
            const cd     = resp.headers.get('Content-Disposition') || '';
            const match  = cd.match(/filename[^;=\n]*=((['"]).*?\2|[^;\n]*)/);
            const nombre = match ? match[1].replace(/['"]/g, '') : 'CalendarioCombinado.xlsx';
            const url    = URL.createObjectURL(blob);
            const a      = document.createElement('a');
            a.href = url; a.download = nombre;
            document.body.appendChild(a); a.click(); a.remove();
            URL.revokeObjectURL(url);
        } catch {
            Swal.fire('Error', T.mNoDescargarComb, 'error');
        }
    }

    async function exportarExcel() {
        if (!requestActual) {
            Swal.fire({ icon: 'warning', title: T.mGeneraCalendarioPrimero, toast: true, position: 'top-end', showConfirmButton: false, timer: 2500 });
            return;
        }
        try {
            const resp = await fetch(urlExportarExcel, {
                method: 'POST',
                headers: cabecerasJson(),
                body: JSON.stringify(requestActual)
            });
            if (!resp.ok) { Swal.fire('Error', T.mNoGenerarExcel, 'error'); return; }
            const blob  = await resp.blob();
            const cd    = resp.headers.get('Content-Disposition') || '';
            const match = cd.match(/filename[^;=\n]*=((['"]).*?\2|[^;\n]*)/);
            const nombre = match ? match[1].replace(/['"]/g, '') : 'Calendario.xlsx';
            const url   = URL.createObjectURL(blob);
            const a     = document.createElement('a');
            a.href = url; a.download = nombre;
            document.body.appendChild(a); a.click(); a.remove();
            URL.revokeObjectURL(url);
        } catch {
            Swal.fire('Error', T.mNoDescargar, 'error');
        }
    }

    function exportarPdf() {
        if (!requestActual) {
            Swal.fire({ icon: 'warning', title: T.mGeneraCalendarioPrimero, toast: true, position: 'top-end', showConfirmButton: false, timer: 2500 });
            return;
        }
        window.print();
    }

    function formatFecha(iso) {
        if (!iso) return '';
        const d = new Date(iso);
        return isNaN(d) ? iso : d.toLocaleDateString('es-ES', { day: '2-digit', month: '2-digit', year: 'numeric' });
    }

    function esc(str) {
        if (!str) return '';
        return String(str).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
    }
</script>
}
