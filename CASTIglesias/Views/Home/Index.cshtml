@{
    ViewBag.Title = L["Dashboard"].Value;
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h1 class="mt-4">@L["Dashboard"]</h1>
<ol class="breadcrumb mb-4">
    <li class="breadcrumb-item active"></li>
</ol>

<div class="row">
    <div class="col-xl-3 col-md-6">
        <div class="card text-white mb-4" style="background-color: #6B7280;">
            <div class="card-body">
                <div class="row">
                    <div class="col-sm-9">
                        <h6>@L["Total de Visitantes"]</h6>
                        <h6 id="totalvisitantes"></h6>
                    </div>
                    <div class="col-sm-3">
                        <i class="fas fa-user-clock fa-2x"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-xl-3 col-md-6">
        <div class="card text-white mb-4" style="background-color: #00BFA5;">
            <div class="card-body">
                <div class="row">
                    <div class="col-sm-9">
                        <h6>@L["Total de Simpatizantes"]</h6>
                        <h6 id="totalsimpatizantes"></h6>
                    </div>
                    <div class="col-sm-3">
                        <i class="fas fa-user-tag fa-2x"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-xl-3 col-md-6">
        <div class="card text-white mb-4" style="background-color: #1E3A8A;">
            <div class="card-body">
                <div class="row">
                    <div class="col-sm-9">
                        <h6>@L["Total En Proceso"]</h6>
                        <h6 id="totalenproceso"></h6>
                    </div>
                    <div class="col-sm-3">
                        <i class="fas fa-user-cog fa-2x"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-xl-3 col-md-6">
        <div class="card text-white mb-4" style="background-color: #0D1B3D;">
            <div class="card-body">
                <div class="row">
                    <div class="col-sm-9">
                        <h6>@L["Total de Miembros"]</h6>
                        <h6 id="totalmiembros"></h6>
                    </div>
                    <div class="col-sm-3">
                        <i class="fas fa-user fa-2x"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-xl-3 col-md-6">
        <div class="card text-white mb-4" style="background-color: #B91C1C;">
            <div class="card-body">
                <div class="row">
                    <div class="col-sm-9">
                        <h6>@L["Total de Miembros de Baja"]</h6>
                        <h6 id="totalmiembrosbaja"></h6>
                    </div>
                    <div class="col-sm-3">
                        <i class="fas fa-user-slash fa-2x"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<hr class="my-4" />

@* Bloque inferior: las tarjetas de zona (Hombres, Jóvenes...) se insertan desde
   cargarTarjetasZonas() en esta misma fila y se ordenan junto a las fijas por
   data-orden, para que salgan seguidas de izquierda a derecha. *@
<div class="row" id="contenedor-tarjetas">
    <div class="col-xl-3 col-md-6" data-orden="2">
        <div class="card text-white mb-4" style="background-color: #A21CAF;">
            <div class="card-body">
                <div class="row">
                    <div class="col-sm-9">
                        <h6>@L["Total de Mujeres"]</h6>
                        <h6 id="totalmujeresactivas"></h6>
                    </div>
                    <div class="col-sm-3">
                        <i class="fas fa-venus fa-2x"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-xl-3 col-md-6" data-orden="4">
        <div class="card text-white mb-4" style="background-color: #D97706;">
            <div class="card-body">
                <div class="row">
                    <div class="col-sm-9">
                        <h6>@L["Total de Niños"]</h6>
                        <h6 id="totalninos"></h6>
                    </div>
                    <div class="col-sm-3">
                        <i class="fas fa-child fa-2x"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-xl-3 col-md-6" data-orden="5">
        <div class="card text-white mb-4" style="background-color: #BE185D;">
            <div class="card-body">
                <div class="row">
                    <div class="col-sm-9">
                        <h6>@L["Total de Matrimonios"]</h6>
                        <h6 id="totalmatrimonios"></h6>
                    </div>
                    <div class="col-sm-3">
                        <i class="fas fa-heart fa-2x"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-xl-3 col-md-6" data-orden="6">
        <div class="card text-white mb-4" style="background-color: #6D28D9;">
            <div class="card-body">
                <div class="row">
                    <div class="col-sm-9">
                        <h6>@L["Total de Familias"]</h6>
                        <h6 id="totalfamilias"></h6>
                    </div>
                    <div class="col-sm-3">
                        <i class="fas fa-people-roof fa-2x"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-xl-3 col-md-6" data-orden="7">
        <div class="card text-white mb-4" style="background-color: #047857;">
            <div class="card-body">
                <div class="row">
                    <div class="col-sm-9">
                        <h6>@L["Total de Líderes"]</h6>
                        <h6 id="totallideresactivos"></h6>
                    </div>
                    <div class="col-sm-3">
                        <i class="fas fa-user-tie fa-2x"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<hr class="my-4" />

<div class="card mb-4">
    <div class="card-header">
        <i class="fas fa-chart-bar me-1"></i>
        @L["Asistencia al Culto"]
    </div>
    <div class="card-body">
        <div class="row align-items-end mb-3 g-2">
            <div class="col-sm-3 col-md-2">
                <label class="form-label fw-semibold">@L["Vista"]</label>
                <select class="form-select form-select-sm" id="modoGrafico">
                    <option value="anual">@L["Año completo"]</option>
                    <option value="mensual">@L["Mes completo"]</option>
                    <option value="diario">@L["Día específico"]</option>
                </select>
            </div>
            <div class="col-sm-3 col-md-2">
                <label class="form-label fw-semibold">@L["Turno"]</label>
                <select class="form-select form-select-sm" id="turnoGrafico">
                    <option value="todos">@L["Todos"]</option>
                    <option value="mañana">@L["Mañana"]</option>
                    <option value="tarde">@L["Tarde"]</option>
                </select>
            </div>
            <div class="col-sm-2 col-md-1">
                <label class="form-label fw-semibold">@L["Año"]</label>
                <input type="number" class="form-control form-control-sm" id="anioGrafico" min="2000" max="2099" />
            </div>
            <div class="col-sm-3 col-md-2" id="colMesGrafico" style="display:none">
                <label class="form-label fw-semibold">@L["Mes"]</label>
                <select class="form-select form-select-sm" id="mesGrafico">
                    <option value="1">@L["Enero"]</option>
                    <option value="2">@L["Febrero"]</option>
                    <option value="3">@L["Marzo"]</option>
                    <option value="4">@L["Abril"]</option>
                    <option value="5">@L["Mayo"]</option>
                    <option value="6">@L["Junio"]</option>
                    <option value="7">@L["Julio"]</option>
                    <option value="8">@L["Agosto"]</option>
                    <option value="9">@L["Septiembre"]</option>
                    <option value="10">@L["Octubre"]</option>
                    <option value="11">@L["Noviembre"]</option>
                    <option value="12">@L["Diciembre"]</option>
                </select>
            </div>
            <div class="col-sm-2 col-md-1" id="colDiaGrafico" style="display:none">
                <label class="form-label fw-semibold">@L["Día"]</label>
                <input type="number" class="form-control form-control-sm" id="diaGrafico" min="1" max="31" />
            </div>
            <div class="col-sm-2 col-md-1">
                <button class="btn btn-primary btn-sm w-100" id="btnActualizarGrafico">
                    <i class="fas fa-sync-alt"></i> @L["Actualizar"]
                </button>
            </div>
        </div>
        <div style="position:relative; height:350px;">
            <canvas id="graficoAsistencia"></canvas>
        </div>
        <p class="text-muted text-center mt-2 mb-0" id="graficoSinDatos" style="display:none">
            <i class="fas fa-info-circle"></i> @L["No hay registros de asistencia para el período seleccionado."]
        </p>
    </div>
</div>

<hr class="my-4" />

