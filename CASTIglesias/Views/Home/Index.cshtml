@{
    ViewBag.Title = L["Dashboard"].Value;
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h1 class="mt-4">@L["Dashboard"]</h1>
<ol class="breadcrumb mb-4">
    <li class="breadcrumb-item active"></li>
</ol>

@{
    // Permisos de la sesión que prepara BaseController. Ocultar una tarjeta solo evita
    // enseñar enlaces inútiles: la seguridad real está en [RequierePermiso], que vuelve
    // a comprobar el permiso en cada acción (vista y contador) en el servidor.
    var permisos = ViewBag.PermisosMiembro as CapaEntidad.Permisos ?? new CapaEntidad.Permisos();

    // Cada tarjeta lleva el permiso que exige su vista, igual que el menú lateral.
    // Las bajas no tienen vista propia: son un modo de la de Miembros (?bajas=true).
    // Líderes cuelga del permiso de Miembros, como en el menú.
    var tarjetasEstado = new[]
    {
        new { Ver = permisos.Visitantes,    Accion = "Visitantes",    Bajas = false, Texto = L["Total de Visitantes"].Value,       Id = "totalvisitantes",    Color = "#6B7280", Icono = "fas fa-user-clock", Contador = "ContadorVisitantes",    Orden = 0 },
        new { Ver = permisos.Simpatizantes, Accion = "Simpatizantes", Bajas = false, Texto = L["Total de Simpatizantes"].Value,    Id = "totalsimpatizantes", Color = "#00BFA5", Icono = "fas fa-user-tag",   Contador = "ContadorSimpatizantes", Orden = 0 },
        new { Ver = permisos.Proceso,       Accion = "Proceso",       Bajas = false, Texto = L["Total En Proceso"].Value,          Id = "totalenproceso",     Color = "#1E3A8A", Icono = "fas fa-user-cog",   Contador = "ContadorEnProceso",     Orden = 0 },
        new { Ver = permisos.Miembros,      Accion = "Miembros",      Bajas = false, Texto = L["Total de Miembros"].Value,         Id = "totalmiembros",      Color = "#0D1B3D", Icono = "fas fa-user",       Contador = "ContadorMiembros",      Orden = 0 },
        new { Ver = permisos.Miembros,      Accion = "Miembros",      Bajas = true,  Texto = L["Total de Miembros de Baja"].Value, Id = "totalmiembrosbaja",  Color = "#B91C1C", Icono = "fas fa-user-slash", Contador = "ContadorMiembrosBaja",  Orden = 0 }
    }.Where(t => t.Ver).ToList();

    // Las siete tarjetas por defecto ocupan los huecos 1..7; las zonas propias de cada
    // iglesia se añaden detrás desde cargarTarjetasZonas().
    var tarjetasDiscipulado = new[]
    {
        new { Ver = permisos.Hombres,     Accion = "Hombres",     Bajas = false, Texto = L["Total de Hombres"].Value,     Id = "totalhombres",        Color = "#1D4ED8", Icono = "fas fa-mars",        Contador = "ContadorHombres",        Orden = 1 },
        new { Ver = permisos.Mujeres,     Accion = "Mujeres",     Bajas = false, Texto = L["Total de Mujeres"].Value,     Id = "totalmujeresactivas", Color = "#A21CAF", Icono = "fas fa-venus",       Contador = "ContadorMujeresActivas", Orden = 2 },
        new { Ver = permisos.Jovenes,     Accion = "Jovenes",     Bajas = false, Texto = L["Total de Jóvenes"].Value,     Id = "totaljovenes",        Color = "#0E7490", Icono = "fas fa-user-group",  Contador = "ContadorJovenes",        Orden = 3 },
        new { Ver = permisos.Ninos,       Accion = "Ninos",       Bajas = false, Texto = L["Total de Niños"].Value,       Id = "totalninos",          Color = "#D97706", Icono = "fas fa-child",       Contador = "ContadorNinos",          Orden = 4 },
        new { Ver = permisos.Matrimonios, Accion = "Matrimonios", Bajas = false, Texto = L["Total de Matrimonios"].Value, Id = "totalmatrimonios",    Color = "#BE185D", Icono = "fas fa-heart",       Contador = "ContadorMatrimonios",    Orden = 5 },
        new { Ver = permisos.Familias,    Accion = "Familias",    Bajas = false, Texto = L["Total de Familias"].Value,    Id = "totalfamilias",       Color = "#6D28D9", Icono = "fas fa-people-roof", Contador = "ContadorFamilias",       Orden = 6 },
        new { Ver = permisos.Miembros,    Accion = "Lideres",     Bajas = false, Texto = L["Total de Líderes"].Value,     Id = "totallideresactivos", Color = "#047857", Icono = "fas fa-user-tie",    Contador = "ContadorLideresActivos", Orden = 7 }
    }.Where(t => t.Ver).ToList();
}

@* Aviso que deja [RequierePermiso] al devolver aquí a quien intentó entrar sin permiso *@
@if (TempData["MensajeAcceso"] is string mensajeAcceso)
{
    <div class="alert alert-warning" role="alert">
        <i class="fas fa-lock me-1"></i> @L[mensajeAcceso]
    </div>
}

@* Cada tarjeta es un enlace a su vista: el <a> envuelve la tarjeta entera para
   que toda su superficie sea clicable y siga siendo accesible por teclado.
   El número lo rellena el JavaScript a partir de data-contador. *@
<style>
    .tarjeta-enlace { display: block; text-decoration: none; color: inherit; }
    .tarjeta-enlace .card { transition: transform .15s ease, box-shadow .15s ease; }
    .tarjeta-enlace:hover .card { transform: translateY(-3px); box-shadow: 0 .5rem 1rem rgba(0,0,0,.2); }
    .tarjeta-enlace:focus-visible .card { outline: 3px solid #0d6efd; outline-offset: 2px; }
</style>

@if (tarjetasEstado.Count > 0)
{
    <div class="row">
        @foreach (var t in tarjetasEstado)
        {
            <div class="col-xl-3 col-md-6">
                <a class="tarjeta-enlace" href="@Url.Action(t.Accion, "Congregantes", t.Bajas ? new { bajas = true } : null)">
                    <div class="card text-white mb-4" style="background-color: @t.Color;">
                        <div class="card-body">
                            <div class="row">
                                <div class="col-sm-9">
                                    <h6>@L[t.Texto]</h6>
                                    <h6 id="@t.Id" data-contador="@Url.Action(t.Contador, "Congregantes")"></h6>
                                </div>
                                <div class="col-sm-3">
                                    <i class="@t.Icono fa-2x"></i>
                                </div>
                            </div>
                        </div>
                    </div>
                </a>
            </div>
        }
    </div>

    <hr class="my-4" />
}

@* Bloque inferior: cada tarjeta por defecto aparece siempre que haya permiso, aunque
   su contador sea 0. El contenedor se pinta aunque quede vacío porque
   cargarTarjetasZonas() añade ahí las zonas propias de la iglesia. *@
<div class="row" id="contenedor-tarjetas">
    @foreach (var t in tarjetasDiscipulado)
    {
        <div class="col-xl-3 col-md-6" data-orden="@t.Orden">
            <a class="tarjeta-enlace" href="@Url.Action(t.Accion, "Congregantes")">
                <div class="card text-white mb-4" style="background-color: @t.Color;">
                    <div class="card-body">
                        <div class="row">
                            <div class="col-sm-9">
                                <h6>@L[t.Texto]</h6>
                                <h6 id="@t.Id" data-contador="@Url.Action(t.Contador, "Congregantes")"></h6>
                            </div>
                            <div class="col-sm-3">
                                <i class="@t.Icono fa-2x"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </a>
        </div>
    }
</div>

