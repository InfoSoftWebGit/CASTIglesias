@section scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.4/dist/chart.umd.min.js"></script>

    <script>
        // Se AMPLÍA window.T (ya declarado en el layout): un segundo "const T"
        // lanzaría SyntaxError y tumbaría este bloque <script> entero.
        window.T = Object.assign(window.T || {}, {
            totalEnZona: @Json.Serialize(L["Total en zona {0}"].Value),
            ninos:       @Json.Serialize(L["Niños"].Value),
            adultos:     @Json.Serialize(L["Adultos"].Value),
            invitadosVisitantes: @Json.Serialize(L["Invitados / Visitantes"].Value),
            gastos:      @Json.Serialize(L["Gastos"].Value)
        });

        // Hueco fijo de cada tarjeta en la fila inferior. Las zonas propias de cada
        // iglesia (tipo 'general') no tienen hueco reservado y van al final.
        const ORDEN_TIPO_ZONA = {
            hombres: 1, mujeres: 2, jovenes: 3, ninos: 4, matrimonios: 5, familias: 6
        };

        function cargarTarjetasZonas() {
            $.get('@Url.Action("ObtenerZonasConMiembros", "Home")', function (data) {
                const contenedor = $('#contenedor-tarjetas');
                // Solo se limpian las tarjetas de zona: las fijas están en el HTML.
                contenedor.children('[data-zona]').remove();

                if (Array.isArray(data) && data.length > 0) {
                    data.forEach(function (zona) {
                        const orden = ORDEN_TIPO_ZONA[zona.tipo] ?? 99;
                        const tarjetaHtml = `
                            <div class="col-xl-3 col-md-6" data-zona="1" data-orden="${orden}">
                                <div class="card text-white mb-4" style="background-color: #1E3A8A;">
                                    <div class="card-body">
                                        <div class="row">
                                            <div class="col-sm-9">
                                                @* tDato() traduce los nombres de zona que crea la
                                                   aplicación (Hombres, Mujeres, Niños, Jóvenes) y
                                                   deja intactos los que crea cada iglesia. *@
                                                <h6>${fmt(T.totalEnZona, tDato(zona.nombre_zona))}</h6>
                                                <h6>${zona.total_miembros}</h6>
                                            </div>
                                            <div class="col-sm-3">
                                                <i class="fa-solid fa-users fa-2x"></i>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>`;
                        contenedor.append(tarjetaHtml);
                    });
                }

                // Reordena fijas y de zona en un único flujo de izquierda a derecha.
                contenedor.children().sort(function (a, b) {
                    return (+a.dataset.orden) - (+b.dataset.orden);
                }).appendTo(contenedor);
            });
        }

        $(document).ready(function () {
            $.get('@Url.Action("ContadorMiembros", "Congregantes")', function (data) {
                $("#totalmiembros").text(data.resultado ?? 0);
            }).fail(function () { $("#totalmiembros").text('Error'); });

            $.get('@Url.Action("ContadorMiembrosBaja", "Congregantes")', function (data) {
                $("#totalmiembrosbaja").text(data.resultado ?? 0);
            }).fail(function () { $("#totalmiembrosbaja").text('Error'); });

            $.get('@Url.Action("ContadorVisitantes", "Congregantes")', function (data) {
                $("#totalvisitantes").text(data.resultado ?? 0);
            }).fail(function () { $("#totalvisitantes").text('Error'); });

            $.get('@Url.Action("ContadorSimpatizantes", "Congregantes")', function (data) {
                $("#totalsimpatizantes").text(data.resultado ?? 0);
            }).fail(function () { $("#totalsimpatizantes").text('Error'); });

            $.get('@Url.Action("ContadorEnProceso", "Congregantes")', function (data) {
                $("#totalenproceso").text(data.resultado ?? 0);
            }).fail(function () { $("#totalenproceso").text('Error'); });

            $.get('@Url.Action("ContadorFamilias", "Congregantes")', function (data) {
                $("#totalfamilias").text(data.resultado ?? 0);
            }).fail(function () { $("#totalfamilias").text('Error'); });

            $.get('@Url.Action("ContadorMatrimonios", "Congregantes")', function (data) {
                $("#totalmatrimonios").text(data.resultado ?? 0);
            }).fail(function () { $("#totalmatrimonios").text('Error'); });

            $.get('@Url.Action("ContadorMujeresActivas", "Congregantes")', function (data) {
                $("#totalmujeresactivas").text(data.resultado ?? 0);
            }).fail(function () { $("#totalmujeresactivas").text('Error'); });

            $.get('@Url.Action("ContadorNinos", "Congregantes")', function (data) {
                $("#totalninos").text(data.resultado ?? 0);
            }).fail(function () { $("#totalninos").text('Error'); });

            $.get('@Url.Action("ContadorLideresActivos", "Congregantes")', function (data) {
                $("#totallideresactivos").text(data.resultado ?? 0);
            }).fail(function () { $("#totallideresactivos").text('Error'); });

            cargarTarjetasZonas();
        });
    </script>

    <script>
        // ── Gráfico de Asistencia al Culto ──────────────────────────────
        let graficoAsistenciaInstance = null;

        const hoy = new Date();
        $('#anioGrafico').val(hoy.getFullYear());
        $('#mesGrafico').val(hoy.getMonth() + 1);
        $('#diaGrafico').val(hoy.getDate());

        function actualizarVisibilidadFiltros() {
            const modo = $('#modoGrafico').val();
            $('#colMesGrafico').toggle(modo === 'mensual' || modo === 'diario');
            $('#colDiaGrafico').toggle(modo === 'diario');
        }

        function cargarGraficoAsistencia() {
            const modo = $('#modoGrafico').val();
            const anio = $('#anioGrafico').val();
            const mes  = $('#mesGrafico').val();
            const dia  = $('#diaGrafico').val();

            const turno = $('#turnoGrafico').val();
            const params = { modo, anio, turno };
            if (modo === 'mensual' || modo === 'diario') params.mes = mes;
            if (modo === 'diario') params.dia = dia;

            $.get('@Url.Action("ObtenerGraficoAsistencia", "Home")', params, function (data) {
                $('#graficoSinDatos').toggle(!data || data.length === 0);

                const labels    = data.map(d => d.etiqueta);
                const adultos   = data.map(d => d.adultos);
                const ninos     = data.map(d => d.ninos);
                const invitados = data.map(d => d.invitados);

                if (graficoAsistenciaInstance) {
                    graficoAsistenciaInstance.destroy();
                    graficoAsistenciaInstance = null;
                }

                if (!data || data.length === 0) return;

                graficoAsistenciaInstance = new Chart(
                    document.getElementById('graficoAsistencia'),
                    {
                        type: 'bar',
                        data: {
                            labels,
                            datasets: [
                                {
                                    label: T.adultos,
                                    data: adultos,
                                    backgroundColor: 'rgba(54, 162, 235, 0.75)',
                                    borderColor:     'rgba(54, 162, 235, 1)',
                                    borderWidth: 1
                                },
                                {
                                    label: T.ninos,
                                    data: ninos,
                                    backgroundColor: 'rgba(75, 192, 192, 0.75)',
                                    borderColor:     'rgba(75, 192, 192, 1)',
                                    borderWidth: 1
                                },
                                {
                                    label: T.invitadosVisitantes,
                                    data: invitados,
                                    backgroundColor: 'rgba(255, 159, 64, 0.75)',
                                    borderColor:     'rgba(255, 159, 64, 1)',
                                    borderWidth: 1
                                }
                            ]
                        },
                        options: {
                            responsive: true,
                            maintainAspectRatio: false,
                            plugins: {
                                legend: { position: 'top' },
                                tooltip: {
                                    callbacks: {
                                        footer: function (items) {
                                            const total = items.reduce((s, i) => s + i.parsed.y, 0);
                                            return 'Total: ' + total;
                                        }
                                    }
                                }
                            },
                            scales: {
                                x: { stacked: false },
                                y: {
                                    beginAtZero: true,
                                    ticks: { stepSize: 1, precision: 0 }
                                }
                            }
                        }
                    }
                );
            }).fail(function () {
                $('#graficoSinDatos').show();
            });
        }

        $('#modoGrafico').on('change', function () { actualizarVisibilidadFiltros(); });
        $('#btnActualizarGrafico').on('click', cargarGraficoAsistencia);

        $(document).ready(function () {
            actualizarVisibilidadFiltros();
            cargarGraficoAsistencia();
        });
    </script>

    <script>
        // ── Gráfico de Diezmos por Concepto ──────────────────────────────
        let graficoDiemosInstance = null;

        const coloresDiezmo = [
            { bg: 'rgba( 30,  58, 138, 0.8)', border: 'rgba( 30,  58, 138, 1)' },
            { bg: 'rgba(  0, 191, 165, 0.8)', border: 'rgba(  0, 191, 165, 1)' },
            { bg: 'rgba(245, 158,  11, 0.8)', border: 'rgba(245, 158,  11, 1)' },
            { bg: 'rgba(239,  68,  68, 0.8)', border: 'rgba(239,  68,  68, 1)' },
            { bg: 'rgba(139,  92, 246, 0.8)', border: 'rgba(139,  92, 246, 1)' },
            { bg: 'rgba(236,  72, 153, 0.8)', border: 'rgba(236,  72, 153, 1)' },
            { bg: 'rgba( 16, 185, 129, 0.8)', border: 'rgba( 16, 185, 129, 1)' },
            { bg: 'rgba(251, 146,  60, 0.8)', border: 'rgba(251, 146,  60, 1)' },
        ];

        const hoyDiezmo = new Date();
        $('#anioDiezmo').val(hoyDiezmo.getFullYear());
        $('#mesDiezmo').val(hoyDiezmo.getMonth() + 1);

        $('#modoDiezmo').on('change', function () {
            $('#colMesDiezmo').toggle($(this).val() === 'mensual');
        });

        function cargarGraficoDiezmos() {
            const modo = $('#modoDiezmo').val();
            const anio = $('#anioDiezmo').val();
            const mes  = $('#mesDiezmo').val();
            const params = { modo, anio };
            if (modo === 'mensual') params.mes = mes;

            $.get('@Url.Action("ObtenerGraficoDiezmos", "Home")', params, function (res) {
                const sinDatos = !res.series || res.series.length === 0 ||
                                 res.series.every(s => s.datos.every(v => v === 0));
                $('#diezmoSinDatos').toggle(sinDatos);

                if (graficoDiemosInstance) {
                    graficoDiemosInstance.destroy();
                    graficoDiemosInstance = null;
                }
                if (sinDatos) return;

                const datasets = res.series.map(function (s, i) {
                    const c = coloresDiezmo[i % coloresDiezmo.length];
                    return {
                        label: s.concepto,
                        data: s.datos,
                        backgroundColor: c.bg,
                        borderColor: c.border,
                        borderWidth: 1
                    };
                });

                graficoDiemosInstance = new Chart(document.getElementById('graficoDiezmos'), {
                    type: 'bar',
                    data: { labels: res.labels, datasets },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: {
                            legend: { position: 'top' },
                            tooltip: {
                                callbacks: {
                                    label: function (item) {
                                        return ` ${item.dataset.label}: ${parseFloat(item.parsed.y).toLocaleString('es-ES', { style: 'currency', currency: 'EUR' })}`;
                                    },
                                    footer: function (items) {
                                        const total = items.reduce((s, i) => s + i.parsed.y, 0);
                                        return 'Total: ' + parseFloat(total).toLocaleString('es-ES', { style: 'currency', currency: 'EUR' });
                                    }
                                }
                            }
                        },
                        scales: {
                            x: { stacked: false },
                            y: {
                                beginAtZero: true,
                                ticks: {
                                    callback: function (val) {
                                        return parseFloat(val).toLocaleString('es-ES', {
                                            style: 'currency', currency: 'EUR',
                                            minimumFractionDigits: 0, maximumFractionDigits: 0
                                        });
                                    }
                                }
                            }
                        }
                    }
                });
            }).fail(function () {
                $('#diezmoSinDatos').show();
            });
        }

        $('#btnActualizarDiezmo').on('click', cargarGraficoDiezmos);

        $(document).ready(function () {
            cargarGraficoDiezmos();
        });
    </script>

    <script>
        // ── Gráfico de Gastos ──────────────────────────────────────────────
        let graficoGastosInstance = null;

        const hoyGasto = new Date();
        $('#anioGasto').val(hoyGasto.getFullYear());
        $('#mesGasto').val(hoyGasto.getMonth() + 1);

        $('#modoGasto').on('change', function () {
            $('#colMesGasto').toggle($(this).val() === 'mensual');
        });

        function cargarGraficoGastos() {
            const modo = $('#modoGasto').val();
            const anio = $('#anioGasto').val();
            const mes  = $('#mesGasto').val();
            const params = { modo, anio };
            if (modo === 'mensual') params.mes = mes;

            $.get('@Url.Action("ObtenerGraficoGastos", "Home")', params, function (res) {
                const sinDatos = !res.totales || res.totales.every(v => v === 0);
                $('#gastoSinDatos').toggle(sinDatos);

                if (graficoGastosInstance) {
                    graficoGastosInstance.destroy();
                    graficoGastosInstance = null;
                }
                if (sinDatos) return;

                const zonaBreakdown = res.zonaBreakdown || [];

                graficoGastosInstance = new Chart(document.getElementById('graficoGastos'), {
                    type: 'bar',
                    data: {
                        labels: res.labels,
                        datasets: [{
                            label: T.gastos,
                            data: res.totales,
                            backgroundColor: 'rgba(239, 68, 68, 0.75)',
                            borderColor: 'rgba(239, 68, 68, 1)',
                            borderWidth: 1
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: {
                            legend: { display: false },
                            tooltip: {
                                callbacks: {
                                    label: function (item) {
                                        return ' Total: ' + parseFloat(item.parsed.y).toLocaleString('es-ES', { style: 'currency', currency: 'EUR' });
                                    },
                                    afterBody: function (items) {
                                        const idx = items[0].dataIndex;
                                        const lineas = [];
                                        zonaBreakdown.forEach(function (z) {
                                            const val = z.datos[idx];
                                            if (val && val > 0) {
                                                lineas.push(' ' + z.zona + ': ' + parseFloat(val).toLocaleString('es-ES', { style: 'currency', currency: 'EUR' }));
                                            }
                                        });
                                        if (lineas.length > 0) {
                                            lineas.unshift('──────────────────');
                                        }
                                        return lineas;
                                    }
                                }
                            }
                        },
                        scales: {
                            x: { stacked: false },
                            y: {
                                beginAtZero: true,
                                ticks: {
                                    callback: function (val) {
                                        return parseFloat(val).toLocaleString('es-ES', {
                                            style: 'currency', currency: 'EUR',
                                            minimumFractionDigits: 0, maximumFractionDigits: 0
                                        });
                                    }
                                }
                            }
                        }
                    }
                });
            }).fail(function () {
                $('#gastoSinDatos').show();
            });
        }

        $('#btnActualizarGasto').on('click', cargarGraficoGastos);

        $(document).ready(function () {
            cargarGraficoGastos();
        });
    </script>
}