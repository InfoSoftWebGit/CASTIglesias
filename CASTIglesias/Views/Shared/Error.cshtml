@model ErrorViewModel
@{
    ViewData["Title"] = L["Error"].Value;
}

@* Esta vista venía entera en inglés desde la plantilla original de ASP.NET, así
   que un usuario español que provocaba un error veía el mensaje en inglés. Se
   reescribe en español (el idioma de las claves) y el .resx devuelve el inglés
   cuando corresponde. *@

<h1 class="text-danger">@L["Se ha producido un error."]</h1>
<h2 class="text-danger">@L["Ha ocurrido un problema al procesar tu solicitud."]</h2>

@if (Model.ShowRequestId)
{
    <p>
        <strong>@L["Identificador de la petición:"]</strong> <code>@Model.RequestId</code>
    </p>
}

<h3>@L["Modo de desarrollo"]</h3>
<p>
    @L["Cambiar al entorno de desarrollo mostrará información más detallada sobre el error."]
</p>
<p>
    <strong>@L["El entorno de desarrollo no debe habilitarse en aplicaciones publicadas."]</strong>
    @L["Puede exponer a los usuarios información sensible procedente de las excepciones."]
    @L["Para depurar en local, activa el entorno de desarrollo asignando el valor Development a la variable de entorno ASPNETCORE_ENVIRONMENT y reiniciando la aplicación."]
</p>
