@* ─────────────────────────────────────────────────────────────────────────────
   Banner de consentimiento de cookies.

   Va justo antes de </body> en las páginas que incluyen _GoogleTagManager.cshtml
   (que define window.CongregaConsent). Es autosuficiente: estilos y script
   propios, sin depender de Bootstrap ni de jQuery.

   Requisitos de la guía de cookies de la AEPD (2023) que cumple:
   - "Rechazar" está en la primera capa, con el mismo tamaño, color y
     posición destacada que "Aceptar". Rechazar no cuesta más clics.
   - En "Configurar" las casillas opcionales salen DESMARCADAS.
   - No bloquea la navegación (no es un muro de cookies).
   - Se puede cambiar de opinión cuando se quiera: cualquier elemento con
     el atributo data-abrir-cookies (p. ej. el enlace del pie) reabre el panel.
   - La decisión dura 12 meses; después se vuelve a preguntar.
   ───────────────────────────────────────────────────────────────────────────── *@
<div id="cgCookies" class="cg-cookies" role="dialog" aria-modal="false"
     aria-labelledby="cgCookiesTitulo" aria-describedby="cgCookiesTexto" hidden>
    <div class="cg-cookies-caja">
        <div class="cg-cookies-titulo" id="cgCookiesTitulo">🍪 @L["Tu privacidad"]</div>
        <p class="cg-cookies-texto" id="cgCookiesTexto">
            @L["Usamos cookies técnicas necesarias para que la web funcione y, solo si nos das permiso, cookies analíticas de Google para saber cuántas personas nos visitan. No usamos cookies publicitarias. Puedes aceptarlas o rechazarlas."]
            <a href="/cookies">@L["Política de cookies"]</a>
        </p>

        <div class="cg-cookies-opciones" id="cgCookiesOpciones" hidden>
            <label class="cg-cookies-opcion">
                <input type="checkbox" checked disabled />
                <span>
                    <strong>@L["Necesarias"]</strong> · <em>@L["Siempre activas"]</em><br />
                    @L["Hacen funcionar la web: sesión, seguridad de los formularios e idioma."]
                </span>
            </label>
            <label class="cg-cookies-opcion">
                <input type="checkbox" id="cgCookiesAnalitica" />
                <span>
                    <strong>@L["Analítica"]</strong><br />
                    @L["Google Analytics: cuántas personas nos visitan y qué páginas ven, para mejorar la web."]
                </span>
            </label>
        </div>

        <div class="cg-cookies-botones">
            <button type="button" class="cg-cookies-btn" data-cg-accion="rechazar">@L["Rechazar"]</button>
            <button type="button" class="cg-cookies-btn cg-cookies-btn-sec" data-cg-accion="configurar" id="cgCookiesBtnConfigurar">@L["Configurar"]</button>
            <button type="button" class="cg-cookies-btn cg-cookies-btn-sec" data-cg-accion="guardar" id="cgCookiesBtnGuardar" hidden>@L["Guardar selección"]</button>
            <button type="button" class="cg-cookies-btn" data-cg-accion="aceptar">@L["Aceptar"]</button>
        </div>
    </div>
</div>

<style>
    .cg-cookies {
        position: fixed; left: 0; right: 0; bottom: 0; z-index: 2000;
        padding: 16px; pointer-events: none;
        font-family: 'Inter', system-ui, -apple-system, 'Segoe UI', sans-serif;
    }
    .cg-cookies[hidden] { display: none; }
    .cg-cookies-caja {
        pointer-events: auto;
        max-width: 960px; margin: 0 auto;
        background: #0D1B3D; color: #E5E7EB;
        border-radius: 14px; padding: 20px 22px;
        box-shadow: 0 12px 40px rgba(0,0,0,0.35);
    }
    .cg-cookies-titulo { font-weight: 700; font-size: 1rem; color: #fff; margin-bottom: 6px; }
    .cg-cookies-texto  { font-size: 0.88rem; line-height: 1.6; margin: 0 0 14px; }
    .cg-cookies-texto a { color: #00BFA5; text-decoration: underline; }
    .cg-cookies-opciones { display: grid; gap: 10px; margin-bottom: 16px; }
    .cg-cookies-opciones[hidden] { display: none; }
    .cg-cookies-opcion {
        display: flex; gap: 10px; align-items: flex-start;
        font-size: 0.85rem; line-height: 1.5; cursor: pointer;
        background: rgba(255,255,255,0.06); border-radius: 10px; padding: 10px 12px;
    }
    .cg-cookies-opcion input { margin-top: 4px; width: 16px; height: 16px; flex: 0 0 auto; accent-color: #00BFA5; }
    .cg-cookies-opcion strong { color: #fff; }
    .cg-cookies-botones { display: flex; flex-wrap: wrap; gap: 10px; justify-content: flex-end; }
    /* Aceptar y Rechazar comparten exactamente el mismo estilo: la AEPD no
       permite destacar uno sobre otro para empujar a aceptar. */
    .cg-cookies-btn {
        min-width: 130px; padding: 10px 18px; border-radius: 8px;
        font-size: 0.9rem; font-weight: 600; cursor: pointer;
        background: #fff; color: #0D1B3D; border: 2px solid #fff;
    }
    .cg-cookies-btn:hover { background: #E5E7EB; border-color: #E5E7EB; }
    .cg-cookies-btn-sec { background: transparent; color: #fff; }
    .cg-cookies-btn-sec:hover { background: rgba(255,255,255,0.12); border-color: #fff; }
    .cg-cookies-btn[hidden] { display: none; }
    .cg-cookies-btn:focus-visible, .cg-cookies-opcion input:focus-visible { outline: 3px solid #00BFA5; outline-offset: 2px; }
    @@media (max-width: 575px) {
        .cg-cookies { padding: 10px; }
        /* Rechazar y Aceptar en la misma fila y al mismo ancho; Configurar debajo. */
        .cg-cookies-btn { flex: 1 1 calc(50% - 5px); min-width: 0; }
        .cg-cookies-btn-sec { order: 3; flex-basis: 100%; }
    }
</style>

<script>
(function (w, d) {
    var banner = d.getElementById('cgCookies');
    if (!banner || !w.CongregaConsent) return;

    var opciones      = d.getElementById('cgCookiesOpciones');
    var chkAnalitica  = d.getElementById('cgCookiesAnalitica');
    var btnConfigurar = d.getElementById('cgCookiesBtnConfigurar');
    var btnGuardar    = d.getElementById('cgCookiesBtnGuardar');

    var DOCE_MESES = 60 * 60 * 24 * 365;

    function guardar(c) {
        var anterior = w.CongregaConsent.leer();
        var valor = 'v1.a' + (c.analitica ? 1 : 0) + '.p' + (c.publicidad ? 1 : 0) + '.' + Date.now();
        d.cookie = 'cg_consent=' + encodeURIComponent(valor) +
                   '; max-age=' + DOCE_MESES + '; path=/; SameSite=Lax' +
                   (location.protocol === 'https:' ? '; Secure' : '');

        var retira = anterior && ((anterior.analitica && !c.analitica) || (anterior.publicidad && !c.publicidad));
        if (retira) borrarCookiesGoogle();

        w.CongregaConsent.aplicar(c);
        cerrar();

        // Si retira un permiso con Google ya cargado, se recarga la página para
        // descargarlo del todo; el consentimiento ya quedó guardado.
        if (retira && w.CongregaConsent.gtmCargado()) location.reload();
    }

    // Al retirar el permiso hay que quitar lo que Google ya dejó instalado.
    function borrarCookiesGoogle() {
        var nombres = d.cookie.split(';').map(function (c) { return c.split('=')[0].trim(); })
            .filter(function (n) { return /^(_ga|_gid|_gat|_gcl|_gac)/.test(n); });
        var partes = location.hostname.split('.');
        var dominios = [''];
        for (var i = 0; i < partes.length - 1; i++) dominios.push('; domain=.' + partes.slice(i).join('.'));
        nombres.forEach(function (n) {
            dominios.forEach(function (dom) {
                d.cookie = n + '=; max-age=0; path=/' + dom;
            });
        });
    }

    function mostrarOpciones(ver) {
        opciones.hidden = !ver;
        btnConfigurar.hidden = ver;
        btnGuardar.hidden = !ver;
    }

    function abrir(conOpciones) {
        var actual = w.CongregaConsent.leer();
        chkAnalitica.checked  = !!(actual && actual.analitica);
        mostrarOpciones(!!conOpciones);
        banner.hidden = false;
    }

    function cerrar() { banner.hidden = true; }

    banner.addEventListener('click', function (e) {
        var btn = e.target.closest('[data-cg-accion]');
        if (!btn) return;
        switch (btn.getAttribute('data-cg-accion')) {
            // No hay cookies publicitarias: el contenedor de GTM no tiene etiquetas
            // de Google Ads. Si algún día se añaden, habrá que volver a poner aquí
            // la categoría "Publicidad", subir la cookie a "v2" y actualizar la
            // política de cookies.
            case 'aceptar':    guardar({ analitica: true,  publicidad: false }); break;
            case 'rechazar':   guardar({ analitica: false, publicidad: false }); break;
            case 'configurar': mostrarOpciones(true); chkAnalitica.focus(); break;
            case 'guardar':    guardar({ analitica: chkAnalitica.checked, publicidad: false }); break;
        }
    });

    // Enlace "Configurar cookies" del pie (o cualquier otro con este atributo).
    d.addEventListener('click', function (e) {
        var enlace = e.target.closest('[data-abrir-cookies]');
        if (!enlace) return;
        e.preventDefault();
        abrir(true);
    });

    if (!w.CongregaConsent.leer()) abrir(false);
})(window, document);
</script>
