@using CASTIglesias.Controllers
@*
    Menú lateral del área financiera.

    Se pinta en lugar del de congregación cuando la pantalla hereda de
    AreaFinancieraController. Solo aparecen aquí las pantallas financieras:
    para volver al programa de siempre está el enlace del final.

    Mismo patrón de grupos plegables que _MenuCongregacion: data-bs-parent
    apuntando a #sidenavAccordion, que es lo que hace que al abrir un grupo
    se cierre el anterior.

    Cada enlace solo se pinta si el usuario tiene el permiso de esa pantalla
    (AreaFinancieraController.PermisoPorPantalla, el mismo mapa con el que el
    servidor corta el paso). Un grupo sin ninguna pantalla visible no se pinta.
    Los roles con acceso total reciben todos los permisos a true en la sesión,
    así que a ellos les aparece todo.
*@
@{
    var permisosFin = ViewBag.PermisosMiembro as CapaEntidad.Permisos ?? new CapaEntidad.Permisos();

    bool PuedeVer(string controlador, string accion)
    {
        var permiso = AreaFinancieraController.ObtenerPermisoDePantalla(controlador, accion);
        return permiso == null || CASTIglesias.Filters.RequierePermisoAttribute.TieneAlguno(permisosFin, permiso);
    }

    // (texto, icono, acción, controlador)
    var grupos = new[]
    {
        new {
            Id = "collapseFinOperaciones", Titulo = "Operaciones", Icono = "fa-right-left",
            Enlaces = new[] {
                (Texto: "Ingresos y aportaciones",   Icono: "fa-hand-holding-heart", Accion: "Ingresos", Controlador: "FinanzasOperaciones"),
                (Texto: "Gastos",                    Icono: "fa-receipt",            Accion: "Gastos",   Controlador: "FinanzasOperaciones"),
                (Texto: "Transferencias entre sedes",Icono: "fa-right-left",         Accion: "Index",    Controlador: "FinanzasTransferencias"),
                (Texto: "Facturas y pagos",          Icono: "fa-file-invoice",       Accion: "Index",    Controlador: "FinanzasPagos"),
                (Texto: "Arqueos de caja",           Icono: "fa-calculator",         Accion: "Index",    Controlador: "FinanzasArqueos"),
            }
        },
        new {
            Id = "collapseFinContabilidad", Titulo = "Contabilidad", Icono = "fa-book",
            Enlaces = new[] {
                (Texto: "Libro Diario",          Icono: "fa-book-open",       Accion: "Index",        Controlador: "FinanzasDiario"),
                (Texto: "Libro Mayor",           Icono: "fa-list-ol",         Accion: "Mayor",        Controlador: "FinanzasInformes"),
                (Texto: "Sumas y saldos",        Icono: "fa-scale-balanced",  Accion: "SumasYSaldos", Controlador: "FinanzasInformes"),
                (Texto: "Balance de Situación",  Icono: "fa-building-columns",Accion: "Balance",      Controlador: "FinanzasInformes"),
                (Texto: "Cuenta de Resultados",  Icono: "fa-chart-line",      Accion: "Resultados",   Controlador: "FinanzasInformes"),
                (Texto: "Cierre del ejercicio",  Icono: "fa-flag-checkered",  Accion: "Cierre",       Controlador: "FinanzasInformes"),
            }
        },
        new {
            Id = "collapseFinGestion", Titulo = "Gestión", Icono = "fa-chart-pie",
            Enlaces = new[] {
                (Texto: "Presupuestos",                 Icono: "fa-chart-pie",     Accion: "Index", Controlador: "FinanzasPresupuestos"),
                (Texto: "Certificados de aportaciones", Icono: "fa-file-lines",    Accion: "Index", Controlador: "FinanzasCertificados"),
                (Texto: "Aprobaciones",                 Icono: "fa-user-check",    Accion: "Index", Controlador: "FinanzasAprobaciones"),
                (Texto: "Conciliación bancaria",        Icono: "fa-code-compare",  Accion: "Index", Controlador: "FinanzasConciliacion"),
                (Texto: "Auditoría",                    Icono: "fa-clipboard-list",Accion: "Index", Controlador: "FinanzasAuditoria"),
            }
        },
        new {
            Id = "collapseFinConfiguracion", Titulo = "Configuración", Icono = "fa-sliders",
            Enlaces = new[] {
                (Texto: "Conceptos",                    Icono: "fa-tags",            Accion: "Index", Controlador: "FinanzasConceptos"),
                (Texto: "Cajas y bancos",               Icono: "fa-cash-register",   Accion: "Index", Controlador: "FinanzasTesoreria"),
                (Texto: "Fondos",                       Icono: "fa-piggy-bank",      Accion: "Index", Controlador: "FinanzasFondos"),
                (Texto: "Plan de cuentas",              Icono: "fa-sitemap",         Accion: "Index", Controlador: "FinanzasPlanCuentas"),
                (Texto: "Plantillas del plan contable", Icono: "fa-layer-group",     Accion: "Index", Controlador: "FinanzasPlantillas"),
                (Texto: "Ejercicios y periodos",        Icono: "fa-calendar-check",  Accion: "Index", Controlador: "FinanzasEjercicios"),
                (Texto: "Terceros",                     Icono: "fa-address-book",    Accion: "Index", Controlador: "FinanzasTerceros"),
                (Texto: "Proyectos y actividades",      Icono: "fa-diagram-project", Accion: "Index", Controlador: "FinanzasProyectos"),
                (Texto: "Reglas de contabilización",    Icono: "fa-code-branch",     Accion: "Index", Controlador: "FinanzasReglas"),
                (Texto: "Numeración de documentos",     Icono: "fa-hashtag",         Accion: "Index", Controlador: "FinanzasNumeraciones"),
                (Texto: "Puesta en marcha",             Icono: "fa-flag-checkered",  Accion: "Index", Controlador: "FinanzasApertura"),
            }
        },
    };
}

                        <a class="nav-link" href="@Url.Action("Index", "Finanzas")">
                            <div class="sb-nav-link-icon"><i class="fas fa-chart-pie"></i></div>
                            @L["Panel financiero"]
                        </a>

                        @foreach (var grupo in grupos)
                        {
                            var visibles = grupo.Enlaces.Where(e => PuedeVer(e.Controlador, e.Accion)).ToList();
                            if (visibles.Count == 0) { continue; }

                            <a class="nav-link collapsed" href="#" data-bs-toggle="collapse" data-bs-target="#@grupo.Id" aria-expanded="false">
                                <div class="sb-nav-link-icon"><i class="fas @grupo.Icono"></i></div>
                                @L[grupo.Titulo]
                                <div class="sb-sidenav-collapse-arrow"><i class="fas fa-angle-down nav-link-collapse-icon"></i></div>
                            </a>
                            <div class="collapse" id="@grupo.Id" data-bs-parent="#sidenavAccordion">
                                <nav class="sb-sidenav-menu-nested nav">
                                    @foreach (var enlace in visibles)
                                    {
                                        <a class="nav-link collapsed-sub-item" href="@Url.Action(enlace.Accion, enlace.Controlador)">
                                            <div class="sb-nav-link-icon"><i class="fas @enlace.Icono"></i></div>
                                            @L[enlace.Texto]
                                        </a>
                                    }
                                </nav>
                            </div>
                        }

                        @* Salida del área. Va al final y separada, para que no se
                           confunda con una pantalla más del menú. *@
                        <hr class="border-secondary mx-3 my-2" />
                        <a class="nav-link" href="@Url.Action("Index", "Home")">
                            <div class="sb-nav-link-icon"><i class="fas fa-arrow-left"></i></div>
                            @L["Volver al área de congregación"]
                        </a>
