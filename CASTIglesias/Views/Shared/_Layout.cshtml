    @* Token antifalsificación de la sesión. El script de abajo lo añade como cabecera
       a toda petición AJAX que modifica datos, y las acciones marcadas con
       [ValidateAntiForgeryToken] rechazan las que no lo traen: así otra web no puede
       provocar cambios aprovechando la sesión abierta del usuario. *@
    @Html.AntiForgeryToken()
    @{
        // Permisos de la sesión para el JavaScript. Sirven para no enseñar botones que
        // el servidor va a rechazar; la comprobación de verdad está en [RequierePermiso].
        var permisosSesionLayout = ViewBag.PermisosMiembro as Permisos ?? new Permisos();
        var permisosParaJs = typeof(Permisos).GetProperties()
            .Where(p => p.PropertyType == typeof(bool))
            .ToDictionary(p => p.Name, p => (bool)p.GetValue(permisosSesionLayout)!);
    }
    <script>
        // Un elemento con data-permiso="MiembrosEliminar" desaparece si el usuario no
        // tiene ese permiso. Se aplica al cargar y en cada repintado de DataTables,
        // porque los botones de las filas se crean después.
        window.PERMISOS = @Json.Serialize(permisosParaJs);

        function puedePermiso(nombre) { return !!(window.PERMISOS || {})[nombre]; }

        function aplicarPermisosEnDom(raiz) {
            $(raiz || document).find('[data-permiso]').each(function () {
                if (!puedePermiso($(this).data('permiso'))) $(this).remove();
            });
        }

        $(function () { aplicarPermisosEnDom(); });
        $(document).on('draw.dt', function (e) { aplicarPermisosEnDom(e.target); });
    </script>

    <script>
        $.ajaxPrefilter(function (opciones, _original, xhr) {
            const metodo = (opciones.type || opciones.method || 'GET').toUpperCase();
            // Solo peticiones a este mismo sitio: el token no debe salir a otros dominios
            if (metodo === 'GET' || opciones.crossDomain) return;
            const token = $('input[name="__RequestVerificationToken"]').first().val();
            if (token) xhr.setRequestHeader('RequestVerificationToken', token);
        });
    </script>

    <script>
        // Diccionario global de textos traducidos para el JavaScript.
        //
        // Se serializan con Json.Serialize y NUNCA se interpolan directamente:
        // los acentos, las comillas y los apóstrofes de una traducción romperían
        // el script si se escribiesen en crudo dentro de las comillas.
        //
        // IMPORTANTE: se usa Object.assign sobre window.T y NO "const T = {...}".
        // El layout y cada vista escriben en el mismo ámbito global, así que dos
        // declaraciones "const T" provocan un SyntaxError que aborta el bloque
        // <script> completo de la vista, y esta deja de funcionar por entero.
        // Cada vista debe ampliar este objeto con la misma fórmula, nunca
        // redeclararlo.
        window.T = Object.assign(window.T || {}, {
            sinMinisterios:   @Json.Serialize(L["Sin ministerios"].Value),
            errorCambiarSede: @Json.Serialize(L["Error al cambiar de sede"].Value),
            desconocido:      @Json.Serialize(L["Desconocido"].Value),
            errorConexionSede:@Json.Serialize(L["Error de conexión al cambiar de sede. Inténtalo de nuevo."].Value),

            @* Palabras sueltas que usan los avisos de SweetAlert (títulos y botones
               de confirmación). Estaban repetidas en cada vista, así que una vista
               nueva que se olvidara de declararlas pintaba "undefined" en el botón.
               Aquí valen para todas; una vista puede afinarlas redefiniéndolas. *@
            error:            @Json.Serialize(L["Error"].Value),
            exito:            @Json.Serialize(L["Éxito"].Value),
            si:               @Json.Serialize(L["Sí"].Value),
            no:               @Json.Serialize(L["No"].Value),
