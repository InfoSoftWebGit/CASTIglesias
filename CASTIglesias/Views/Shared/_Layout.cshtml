            mNombreObligatorio:           @Json.Serialize(L["El nombre es obligatorio."].Value),
            mNombreRolObligatorio:        @Json.Serialize(L["El nombre del rol es obligatorio."].Value),
            mNuevoLider:                  @Json.Serialize(L["Nuevo líder"].Value),
            mPersonaCargoLista:           @Json.Serialize(L["La persona a cargo debe seleccionarse de la lista."].Value),
            mPersonaCargoObligatoria:     @Json.Serialize(L["La persona a cargo es obligatoria."].Value),
            mPrimeroSeleccionaMiembro:    @Json.Serialize(L["Primero selecciona un miembro de la lista."].Value),
            mQuitarDeFamilia:             @Json.Serialize(L["Quitar de la familia"].Value),
            mQuitarDeZona:                @Json.Serialize(L["Quitar de la zona"].Value),
            mRazonObligatoria:            @Json.Serialize(L["Razón obligatoria"].Value),
            mRolEliminado:                @Json.Serialize(L["Rol eliminado."].Value),
            mSeEliminaranBloques:         @Json.Serialize(L["Se eliminarán también sus bloques y los roles configurados."].Value),
            mSeguridadBienvenida:         @Json.Serialize(L["Seguridad y Bienvenida"].Value),
            mSeleccionaCulto:             @Json.Serialize(L["Selecciona un culto"].Value),
            mSeleccionaMiembro:           @Json.Serialize(L["Selecciona un miembro"].Value),
            mSeleccionaMiembroGasto:      @Json.Serialize(L["Selecciona el miembro que registra el gasto."].Value),
            mSeleccionaMiembroLista:      @Json.Serialize(L["Selecciona un miembro de la lista."].Value),
            mSiEliminar:                  @Json.Serialize(L["Sí, eliminar"].Value),
            mSiGuardar:                   @Json.Serialize(L["Sí, guardar"].Value),
            mSinCultos:                   @Json.Serialize(L["No hay cultos disponibles."].Value),
            mSinPermisosEspecificos:      @Json.Serialize(L["No se encontraron permisos específicos para el usuario. Permisos por defecto: ninguno."].Value),
            mSinSeguimientos:             @Json.Serialize(L["No hay registros de seguimiento para este miembro."].Value),
            mSinZona:                     @Json.Serialize(L["Sin zona"].Value),
            mTipoSeguimientoObligatorio:  @Json.Serialize(L["El tipo de seguimiento es obligatorio."].Value),
            mTotalMiembrosBaja:           @Json.Serialize(L["Total de Miembros de Baja"].Value),
            mTurnoFechaObligatorios:      @Json.Serialize(L["El turno y la fecha son obligatorios."].Value),
            mZonaEliminada:               @Json.Serialize(L["La Zona fue eliminada correctamente."].Value)
        });

        // Días de la semana. Estaban repetidos como literales en tres vistas, así
        // que traducir una sola dejaba las otras en español. El hueco inicial es a
        // propósito: en la BBDD el lunes es el día 1, no el 0.
        window.TDIAS = ['',
            @Json.Serialize(L["Lunes"].Value), @Json.Serialize(L["Martes"].Value),
            @Json.Serialize(L["Miércoles"].Value), @Json.Serialize(L["Jueves"].Value),
            @Json.Serialize(L["Viernes"].Value), @Json.Serialize(L["Sábado"].Value),
            @Json.Serialize(L["Domingo"].Value)];

        // ── Traducción de datos de catálogo ──────────────────────────────────
        //
        // Hay valores que viven en la BBDD pero NO los escribe la iglesia: los
        // crea la propia aplicación (las zonas que se auto-aprovisionan, los
        // roles de usuario). Son un conjunto cerrado y conocido, así que se
        // pueden traducir sin tocar el dato almacenado.
        //
        // La regla: el valor guardado NUNCA cambia; se traduce solo al pintarlo.
        // Si el valor no está en la tabla, se devuelve tal cual, que es lo que
        // debe pasar con las zonas y grupos que cada iglesia crea a su gusto.
        window.TDATOS = {
            // Zonas de discipulado creadas por defecto
            "Hombres":        @Json.Serialize(L["Hombres"].Value),
            "Mujeres":        @Json.Serialize(L["Mujeres"].Value),
            "Niños":          @Json.Serialize(L["Niños"].Value),
            "Jóvenes":        @Json.Serialize(L["Jóvenes"].Value),
            // Roles de usuario (columna Rol)
            "AdminGlobal":    @Json.Serialize(L["Administrador Global"].Value),
            "PastorGeneral":  @Json.Serialize(L["Pastor General"].Value),
            "PastorSede":     @Json.Serialize(L["Pastor de Sede"].Value),
            "Miembro":        @Json.Serialize(L["Miembro"].Value)
        };

        window.tDato = function (valor) {
            return (valor != null && window.TDATOS[valor]) || valor;
        };

        // Paquete de idioma de DataTables para el idioma activo.
        //
        // En inglés vale cadena vacía: DataTables ya trae sus textos ("Search",
        // "Previous", "Next", "Showing X of Y") en inglés, así que no hay que
        // cargar nada. Las vistas lo usan como:
        //     language: window.dtLang ? { url: window.dtLang } : {}
        window.dtLang = @Json.Serialize(IdiomasSoportados.UrlIdiomaDataTables());

        // Rellena los marcadores {0}, {1}... de un texto traducido.
        //
        // Existe para no trocear las frases con datos intercalados. Partir
        // "Este miembro tiene 15 años" en tres cachos obliga al inglés a seguir
        // el orden de palabras del español, que a menudo no coincide. Con
        // marcadores, cada idioma coloca el dato donde le corresponde.
        //
        // Uso: fmt(T.mensaje, edad, minimo, maximo)
        window.fmt = function (plantilla, ...valores) {
            return valores.reduce(
                (texto, valor, i) => texto.split('{' + i + '}').join(valor),
                plantilla);
        };

        document.addEventListener('DOMContentLoaded', function () {
            // Sidebar toggle
            const sidebarToggle = document.getElementById('sidebarToggle');
            if (sidebarToggle) {
                sidebarToggle.addEventListener('click', e => {
                    e.preventDefault();
                    document.body.classList.toggle('sb-sidenav-toggled');
                });
            }

            // Expandir menú activo
            const currentPath = window.location.pathname.toLowerCase();
            document.querySelectorAll('.sb-sidenav-menu-nested a.nav-link:not([data-bs-toggle])').forEach(link => {
                if (!link.getAttribute('href') || link.getAttribute('href') === '#') return;
                const linkUrl = new URL(link.href).pathname.toLowerCase();
                if (currentPath === linkUrl || (linkUrl.endsWith('/') && currentPath.startsWith(linkUrl))) {
                    const collapseDiv = link.closest('.collapse');
                    if (collapseDiv) {
                        const collapseTargetId = '#' + collapseDiv.id;
                        $(collapseTargetId).collapse('show');
                        const parentLink = document.querySelector('[data-bs-target="' + collapseTargetId + '"]');
                        if (parentLink) {
                            parentLink.classList.remove('collapsed');
                            parentLink.setAttribute('aria-expanded', 'true');
                        }
                    }
                }
            });

            // Submenú dinámico de Servicios (lista los ministerios de la sede)
            const serviciosSubmenu = document.getElementById('serviciosSubmenu');
            if (serviciosSubmenu) {
                const urlBaseServicios = serviciosSubmenu.dataset.urlServicios;
                const urlListar = serviciosSubmenu.dataset.urlListar;
                const cargando = document.getElementById('serviciosCargando');

                $.get(urlListar, function (res) {
                    const ministerios = (res && res.data) ? res.data : [];
                    if (cargando) cargando.remove();

                    if (ministerios.length === 0) {
                        serviciosSubmenu.insertAdjacentHTML('beforeend',
                            '<span class="nav-link collapsed-sub-item text-white-50" style="font-size: 0.85rem;">' +
                            $('<div>').text(T.sinMinisterios).html() + '</span>');
                        return;
                    }

                    const currentPath = window.location.pathname.toLowerCase();
                    const currentId = new URLSearchParams(window.location.search).get('id');

                    function iconoMinisterio(nombre) {
                        if (!nombre) return 'fas fa-users-cog';
                        var n = nombre.toLowerCase();
                        if (n.includes('alabanza') || n.includes('sonido'))  return 'fas fa-music';
                        if (n.includes('emisi') || n.includes('cámara') || n.includes('camara')) return 'fas fa-video';
                        if (n.includes('bienvenida') || n.includes('seguridad') || n.includes('ugier')) return 'fas fa-handshake';
                        if (n.includes('proyecci'))  return 'fas fa-desktop';
                        if (n.includes('pastoral'))  return 'fas fa-book-open';
                        if (n.includes('misiones'))  return 'fas fa-route';
                        if (n.includes('redes'))     return 'fas fa-share-nodes';
                        return 'fas fa-users-cog';
                    }

                    ministerios.forEach(function (m) {
                        const link = document.createElement('a');
                        link.className = 'nav-link collapsed-sub-item';
                        link.href = urlBaseServicios + '?id=' + m.id;
                        link.innerHTML = '<div class="sb-nav-link-icon"><i class="' + iconoMinisterio(m.descripcion) + '"></i></div>' +
                            $('<div>').text(m.descripcion || '').html();
                        serviciosSubmenu.appendChild(link);

                        // Mantener abierto y marcar activo si estamos en esta vista de servicio
                        if (currentPath === urlBaseServicios.toLowerCase() && String(m.id) === currentId) {
                            link.classList.add('active');
                            $('#collapseServicios').collapse('show');
                            $('#collapseMantenimiento').collapse('show');
                            const parentLink = document.querySelector('[data-bs-target="#collapseMantenimiento"]');
                            if (parentLink) { parentLink.classList.remove('collapsed'); parentLink.setAttribute('aria-expanded', 'true'); }
                            const serviciosLink = document.querySelector('[data-bs-target="#collapseServicios"]');
                            if (serviciosLink) { serviciosLink.classList.remove('collapsed'); serviciosLink.setAttribute('aria-expanded', 'true'); }
                        }
                    });
                });
            }

            // Dropdown sede estable
            const sedeBtn = document.getElementById('dropdownSede');
            if (sedeBtn) {
                new bootstrap.Dropdown(sedeBtn, {
                    popperConfig: { strategy: 'fixed' }
                });
            }
        });

        // Cambiar sede
        function cambiarSedeYRecargar(nuevoSedeID) {
            const returnUrl = window.location.pathname + window.location.search;
            $.ajax({
                type: "POST",
                url: "/Home/CambiarSede",
                data: { nuevoSedeID, returnUrl },
                success: function (response) {
                    if (response.success && response.redirectUrl)
                        window.location.href = response.redirectUrl;
                    else
                        alert(T.errorCambiarSede + ": " + (response.message || T.desconocido));
                },
                error: function () {
                    alert(T.errorConexionSede);
                }
            });
        }
    </script>

    @RenderSection("Scripts", required: false)
</body>
</html>
