@using Microsoft.AspNetCore.Http.Extensions
@using CapaEntidad
@using System.Globalization

@{
    // Idioma de interfaz activo en esta petición. Lo resuelve el middleware de
    // localización a partir de la cookie que escribe AccesoController.CambiarIdioma.
    // TwoLetterISOLanguageName devuelve "es" o "en", que es la forma en la que se
    // declaran los idiomas en IdiomasSoportados.
    var idiomaActual = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;

    // Ruta actual (incluida la query string) para que al cambiar de idioma el
    // usuario vuelva exactamente a la pantalla donde estaba y no al inicio.
    var urlRetorno = Context.Request.GetEncodedPathAndQuery();
}

<!DOCTYPE html>
<html lang="@idiomaActual">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewBag.Title - Congrega</title>
    <link rel="icon" type="image/png" href="/favicon.png">

    <!-- ✅ Se elimina integrity para evitar error de verificación -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" rel="stylesheet">

    <!-- ✅ Bootstrap 5.3.8 sin integrity -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet">

    <link href="https://code.jquery.com/ui/1.14.0/themes/base/jquery-ui.css" rel="stylesheet" />

    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <style>
        /* ── Responsive global (móvil / tablet) ────────────────────────────────── */
        @@media (max-width: 767.98px) {
            /* Tablas: scroll suave con toque en iOS/Android */
            .table-responsive {
                -webkit-overflow-scrolling: touch;
            }

            /* Columnas de "Acciones" en DataTables: dejar que DataTables decida el ancho */
            table th[style*="width: 100px"],
            table th[style*="width:100px"],
            table th[style*="width: 90px"],
            table th[style*="width:90px"],
            table th[style*="width: 110px"],
            table th[style*="width:110px"],
            table th[style*="width: 130px"],
            table th[style*="width:130px"] {
                width: auto !important;
            }

            /* Card headers con botón inline: apilar verticalmente */
            .card-header.d-flex {
                flex-wrap: wrap;
                gap: 0.5rem;
            }

            /* Breadcrumb: texto más pequeño */
            .breadcrumb {
                font-size: 0.8rem;
            }

            /* Footer: evitar desbordamiento de texto */
            footer .d-flex {
                flex-direction: column;
                gap: 0.25rem;
            }

            /* DataTables: reducir padding de celdas y texto */
            table.dataTable td,
            table.dataTable th {
                padding: 6px 8px !important;
                font-size: 0.82rem;
            }

            /* Botones de DataTables (si se usan) */
            .dt-buttons .btn {
                font-size: 0.75rem;
                padding: 4px 8px;
            }

            /* Modales: asegurar que no desborden el ancho de pantalla */
            .modal-dialog {
                margin: 0.5rem;
            }
            .modal-dialog.modal-lg,
            .modal-dialog.modal-xl {
                max-width: calc(100vw - 1rem);
            }

            /* Inputs en fila dentro de formularios: apilar */
            .input-group > .form-control,
            .input-group > .form-select {
                min-width: 0;
            }

            /* Títulos h1 más compactos */
            h1.mt-4 {
                font-size: 1.4rem;
            }
        }

        @@media (max-width: 575.98px) {
            /* Pantallas muy pequeñas: padding mínimo en contenedor */
            .container-fluid.px-4 {
                padding-left: 0.75rem !important;
                padding-right: 0.75rem !important;
            }

            /* Modales a pantalla completa en móvil pequeño */
            .modal-dialog {
                margin: 0;
                max-width: 100vw;
                border-radius: 0;
            }
            .modal-content {
                border-radius: 0;
                min-height: 100dvh;
            }
        }
    </style>

