@using CapaEntidad.Financiero
@using System.Globalization
@{
    ViewBag.Title = L["Panel financiero"].Value;
    Layout = "~/Views/Shared/_Layout.cshtml";

    var ejercicio = ViewBag.Ejercicio as FiscalYear;
    decimal ingresos = ViewBag.Ingresos as decimal? ?? 0m;
    decimal gastos = ViewBag.Gastos as decimal? ?? 0m;
    decimal saldo = ViewBag.Saldo as decimal? ?? 0m;
    var porConcepto = ViewBag.PorConcepto as List<(string concepto, decimal total)>
                      ?? new List<(string, decimal)>();

    // Importes con el formato del idioma activo
    var formato = CultureInfo.CurrentUICulture;
    Func<decimal, string> euros = valor => valor.ToString("C", formato);
    decimal mayor = porConcepto.Count > 0 ? porConcepto.Max(c => c.total) : 0m;
}

<ol class="breadcrumb mb-4 mt-4">
    <li class="breadcrumb-item active">@L["Panel financiero"]</li>
</ol>

@if (ejercicio == null)
{
    <div class="card mb-4">
        <div class="card-body text-center py-5">
            <i class="fas fa-calendar-plus fa-3x text-muted mb-3"></i>
            <h5>@L["Todavía no hay ningún ejercicio abierto"]</h5>
            <p class="text-muted">
                @L["El ejercicio es el año contable. Hay que crearlo, generar sus periodos y abrirlo antes de poder registrar nada."]
            </p>
            <a href="@Url.Action("Index", "FinanzasEjercicios")" class="btn btn-primary">
                <i class="fas fa-arrow-right me-1"></i> @L["Ir a ejercicios y periodos"]
            </a>
        </div>
    </div>
}
else
{
    <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
        <h5 class="mb-0">
            @L["Ejercicio"] <span class="badge bg-success">@ejercicio.code</span>
        </h5>
        <span class="text-muted small">
            @ejercicio.start_date.ToString("d", formato) — @ejercicio.end_date.ToString("d", formato)
        </span>
    </div>

    <div class="row">
        <div class="col-md-4 mb-4">
            <div class="card border-start border-4 border-success h-100">
                <div class="card-body">
                    <div class="text-muted small text-uppercase">@L["Ingresos"]</div>
                    <div class="fs-4 fw-bold">@euros(ingresos)</div>
                </div>
            </div>
        </div>
        <div class="col-md-4 mb-4">
            <div class="card border-start border-4 border-danger h-100">
                <div class="card-body">
                    <div class="text-muted small text-uppercase">@L["Gastos"]</div>
                    <div class="fs-4 fw-bold">@euros(gastos)</div>
                </div>
            </div>
        </div>
        <div class="col-md-4 mb-4">
            <div class="card border-start border-4 @(saldo >= 0 ? "border-primary" : "border-warning") h-100">
                <div class="card-body">
                    <div class="text-muted small text-uppercase">@L["Diferencia"]</div>
                    <div class="fs-4 fw-bold @(saldo < 0 ? "text-danger" : "")">@euros(saldo)</div>
                </div>
            </div>
        </div>
    </div>

    <div class="card mb-4">
        <div class="card-header"><i class="fas fa-chart-bar me-1"></i> @L["Ingresos por concepto"]</div>
        <div class="card-body">
            @if (porConcepto.Count == 0)
            {
                <p class="text-muted mb-0">@L["Todavía no hay ingresos registrados en este ejercicio."]</p>
            }
            else
            {
                @* Barras hechas con CSS en lugar de una librería de gráficos: son
                   ocho valores y así la página no carga nada más. *@
                foreach (var fila in porConcepto)
                {
                    var porcentaje = mayor > 0 ? (int)Math.Round(fila.total * 100 / mayor) : 0;
                    <div class="mb-3">
                        <div class="d-flex justify-content-between small">
                            <span>@fila.concepto</span>
                            <span class="fw-bold">@euros(fila.total)</span>
                        </div>
                        <div class="progress" style="height:8px;" role="progressbar"
                             aria-valuenow="@porcentaje" aria-valuemin="0" aria-valuemax="100">
                            <div class="progress-bar bg-success" style="width:@(porcentaje)%"></div>
                        </div>
                    </div>
                }
            }
        </div>
    </div>
}

@* Aviso de convivencia. Mientras existan las dos formas de registrar, lo que se
   apunte en Diezmos y Gastos del área de congregación NO llega hasta aquí. *@
<div class="card mb-4 border-warning">
    <div class="card-header bg-warning-subtle">
        <i class="fas fa-triangle-exclamation me-1"></i> @L["Importante"]
    </div>
    <div class="card-body">
        <p class="mb-0">
            @L["Las pantallas de Diezmos, Gastos y Conceptos del área de congregación siguen funcionando por separado. Lo que se registre allí no forma parte de la contabilidad ni aparece en este panel."]
        </p>
    </div>
</div>

<div class="alert alert-secondary d-flex align-items-start">
    <i class="fas fa-info-circle me-2 mt-1"></i>
    <div>
        @L["Los importes de arriba son los registrados, todavía sin contabilizar: el motor contable, los saldos por caja y el control de presupuesto llegan en la siguiente fase."]
    </div>
</div>
