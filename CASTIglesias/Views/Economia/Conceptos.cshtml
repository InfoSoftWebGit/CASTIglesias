@{
    ViewData["Title"] = L["Conceptos"].Value;
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<link href="https://cdn.datatables.net/1.13.6/css/dataTables.bootstrap5.min.css" rel="stylesheet" />

<partial name="_AvisoFueraDeContabilidad" />
<ol class="breadcrumb mb-4 mt-4">
    <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">@L["Información"]</a></li>
    <li class="breadcrumb-item active">@L["Conceptos"]</li>
</ol>

<div class="card">
    <div class="card-header">
        <i class="fas fa-tags me-1"></i> @L["Lista de Conceptos"]
    </div>
    <div class="table-responsive">
        <div class="row mb-3">
            <div class="col-12">
                <button data-permiso="ConceptosCrearEditar" type="button" class="btn btn-success" onclick="abrirModalConcepto()">@L["Añadir nuevo concepto"]</button>
            </div>
        </div>
        <hr />
        <table id="tablaConceptos" class="table table-bordered table-striped border-top" style="width: 100%">
            <thead>
                <tr>
                    <th>@L["Nombre del Concepto"]</th>
                    <th>@L["Sede"]</th>
                    <th style="width: 100px;">@L["Acciones"]</th>
                </tr>
            </thead>
            <tbody></tbody>
        </table>
    </div>
</div>
@* <style>
    #tablaConceptos thead {
        background-color: #1877F2 !important;
    }

    #tablaConceptos th {
        color: white !important;
        text-align: center !important;
        vertical-align: middle !important;
    }

    #tablaConceptos tbody td {
        color: black !important;
    }
</style> *@

<div class="modal fade" id="FormModalConceptos" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true" data-bs-backdrop="static">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header text-white" style="background-color: #1E3A8A;">
                <h5 class="modal-title" id="exampleModalLabel">@L["Datos del Concepto"]</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="@L["Cerrar"]"></button>
            </div>
            <div class="modal-body">
                <input id="txtidConcepto" type="hidden" value="0" />
                <input id="txtID_sede" type="hidden" value="@(ViewBag.sedeID ?? 0)" />

                <div class="row g-2">
                    <div class="col-sm-12">
                        <label class="form-label">@L["Nombre del Concepto"]<span class="text-danger">*</span></label>
                        <input type="text" class="form-control" id="txtNombreConcepto" placeholder="@L["Ej: Diezmo, Ofrenda, Primicia"]" autocomplete="off" />
                    </div>

                    <div class="col-sm-6">
                        <input type="text" class="form-control" id="txtSede" hidden />
                    </div>
                </div>

                <div class="row mt-3">
                    <div class="col-12">
                        <div id="mensajeErrorConcepto" class="alert alert-danger d-none"></div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">@L["Cerrar"]</button>
                <button type="button" class="btn btn-primary" onclick="GuardarConcepto()">@L["Guardar"]</button>
            </div>
        </div>
    </div>
</div>


@section scripts {
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap5.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="https://cdn.jsdelivr.net/npm/gasparesganga-jquery-loading-overlay@2.1.7/dist/loadingoverlay.min.js"></script>
    <script>
        // Textos traducidos que consume el JavaScript de esta vista.
        //
        // Se AMPLÍA window.T (ya declarado en el layout) en lugar de declarar un
        // "const T" propio: comparten ámbito global y una segunda declaración
        // const lanza SyntaxError que tumba este bloque <script> entero.
        window.T = Object.assign(window.T || {}, {
            adminGlobalConcepto: @Json.Serialize(L["El Administrador Global no puede crear conceptos sin seleccionar una sede. Use la opción de cambio de sede."].Value),
            conceptoVacio:       @Json.Serialize(L["El nombre del concepto no puede ser vacío."].Value),
            eliminado:           @Json.Serialize(L["Eliminado"].Value),
            eliminarConcepto:    @Json.Serialize(L["¿Desea eliminar el concepto:"].Value),
            error:               @Json.Serialize(L["Error"].Value),
            errorEliminacion:    @Json.Serialize(L["Error en la solicitud de eliminación."].Value),
            estasSeguro:         @Json.Serialize(L["¿Estás seguro?"].Value),
            no:                  @Json.Serialize(L["No"].Value),
            restriccionAcceso:   @Json.Serialize(L["Restricción de Acceso"].Value),
            siEliminar:          @Json.Serialize(L["Sí, eliminar"].Value)
        });

        let tabladata;
        let filaSeleccionada;

        // 🔑 Obtenemos el nombre de la sede del ViewBag (asumo que se llama 'nombreSede')
        const NOMBRE_SEDE_ACTUAL = '@(ViewBag.nombreSede?.ToString() ?? "Sede Desconocida")';
        const LOGGED_IN_SEDE_ID = @(ViewBag.sedeID ?? 0);
        const ID_ADMIN_GLOBAL = 1000;

        // Función auxiliar para obtener datos de la fila (maneja DataTables responsive)
        function getFilaData(button) {
            var tr = $(button).closest("tr");
            var data = tabladata.row(tr).data();
            if (!data) {
                // Manejar el modo responsive de DataTables
                tr = tr.prev("tr");
                data = tabladata.row(tr).data();
            }
            return { tr: tr, data: data };
        }


        $(document).ready(function () {
            if ($.fn.DataTable.isDataTable("#tablaConceptos")) {
                $("#tablaConceptos").DataTable().clear().destroy();
            }

            // Inicialización de DataTables para Conceptos
            tabladata = $("#tablaConceptos").DataTable({
                responsive: true,
                ordering: true,
                ajax: {
                    url: '@Url.Action("ListarConceptos", "Economia")',
                    type: "GET",
                    dataType: "json",
                    dataSrc: "data"
                },
                columns: [
                    { data: "nombre_concepto" },
                    // 🔑 Muestra el nombre de la sede asociada al concepto
                    { data: "nombre_sede" },
                    {
                        defaultContent: `
                            <div class="d-flex justify-content-center gap-2">
                                <button data-permiso="ConceptosCrearEditar" type="button" class="btn btn-primary btn-sm btn-editarConcepto">
                                    <i class="fas fa-pen"></i>
                                </button>
                                <button data-permiso="ConceptosEliminar" type="button" class="btn btn-danger btn-sm btn-eliminarConcepto">
                                    <i class="fas fa-trash"></i>
                                </button>
                            </div>
                        `,
                        orderable: false,
                        searchable: false,
                        width: "100px"
                    }
                ],
                language: window.dtLang ? { url: window.dtLang } : {}
            });

            // Eventos para Editar
            $("#tablaConceptos tbody").on("click", ".btn-editarConcepto", function () {
                const fila = getFilaData(this);
                if (fila.data) {
                    filaSeleccionada = fila.tr;
                    abrirModalConcepto(fila.data);
                }
            });

            // Eventos para Eliminar
            $("#tablaConceptos tbody").on("click", ".btn-eliminarConcepto", function () {
                const fila = getFilaData(this);
                if (!fila.data) return;

                Swal.fire({
                    title: T.estasSeguro,
                    text: `${T.eliminarConcepto} ${fila.data.nombre_concepto}?`,
                    icon: "warning",
                    showCancelButton: true,
                    confirmButtonText: T.siEliminar,
                    cancelButtonText: T.no
                }).then(result => {
                    if (result.isConfirmed) {
                        $.ajax({
                            url: '@Url.Action("EliminarConcepto", "Economia")',
                            type: "POST",
                            // 🔑 Usamos iD_concepto, asumiendo que el controlador espera 'id'
                            data: { id: fila.data.iD_concepto },
                            success: function (res) {
                                if (res.resultado) {
                                    tabladata.row(fila.tr).remove().draw(false);
                                    Swal.fire(T.eliminado, T.mConceptoEliminado, "success");
                                } else {
                                    Swal.fire(T.error, res.mensaje || T.mNoEliminarConcepto, "error");
                                }
                            },
                            error: function () {
                                Swal.fire(T.error, T.errorEliminacion, "error");
                            }
                        });
                    }
                });
            });
        });


        // Función de apertura de Modal para Conceptos
        function abrirModalConcepto(json = null) {
            $("#mensajeErrorConcepto").addClass("d-none").text("");

            // 🔑 Restricción: Si el usuario es Admin Global, no puede crear/editar conceptos sin selector.
            if (!json && LOGGED_IN_SEDE_ID === ID_ADMIN_GLOBAL) {
                Swal.fire(T.restriccionAcceso, T.adminGlobalConcepto, "warning");
                return;
            }

            $("#txtidConcepto").val(json?.iD_concepto || 0);

            if (json) {
                // Modo Edición
                $("#txtNombreConcepto").val(json.nombre_concepto || "");
                $("#txtSedeConcepto").val(json.nombre_sede || "Sede Desconocida");
                $("#exampleModalLabel").text("Editar Concepto");

            } else {
                // Modo Nuevo
                $("#txtNombreConcepto").val("");
                $("#txtSedeConcepto").val(NOMBRE_SEDE_ACTUAL);
                $("#exampleModalLabel").text(T.mDatosNuevoConcepto);
            }

            const modal = new bootstrap.Modal(document.getElementById("FormModalConceptos"));
            modal.show();
        }


        function GuardarConcepto() {
            // Crear el objeto Concepto (solo con los datos a enviar)
            const Concepto = {
                iD_concepto: parseInt($("#txtidConcepto").val()) || 0,
                nombre_concepto: $("#txtNombreConcepto").val().trim()
            };

            if (Concepto.nombre_concepto === "") {
                $("#mensajeErrorConcepto").removeClass("d-none").text(T.conceptoVacio);
                return;
            } else {
                $("#mensajeErrorConcepto").addClass("d-none");
            }

            $(".modal-body").LoadingOverlay("show", { text: "Cargando..." });

            // El endpoint de Guardar Concepto será el mismo, el controlador determina si es INSERT o UPDATE
            const url = '@Url.Action("GuardarConcepto", "Economia")';

            $.ajax({
                url: url,
                type: "POST",
                data: Concepto,
                dataType: "json",
                success: function (data) {
                    $(".modal-body").LoadingOverlay("hide");

                    if (data.resultado !== 0 && !data.error) {
                        // El controlador debe devolver el objeto completo, incluyendo nombre_sede, para actualizar la tabla
                        const nuevoConcepto = data.objeto;

                        // Actualizar o añadir a la tabla
                        if (Concepto.iD_concepto === 0) {
                            tabladata.row.add(nuevoConcepto).draw(false);
                        } else {
                            tabladata.row(filaSeleccionada).data(nuevoConcepto).draw(false);
                        }

                        // Limpieza y cierre del modal
                        $("#txtidConcepto").val("0");
                        $("#txtNombreConcepto").val("");
                        bootstrap.Modal.getInstance(document.getElementById("FormModalConceptos")).hide();
                    } else {
                        $("#mensajeErrorConcepto").removeClass("d-none").text(data.mensaje || T.mErrorProcesar);
                    }
                },
                error: function () {
                    $(".modal-body").LoadingOverlay("hide");
                    $("#mensajeErrorConcepto").removeClass("d-none").text(T.mErrorAjax);
                }
            });
        }

    </script>
}