<!-- ═══════════════════ CÓMO FUNCIONA ═══════════════════ -->
<section id="como-funciona" class="py-5 how-section">
    <div class="container py-4">
        <div class="text-center mb-5">
            <div class="section-badge">@L["Cómo funciona"]</div>
            <h2 class="section-title mt-2">@L["En marcha en tres pasos"]</h2>
            <p class="section-subtitle mt-3">
                @L["Sin instalaciones complicadas. En menos de un día tienes tu iglesia digitalizada y tu equipo trabajando."]
            </p>
        </div>
        <div class="row g-0 justify-content-center">

            <!-- Step 1 -->
            <div class="col-md-4 step-wrap">
                <div class="step-icon-ring">
                    <i class="fas fa-envelope-open-text"></i>
                </div>
                <div class="step-num">1</div>
                <div class="step-card">
                    <h5>@L["Solicita tu acceso"]</h5>
                    <p>@L["Rellena el formulario de contacto y te enviamos tus credenciales en menos de 24 horas. Sin tarjeta, sin permanencia."]</p>
                </div>
                <!-- connector -->
                <div class="step-connector d-none d-md-block"></div>
            </div>

            <!-- Step 2 -->
            <div class="col-md-4 step-wrap">
                <div class="step-icon-ring">
                    <i class="fas fa-sliders-h"></i>
                </div>
                <div class="step-num">2</div>
                <div class="step-card">
                    <h5>@L["Configura tu iglesia"]</h5>
                    <p>@L["Crea tu sede, define zonas y grupos, y activa los módulos que necesitas. Te acompañamos durante todo el proceso."]</p>
                </div>
                <div class="step-connector d-none d-md-block"></div>
            </div>

            <!-- Step 3 -->
            <div class="col-md-4 step-wrap">
                <div class="step-icon-ring">
                    <i class="fas fa-rocket"></i>
                </div>
                <div class="step-num">3</div>
                <div class="step-card">
                    <h5>@L["Gestiona tu comunidad"]</h5>
                    <p>@L["Empieza a registrar congregantes, tomar asistencia y controlar finanzas. Todo desde cualquier dispositivo."]</p>
                </div>
            </div>

        </div>
    </div>
</section>
