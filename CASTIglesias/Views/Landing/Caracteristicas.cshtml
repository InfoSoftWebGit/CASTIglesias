   el buscador la indexe y se pueda escribir a mano. *@
@{
    Layout = "~/Views/Landing/_LayoutPublico.cshtml";
    ViewData["PaginaActual"] = "caracteristicas";
    ViewData["RutaCanonica"] = "caracteristicas";
    ViewData["Title"] = L["Características — Congrega CRM"].Value;
    ViewData["Titulo1"] = L["Características"].Value;
    ViewData["Descripcion"] = L["Todas las funciones de Congrega CRM para gestionar tu iglesia: miembros, grupos, ministerios, asistencia, seguimiento pastoral y finanzas."].Value;
}
