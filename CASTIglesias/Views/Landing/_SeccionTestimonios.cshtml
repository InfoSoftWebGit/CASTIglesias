<!-- ═══════════════════ TESTIMONIOS ═══════════════════ -->
<section class="py-5 testimonial-section">
    <div class="container py-4">
        <div class="text-center mb-5">
            <div class="section-badge" style="background:rgba(255,255,255,0.1);color:rgba(255,255,255,0.8);">@L["Testimonios"]</div>
            <h2 class="section-title mt-2" style="color:white;">@L["Lo que dicen nuestros pastores"]</h2>
            <p class="section-subtitle mt-3" style="color:rgba(255,255,255,0.55);">
                @L["Iglesias de distintos tamaños confían en Congrega CRM para organizar y cuidar a sus congregaciones."]
            </p>
        </div>
        <div class="row g-4">

            <div class="col-md-4">
                <div class="testimonial-card">
                    <div class="t-stars">★★★★★</div>
                    <p class="t-quote">
                        @L["\"Antes llevábamos el registro de miembros en hojas de Excel que nadie actualizaba. Con Congrega lo cambiamos todo: ahora sabemos exactamente quién viene, quién necesita atención y cuánto estamos recibiendo cada mes. Es una bendición para nuestro equipo.\""]
                    </p>
                    <div class="t-author">
                        <div class="t-avatar" style="background:#3B82F6;">@L["PR"]</div>
                        <div>
                            <div class="t-name">@L["Pastor Roberto Fernández"]</div>
                            <div class="t-role">@L["Iglesia Evangélica Betania · Madrid"]</div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="testimonial-card">
                    <div class="t-stars">★★★★★</div>
                    <p class="t-quote">
                        @L["\"El módulo de seguimiento pastoral ha transformado nuestra forma de cuidar a las personas. Podemos ver el historial completo de cada congregante y el equipo de líderes sabe exactamente qué acciones tomar. La comunicación interna mejoró enormemente.\""]
                    </p>
                    <div class="t-author">
                        <div class="t-avatar" style="background:#10B981;">@L["ES"]</div>
                        <div>
                            <div class="t-name">@L["Evangelista Sara Molina"]</div>
                            <div class="t-role">@L["Comunidad de Fe Ágape · Barcelona"]</div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="testimonial-card">
                    <div class="t-stars">★★★★★</div>
                    <p class="t-quote">
                        @L["\"Gestionamos tres sedes desde un solo panel. Antes era imposible tener una visión global; ahora el pastor principal ve en tiempo real el estado de cada congregación. El soporte del equipo de Congrega es también excelente: siempre disponibles.\""]
                    </p>
                    <div class="t-author">
                        <div class="t-avatar" style="background:#F59E0B;">@L["AD"]</div>
                        <div>
                            <div class="t-name">@L["Apóstol David Herrera"]</div>
                            <div class="t-role">@L["Red de Iglesias Roca Viva · Sevilla"]</div>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>
</section>
