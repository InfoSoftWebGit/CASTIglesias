<!-- ═══════════════════ ALT SECTION 1 — Congregantes ═══════════════════ -->
<section class="alt-section">
    <div class="container">
        <div class="row align-items-center g-5">

            <!-- Text -->
            <div class="col-lg-5">
                <div class="mod-badge" style="background:rgba(59,130,246,0.1);color:#2563EB;">
                    <i class="fas fa-users"></i> @L["Congregantes"]
                </div>
                <h2 class="alt-title">@L["Conoce a cada persona de tu iglesia"]</h2>
                <p class="alt-desc">
                    @L["Ficha completa por congregante: datos personales, familia, contacto, estado espiritual, zona, grupo y observaciones privadas. Todo en un solo lugar."]
                </p>
                <div class="alt-feature">
                    <div class="alt-feature-icon" style="background:rgba(59,130,246,0.1);color:#3B82F6;">
                        <i class="fas fa-id-card"></i>
                    </div>
                    <div>
                        <strong>@L["Ficha personal completa"]</strong>
                        <span>@L["Nombre, fecha de nacimiento, teléfono, correo, dirección y foto de perfil."]</span>
                    </div>
                </div>
                <div class="alt-feature">
                    <div class="alt-feature-icon" style="background:rgba(0,191,165,0.1);color:#00BFA5;">
                        <i class="fas fa-filter"></i>
                    </div>
                    <div>
                        <strong>@L["Búsqueda y filtros avanzados"]</strong>
                        <span>@L["Filtra por estado, zona, grupo, sede o cualquier combinación de criterios."]</span>
                    </div>
                </div>
                <div class="alt-feature">
                    <div class="alt-feature-icon" style="background:rgba(139,92,246,0.1);color:#8B5CF6;">
                        <i class="fas fa-history"></i>
                    </div>
                    <div>
                        <strong>@L["Historial y cambios de estado"]</strong>
                        <span>@L["Registra la evolución espiritual: visitante → simpatizante → miembro."]</span>
                    </div>
                </div>
            </div>

            <!-- Visual: member list mockup -->
            <div class="col-lg-7">
                <div class="app-panel">
                    <div class="ap-topbar" style="background:#1E3A8A;">
                        <div class="ap-dot" style="background:#FF5F57;"></div>
                        <div class="ap-dot" style="background:#FFBD2E;"></div>
                        <div class="ap-dot" style="background:#28CA41;"></div>
                        <span class="ap-title" style="color:white;">@L["Congregantes — Listado"]</span>
                    </div>
                    <div class="ap-body">
                        <!-- Search bar mockup -->
                        <div style="background:white;border:1.5px solid #E2E8F4;border-radius:8px;padding:8px 14px;margin-bottom:14px;display:flex;align-items:center;gap:8px;">
                            <i class="fas fa-search" style="color:#94A3B8;font-size:0.82rem;"></i>
                            <span style="color:#94A3B8;font-size:0.83rem;">@L["Buscar congregante..."]</span>
                            <span style="margin-left:auto;background:#EEF2FF;color:#4F46E5;font-size:0.7rem;font-weight:700;padding:3px 10px;border-radius:6px;">@L["Filtros"]</span>
                        </div>
                        <!-- Member rows -->
                        <div class="member-row">
                            <div class="member-avatar" style="background:#3B82F6;">@L["MA"]</div>
                            <div>
                                <div class="member-name">@L["María Alonso García"]</div>
                                <div class="member-meta"><i class="fas fa-map-marker-alt" style="font-size:0.65rem;"></i> @L["Zona Norte · Grupo Jóvenes"]</div>
                            </div>
                            <span class="member-badge" style="background:#DCFCE7;color:#166534;">@L["Miembro"]</span>
                        </div>
                        <div class="member-row">
                            <div class="member-avatar" style="background:#10B981;">@L["JR"]</div>
                            <div>
                                <div class="member-name">@L["Juan Rodríguez Pérez"]</div>
                                <div class="member-meta"><i class="fas fa-map-marker-alt" style="font-size:0.65rem;"></i> @L["Zona Sur · Ministerio Alabanza"]</div>
                            </div>
                            <span class="member-badge" style="background:#DCFCE7;color:#166534;">@L["Miembro"]</span>
                        </div>
                        <div class="member-row">
                            <div class="member-avatar" style="background:#F59E0B;">@L["LM"]</div>
                            <div>
                                <div class="member-name">@L["Laura Martínez Ruiz"]</div>
                                <div class="member-meta"><i class="fas fa-map-marker-alt" style="font-size:0.65rem;"></i> @L["Zona Centro · Sin grupo"]</div>
                            </div>
                            <span class="member-badge" style="background:#FEF9C3;color:#854D0E;">@L["Simpatizante"]</span>
                        </div>
                        <div class="member-row">
                            <div class="member-avatar" style="background:#8B5CF6;">@L["CS"]</div>
                            <div>
                                <div class="member-name">@L["Carlos Sánchez López"]</div>
                                <div class="member-meta"><i class="fas fa-map-marker-alt" style="font-size:0.65rem;"></i> @L["Zona Norte · Sin asignar"]</div>
                            </div>
                            <span class="member-badge" style="background:#E0F2FE;color:#0369A1;">@L["Visitante"]</span>
                        </div>
                        <div style="text-align:center;margin-top:12px;">
                            <span style="font-size:0.78rem;color:#94A3B8;">@L["Mostrando 4 de 248 congregantes"]</span>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>
</section>

<!-- ═══════════════════ ALT SECTION 2 — Economía ═══════════════════ -->
<section class="alt-section bg-alt">
    <div class="container">
        <div class="row align-items-center g-5 flex-lg-row-reverse">

            <!-- Text -->
            <div class="col-lg-5">
                <div class="mod-badge" style="background:rgba(16,185,129,0.1);color:#059669;">
                    <i class="fas fa-hand-holding-usd"></i> @L["Economía"]
                </div>
                <h2 class="alt-title">@L["Control total de las finanzas de tu iglesia"]</h2>
                <p class="alt-desc">
                    @L["Registra diezmos, ofrendas y cualquier concepto económico. Genera gráficas comparativas y exporta informes en Excel para rendición de cuentas."]
                </p>
                <div class="alt-feature">
                    <div class="alt-feature-icon" style="background:rgba(16,185,129,0.1);color:#10B981;">
                        <i class="fas fa-tags"></i>
                    </div>
                    <div>
                        <strong>@L["Conceptos personalizados"]</strong>
                        <span>@L["Configura tus propios conceptos: diezmo, ofrenda, misiones, fondo pastoral…"]</span>
                    </div>
                </div>
                <div class="alt-feature">
                    <div class="alt-feature-icon" style="background:rgba(59,130,246,0.1);color:#3B82F6;">
                        <i class="fas fa-chart-bar"></i>
                    </div>
                    <div>
                        <strong>@L["Gráficas mensuales y anuales"]</strong>
                        <span>@L["Visualiza la evolución de cada concepto y compara períodos fácilmente."]</span>
                    </div>
                </div>
                <div class="alt-feature">
                    <div class="alt-feature-icon" style="background:rgba(245,158,11,0.1);color:#F59E0B;">
                        <i class="fas fa-file-excel"></i>
                    </div>
                    <div>
                        <strong>@L["Exportación a Excel"]</strong>
                        <span>@L["Descarga informes detallados para presentarlos en las reuniones de liderazgo."]</span>
                    </div>
                </div>
            </div>

            <!-- Visual: finance mockup -->
            <div class="col-lg-7">
                <div class="app-panel">
                    <div class="ap-topbar" style="background:#0D1B3D;">
                        <div class="ap-dot" style="background:#FF5F57;"></div>
                        <div class="ap-dot" style="background:#FFBD2E;"></div>
                        <div class="ap-dot" style="background:#28CA41;"></div>
                        <span class="ap-title" style="color:white;">@L["Economía — Diezmos por Concepto · 2025"]</span>
                    </div>
                    <div class="ap-body">
                        <!-- Month selector bar -->
                        <div style="display:flex;gap:6px;margin-bottom:16px;overflow:hidden;">
                            <span style="background:#EEF2FF;color:#4F46E5;font-size:0.72rem;font-weight:700;padding:4px 10px;border-radius:6px;">@L["Ene"]</span>
                            <span style="background:#EEF2FF;color:#4F46E5;font-size:0.72rem;font-weight:700;padding:4px 10px;border-radius:6px;">@L["Feb"]</span>
                            <span style="background:#EEF2FF;color:#4F46E5;font-size:0.72rem;font-weight:700;padding:4px 10px;border-radius:6px;">@L["Mar"]</span>
                            <span style="background:#1E3A8A;color:white;font-size:0.72rem;font-weight:700;padding:4px 10px;border-radius:6px;">@L["Abr"]</span>
                            <span style="background:#EEF2FF;color:#4F46E5;font-size:0.72rem;font-weight:700;padding:4px 10px;border-radius:6px;">@L["May"]</span>
                            <span style="background:#EEF2FF;color:#4F46E5;font-size:0.72rem;font-weight:700;padding:4px 10px;border-radius:6px;">@L["Jun"]</span>
                        </div>
                        <!-- Finance rows -->
                        <div class="fin-row">
                            <div class="fin-icon" style="background:rgba(59,130,246,0.1);color:#3B82F6;"><i class="fas fa-cross"></i></div>
                            <span class="fin-label">@L["Diezmo General"]</span>
                            <span class="fin-amount" style="color:#3B82F6;">2.100 €</span>
                        </div>
                        <div class="fin-row">
                            <div class="fin-icon" style="background:rgba(16,185,129,0.1);color:#10B981;"><i class="fas fa-heart"></i></div>
                            <span class="fin-label">@L["Ofrenda"]</span>
                            <span class="fin-amount" style="color:#10B981;">640 €</span>
                        </div>
                        <div class="fin-row">
                            <div class="fin-icon" style="background:rgba(245,158,11,0.1);color:#F59E0B;"><i class="fas fa-globe"></i></div>
                            <span class="fin-label">@L["Misiones"]</span>
                            <span class="fin-amount" style="color:#F59E0B;">500 €</span>
                        </div>
                        <!-- Mini bar chart -->
                        <div class="fin-bars">
                            <div class="fin-bar" style="height:55%;background:rgba(59,130,246,0.6);"></div>
                            <div class="fin-bar" style="height:40%;background:rgba(59,130,246,0.6);"></div>
                            <div class="fin-bar" style="height:70%;background:rgba(59,130,246,0.6);"></div>
                            <div class="fin-bar" style="height:50%;background:rgba(59,130,246,0.6);"></div>
                            <div class="fin-bar" style="height:85%;background:#3B82F6;border-radius:4px 4px 0 0;"></div>
                            <div class="fin-bar" style="height:65%;background:rgba(59,130,246,0.6);"></div>
                        </div>
                        <div style="text-align:right;margin-top:10px;">
                            <span style="font-size:0.78rem;color:#94A3B8;">@L["Total mes:"] </span>
                            <span style="font-size:0.9rem;font-weight:800;color:#1E3A8A;">3.240 €</span>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>
</section>

<!-- ═══════════════════ ALT SECTION 3 — Seguimiento Pastoral ═══════════════════ -->
<section class="alt-section">
    <div class="container">
        <div class="row align-items-center g-5">

            <!-- Text -->
            <div class="col-lg-5">
                <div class="mod-badge" style="background:rgba(139,92,246,0.1);color:#7C3AED;">
                    <i class="fas fa-clipboard-list"></i> @L["Seguimiento pastoral"]
                </div>
                <h2 class="alt-title">@L["Acompaña a cada persona en su camino de fe"]</h2>
                <p class="alt-desc">
                    @L["Registra cada visita, llamada o consejería de forma privada. El líder asignado puede consultar el historial completo para dar continuidad al cuidado pastoral."]
                </p>
                <div class="alt-feature">
                    <div class="alt-feature-icon" style="background:rgba(139,92,246,0.1);color:#8B5CF6;">
                        <i class="fas fa-phone-alt"></i>
                    </div>
                    <div>
                        <strong>@L["Tipos de seguimiento"]</strong>
                        <span>@L["Visita domiciliaria, llamada telefónica, consejería, oración o mensaje."]</span>
                    </div>
                </div>
                <div class="alt-feature">
                    <div class="alt-feature-icon" style="background:rgba(30,58,138,0.1);color:#1E3A8A;">
                        <i class="fas fa-user-tie"></i>
                    </div>
                    <div>
                        <strong>@L["Responsable asignado"]</strong>
                        <span>@L["Cada seguimiento queda asociado al líder o pastor que lo realizó."]</span>
                    </div>
                </div>
                <div class="alt-feature">
                    <div class="alt-feature-icon" style="background:rgba(0,191,165,0.1);color:#00BFA5;">
                        <i class="fas fa-lock"></i>
                    </div>
                    <div>
                        <strong>@L["Notas privadas y seguras"]</strong>
                        <span>@L["Las observaciones son internas y solo visibles para el equipo autorizado."]</span>
                    </div>
                </div>
            </div>

            <!-- Visual: timeline mockup -->
            <div class="col-lg-7">
                <div class="app-panel">
                    <div class="ap-topbar" style="background:#4C1D95;">
                        <div class="ap-dot" style="background:#FF5F57;"></div>
                        <div class="ap-dot" style="background:#FFBD2E;"></div>
                        <div class="ap-dot" style="background:#28CA41;"></div>
                        <span class="ap-title" style="color:white;">@L["Seguimiento — Carlos Sánchez López"]</span>
                    </div>
                    <div class="ap-body">
                        <!-- Header -->
                        <div style="display:flex;align-items:center;gap:10px;margin-bottom:18px;">
                            <div style="width:42px;height:42px;border-radius:50%;background:#8B5CF6;display:flex;align-items:center;justify-content:center;color:white;font-weight:800;font-size:0.9rem;">@L["CS"]</div>
                            <div>
                                <div style="font-weight:700;font-size:0.9rem;color:#1F2937;">@L["Carlos Sánchez López"]</div>
                                <div style="font-size:0.75rem;color:#94A3B8;">@L["Visitante · Zona Norte"]</div>
                            </div>
                            <span style="margin-left:auto;background:#EDE9FE;color:#6D28D9;font-size:0.7rem;font-weight:700;padding:4px 10px;border-radius:6px;">3 seguimientos</span>
                        </div>
                        <!-- Timeline -->
                        <div class="timeline-item">
                            <div class="tl-line-wrap">
                                <div class="tl-dot" style="background:#8B5CF6;"><i class="fas fa-comments" style="font-size:0.7rem;"></i></div>
                                <div class="tl-line"></div>
                            </div>
                            <div class="tl-content">
                                <div class="tl-type">@L["Consejería"]</div>
                                <div class="tl-person">@L["Pastor Juan —"] <span style="font-style:italic;color:#6B7280;">@L["\"Necesita apoyo en su situación familiar...\""]</span></div>
                                <div class="tl-date"><i class="fas fa-calendar" style="font-size:0.65rem;"></i> 18 Jun 2025</div>
                            </div>
                        </div>
                        <div class="timeline-item">
                            <div class="tl-line-wrap">
                                <div class="tl-dot" style="background:#3B82F6;"><i class="fas fa-phone" style="font-size:0.7rem;"></i></div>
                                <div class="tl-line"></div>
                            </div>
                            <div class="tl-content">
                                <div class="tl-type">@L["Llamada telefónica"]</div>
                                <div class="tl-person">@L["Líder María —"] <span style="font-style:italic;color:#6B7280;">@L["\"Animo y seguimiento semanal acordado.\""]</span></div>
                                <div class="tl-date"><i class="fas fa-calendar" style="font-size:0.65rem;"></i> 10 Jun 2025</div>
                            </div>
                        </div>
                        <div class="timeline-item" style="margin-bottom:0;">
                            <div class="tl-line-wrap">
                                <div class="tl-dot" style="background:#10B981;"><i class="fas fa-home" style="font-size:0.7rem;"></i></div>
                            </div>
                            <div class="tl-content">
                                <div class="tl-type">@L["Visita domiciliaria"]</div>
                                <div class="tl-person">@L["Pastor Juan —"] <span style="font-style:italic;color:#6B7280;">"Primera visita, muy receptivo."</span></div>
                                <div class="tl-date"><i class="fas fa-calendar" style="font-size:0.65rem;"></i> 2 Jun 2025</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>
</section>
