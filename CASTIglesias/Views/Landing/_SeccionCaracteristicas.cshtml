<!-- ═══════════════════ CARACTERÍSTICAS (overview grid) ═══════════════════ -->
<section id="caracteristicas" class="py-5" style="background:#fff;">
    <div class="container py-4">
        <div class="text-center mb-5">
            <div class="section-badge">@L["Características"]</div>
            <h2 class="section-title mt-2">@L["Todo lo que tu iglesia necesita"]</h2>
            <p class="section-subtitle mt-3">
                @L["Módulos completos diseñados específicamente para la gestión pastoral y administrativa de tu comunidad."]
            </p>
        </div>
        <div class="row g-4">
            <div class="col-sm-6 col-lg-4">
                <div class="feature-card">
                    <div class="feature-icon" style="background:rgba(59,130,246,0.1);">
                        <i class="fas fa-users" style="color:#3B82F6;"></i>
                    </div>
                    <h5>@L["Congregantes"]</h5>
                    <p>@L["Registro completo de miembros, simpatizantes y visitantes con fichas detalladas, historial y búsqueda avanzada."]</p>
                </div>
            </div>
            <div class="col-sm-6 col-lg-4">
                <div class="feature-card">
                    <div class="feature-icon" style="background:rgba(0,191,165,0.1);">
                        <i class="fas fa-sitemap" style="color:#00BFA5;"></i>
                    </div>
                    <h5>@L["Grupos y Zonas"]</h5>
                    <p>@L["Organiza la congregación en grupos, zonas y ministerios. Asigna líderes y controla la estructura de tu iglesia."]</p>
                </div>
            </div>
            <div class="col-sm-6 col-lg-4">
                <div class="feature-card">
                    <div class="feature-icon" style="background:rgba(245,158,11,0.1);">
                        <i class="fas fa-calendar-check" style="color:#F59E0B;"></i>
                    </div>
                    <h5>@L["Asistencia al Culto"]</h5>
                    <p>@L["Registro de asistencia por sesión con conteo de adultos, niños e invitados. Gráficas históricas comparativas."]</p>
                </div>
            </div>
            <div class="col-sm-6 col-lg-4">
                <div class="feature-card">
                    <div class="feature-icon" style="background:rgba(16,185,129,0.1);">
                        <i class="fas fa-hand-holding-usd" style="color:#10B981;"></i>
                    </div>
                    <h5>@L["Economía"]</h5>
                    <p>@L["Control de diezmos y ofrendas por concepto y miembro. Gráficas mensuales y anuales. Exportación a Excel."]</p>
                </div>
            </div>
            <div class="col-sm-6 col-lg-4">
                <div class="feature-card">
                    <div class="feature-icon" style="background:rgba(139,92,246,0.1);">
                        <i class="fas fa-clipboard-list" style="color:#8B5CF6;"></i>
                    </div>
                    <h5>@L["Seguimiento pastoral"]</h5>
                    <p>@L["Registro de visitas, llamadas y consejerías por congregante. Historial completo del acompañamiento pastoral."]</p>
                </div>
            </div>
            <div class="col-sm-6 col-lg-4">
                <div class="feature-card">
                    <div class="feature-icon" style="background:rgba(30,58,138,0.1);">
                        <i class="fas fa-building" style="color:#1E3A8A;"></i>
                    </div>
                    <h5>@L["Multi-sede"]</h5>
                    <p>@L["Gestiona múltiples sedes desde un único acceso de administrador global. Cada sede accede solo a sus datos."]</p>
                </div>
            </div>
        </div>
    </div>
</section>
