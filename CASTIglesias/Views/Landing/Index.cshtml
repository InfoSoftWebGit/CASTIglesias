@* Landing principal (/). Las secciones viven en partials de esta misma carpeta
   para que las páginas independientes (/caracteristicas, /como-funciona,
   /precios, /contacto) muestren exactamente el mismo contenido sin duplicarlo.
   La cabecera, la barra, el pie, los estilos y los scripts están en
   _LayoutPublico.cshtml. *@
@{
    Layout = "~/Views/Landing/_LayoutPublico.cshtml";
    ViewData["EsLanding"] = true;
    ViewData["Title"] = L["Congrega CRM — Software de Gestión para Iglesias"].Value;
    ViewData["Descripcion"] = L["Congrega CRM es el software de gestión para iglesias: miembros, grupos, ministerios, asistencia, finanzas y donaciones en una sola app. Pruébalo gratis."].Value;
    ViewData["RutaCanonica"] = "";
}

<!-- ═══════════════════ HERO ═══════════════════ -->
<section id="inicio" class="hero-section">

    <!-- Decorative rings -->
    <div class="deco-ring" style="width:700px;height:700px;top:-200px;right:-160px;"></div>
    <div class="deco-ring" style="width:420px;height:420px;top:-60px;right:-40px;border-color:rgba(255,255,255,0.04);"></div>
    <div class="deco-ring" style="width:320px;height:320px;bottom:-120px;left:-100px;"></div>
    <div class="deco-ring" style="width:160px;height:160px;bottom:80px;left:30px;border-color:rgba(0,191,165,0.12);"></div>

    <!-- Background glow blobs -->
    <div style="position:absolute;width:550px;height:550px;top:-120px;right:-60px;
                background:radial-gradient(circle,rgba(59,130,246,0.1) 0%,transparent 68%);
                border-radius:50%;pointer-events:none;"></div>
    <div style="position:absolute;width:400px;height:400px;bottom:-100px;left:-80px;
                background:radial-gradient(circle,rgba(0,191,165,0.07) 0%,transparent 68%);
                border-radius:50%;pointer-events:none;"></div>

    <!-- Dot grid -->
    <div class="dot-grid" style="top:90px;right:10px;width:160px;">
        <span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span>
        <span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span>
        <span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span>
        <span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span>
        <span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span>
        <span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span>
    </div>

    <!-- Floating decorative dots -->
    <div class="deco-dot" style="width:8px;height:8px;top:22%;left:42%;animation:floatA 4s ease-in-out infinite;"></div>
    <div class="deco-dot" style="width:5px;height:5px;top:65%;left:48%;animation:floatC 6s ease-in-out infinite 1s;"></div>
    <div class="deco-dot" style="width:10px;height:10px;top:30%;right:18%;animation:floatB 5s ease-in-out infinite 0.5s;opacity:0.08;"></div>

    <div class="container" style="position:relative;z-index:2;">
        <div class="row align-items-center g-5">

            <!-- ── LEFT: copy ── -->
            <div class="col-lg-5">
                <div class="hero-badge">
                    @L["Software diseñado para iglesias"]
                </div>
                <h1 class="hero-title">
                    @* La palabra destacada va al final de la frase en ambos idiomas, así
                       el <span> no obliga a partir la traducción por la mitad:
                       ES "Gestiona tu iglesia / de forma inteligente",
                       EN "Manage your church / the smart way". *@
                    @L["Gestiona tu iglesia"]<br>@L["de forma"] <span>@L["inteligente"]</span>
                </h1>
                <p class="hero-subtitle">
                    @L["Congrega es el CRM pensado para comunidades de fe. Controla congregantes, grupos, finanzas, asistencia y mucho más desde una sola plataforma."]
                </p>

                <!-- Trust pills -->
                <div class="d-flex flex-wrap gap-2 mb-4">
                    <span style="background:rgba(255,255,255,0.08);border:1px solid rgba(255,255,255,0.12);color:rgba(255,255,255,0.75);border-radius:20px;padding:4px 13px;font-size:0.78rem;font-weight:600;">
                        <i class="fas fa-check-circle me-1" style="color:var(--teal);"></i> @L["Multi-sede"]
                    </span>
                    <span style="background:rgba(255,255,255,0.08);border:1px solid rgba(255,255,255,0.12);color:rgba(255,255,255,0.75);border-radius:20px;padding:4px 13px;font-size:0.78rem;font-weight:600;">
                        <i class="fas fa-check-circle me-1" style="color:var(--teal);"></i> @L["100% en la nube"]
                    </span>
                    <span style="background:rgba(255,255,255,0.08);border:1px solid rgba(255,255,255,0.12);color:rgba(255,255,255,0.75);border-radius:20px;padding:4px 13px;font-size:0.78rem;font-weight:600;">
                        <i class="fas fa-check-circle me-1" style="color:var(--teal);"></i> @L["Soporte incluido"]
                    </span>
                </div>

                <div class="d-flex gap-3 flex-wrap">
                    <a href="/Login" class="btn btn-lg px-4 py-3"
                       style="background:var(--teal);color:white;border-radius:10px;font-weight:700;box-shadow:0 6px 24px rgba(0,191,165,0.35);">
                        <i class="fas fa-sign-in-alt me-2"></i>@L["Acceder a la app"]
                    </a>
                    <a href="#caracteristicas" class="btn btn-outline-light btn-lg px-4 py-3"
                       style="border-radius:10px;font-weight:600;">
                        @L["Ver características"]
                    </a>
                </div>
            </div>

            <!-- ── RIGHT: carousel mockup ── -->
            <div class="col-lg-7">
                <div class="carousel-mockup">
                    <div class="mockup-topbar">
                        <div class="mockup-dot" style="background:#FF5F57;"></div>
                        <div class="mockup-dot" style="background:#FFBD2E;"></div>
                        <div class="mockup-dot" style="background:#28CA41;"></div>
                        <span class="mockup-topbar-title">@L["Congrega CRM — Panel de administración"]</span>
                    </div>
                    <div id="heroCarousel" class="carousel slide" data-bs-ride="carousel" data-bs-interval="4500">
                        <div class="carousel-indicators" style="bottom:-2px;">
                            <button type="button" data-bs-target="#heroCarousel" data-bs-slide-to="0" class="active"></button>
                            <button type="button" data-bs-target="#heroCarousel" data-bs-slide-to="1"></button>
                            <button type="button" data-bs-target="#heroCarousel" data-bs-slide-to="2"></button>
                            <button type="button" data-bs-target="#heroCarousel" data-bs-slide-to="3"></button>
                            <button type="button" data-bs-target="#heroCarousel" data-bs-slide-to="4"></button>
                        </div>
                        <div class="carousel-inner mockup-body">

                            <!-- Slide 1 — Dashboard -->
                            <div class="carousel-item active">
                                <div class="carousel-item-inner">
                                    <div class="slide-icon-box" style="background:rgba(59,130,246,0.18);">
                                        <i class="fas fa-chart-line" style="color:#3B82F6;"></i>
                                    </div>
                                    <div class="slide-title">@L["Dashboard en tiempo real"]</div>
                                    <div class="slide-desc">@L["Visualiza el estado de tu iglesia de un vistazo con gráficas y KPIs siempre actualizados."]</div>
                                    <div class="mockup-kpi-grid">
                                        <div class="mockup-kpi">
                                            <div class="kpi-label">@L["Miembros activos"]</div>
                                            <div class="kpi-value" style="color:#3B82F6;">248</div>
                                        </div>
                                        <div class="mockup-kpi">
                                            <div class="kpi-label">@L["Visitantes"]</div>
                                            <div class="kpi-value" style="color:#00BFA5;">34</div>
                                        </div>
                                        <div class="mockup-kpi">
                                            <div class="kpi-label">@L["Diezmos (mes)"]</div>
                                            <div class="kpi-value" style="color:#F59E0B;">3.240 €</div>
                                        </div>
                                        <div class="mockup-kpi">
                                            <div class="kpi-label">@L["Asistencia (dom.)"]</div>
                                            <div class="kpi-value" style="color:#10B981;">192</div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Slide 2 — Congregantes -->
                            <div class="carousel-item">
                                <div class="carousel-item-inner">
                                    <div class="slide-icon-box" style="background:rgba(0,191,165,0.18);">
                                        <i class="fas fa-users" style="color:#00BFA5;"></i>
                                    </div>
                                    <div class="slide-title">@L["Gestión de congregantes"]</div>
                                    <div class="slide-desc">@L["Registro completo de miembros, simpatizantes y visitantes con ficha detallada por persona."]</div>
                                    <div class="slide-feature"><i class="fas fa-check-circle"></i> @L["Datos personales, contacto y familia"]</div>
                                    <div class="slide-feature"><i class="fas fa-check-circle"></i> @L["Estados: miembro, simpatizante, visitante, en proceso"]</div>
                                    <div class="slide-feature"><i class="fas fa-check-circle"></i> @L["Búsqueda avanzada y filtros por sede"]</div>
                                    <div class="slide-feature"><i class="fas fa-check-circle"></i> @L["Historial de cambios y observaciones"]</div>
                                </div>
                            </div>

                            <!-- Slide 3 — Grupos y Zonas -->
                            <div class="carousel-item">
                                <div class="carousel-item-inner">
                                    <div class="slide-icon-box" style="background:rgba(245,158,11,0.18);">
                                        <i class="fas fa-sitemap" style="color:#F59E0B;"></i>
                                    </div>
                                    <div class="slide-title">@L["Grupos, Zonas y Ministerios"]</div>
                                    <div class="slide-desc">@L["Organiza tu comunidad con total flexibilidad según la estructura de tu iglesia."]</div>
                                    <div class="slide-feature"><i class="fas fa-check-circle"></i> @L["Creación de grupos por zona o ministerio"]</div>
                                    <div class="slide-feature"><i class="fas fa-check-circle"></i> @L["Asignación de líderes y encargados"]</div>
                                    <div class="slide-feature"><i class="fas fa-check-circle"></i> @L["Listados de miembros por agrupación"]</div>
                                    <div class="slide-feature"><i class="fas fa-check-circle"></i> @L["Vista de estructura jerárquica"]</div>
                                </div>
                            </div>

                            <!-- Slide 4 — Economía -->
                            <div class="carousel-item">
                                <div class="carousel-item-inner">
                                    <div class="slide-icon-box" style="background:rgba(16,185,129,0.18);">
                                        <i class="fas fa-hand-holding-usd" style="color:#10B981;"></i>
                                    </div>
                                    <div class="slide-title">@L["Control económico"]</div>
                                    <div class="slide-desc">@L["Registra y controla diezmos, ofrendas y conceptos financieros con gráficas detalladas."]</div>
                                    <div class="slide-feature"><i class="fas fa-check-circle"></i> @L["Diezmos y ofrendas por miembro y concepto"]</div>
                                    <div class="slide-feature"><i class="fas fa-check-circle"></i> @L["Gráficas comparativas mensuales y anuales"]</div>
                                    <div class="slide-feature"><i class="fas fa-check-circle"></i> @L["Exportación de informes a Excel"]</div>
                                    <div class="slide-feature"><i class="fas fa-check-circle"></i> @L["Configuración de conceptos personalizados"]</div>
                                </div>
                            </div>

                            <!-- Slide 5 — Seguimiento -->
                            <div class="carousel-item">
                                <div class="carousel-item-inner">
                                    <div class="slide-icon-box" style="background:rgba(139,92,246,0.18);">
                                        <i class="fas fa-clipboard-list" style="color:#8B5CF6;"></i>
                                    </div>
                                    <div class="slide-title">@L["Seguimiento pastoral"]</div>
                                    <div class="slide-desc">@L["Acompañamiento integral con registro de visitas, llamadas y consejerías por congregante."]</div>
                                    <div class="slide-feature"><i class="fas fa-check-circle"></i> @L["Registro de visitas, llamadas y consejerías"]</div>
                                    <div class="slide-feature"><i class="fas fa-check-circle"></i> @L["Persona a cargo de cada seguimiento"]</div>
                                    <div class="slide-feature"><i class="fas fa-check-circle"></i> @L["Historial completo por congregante"]</div>
                                    <div class="slide-feature"><i class="fas fa-check-circle"></i> @L["Notas y observaciones privadas"]</div>
                                </div>
                            </div>
                        </div>

                        <button class="carousel-control-prev" type="button"
                                data-bs-target="#heroCarousel" data-bs-slide="prev">
                            <span class="carousel-control-prev-icon"></span>
                        </button>
                        <button class="carousel-control-next" type="button"
                                data-bs-target="#heroCarousel" data-bs-slide="next">
                            <span class="carousel-control-next-icon"></span>
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ═══════════════════ COLABORADORES ═══════════════════ -->
<partial name="_Colaboradores" model="@("franja")" />

<!-- ═══════════════════ STATS BAND ═══════════════════ -->
<div class="stats-band">
    <div class="container">
        <div class="row g-4 text-center justify-content-center">
            <div class="col-6 col-md-3">
                <div class="stat-number">6+</div>
                <div class="stat-label">@L["Módulos integrados"]</div>
            </div>
            <div class="col-6 col-md-3">
                <div class="stat-number">@L["Multi-sede"]</div>
                <div class="stat-label">@L["Gestión centralizada"]</div>
            </div>
            <div class="col-6 col-md-3">
                <div class="stat-number">100%</div>
                <div class="stat-label">@L["En la nube"]</div>
            </div>
            <div class="col-6 col-md-3">
                <div class="stat-number">24/7</div>
                <div class="stat-label">@L["Disponibilidad"]</div>
            </div>
        </div>
    </div>
</div>

<partial name="_SeccionCaracteristicas" />

<partial name="_SeccionComoFunciona" />

<partial name="_SeccionModulos" />

<partial name="_SeccionTestimonios" />

