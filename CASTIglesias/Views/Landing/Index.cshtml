@{
    Layout = null;
}
<!DOCTYPE html>
@* Esta vista no usa el layout, así que declara su propio lang. Sin esto, un
   navegador o un buscador leería la página en inglés como si fuese española. *@
<html lang="@IdiomasSoportados.Actual">
<head>
    <!-- Google Tag Manager -->
