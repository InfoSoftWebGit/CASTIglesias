@{
    ViewData["Title"] = L["Configuración de Diezmos y Miembros"].Value;
}

<div class="container-fluid px-4">
    <h1 class="mt-4">@L["Configuración de Diezmos y Miembros"]</h1>
    <ol class="breadcrumb mb-4">
        <li class="breadcrumb-item"><a href="@Url.Action("Index", "Home")">@L["Inicio"]</a></li>
        <li class="breadcrumb-item">@L["Ajustes"]</li>
        <li class="breadcrumb-item active">@L["Diezmos y Miembros"]</li>
    </ol>

    <div class="row">
        <div class="col-md-6">
            <div class="card mb-4">
                <div class="card-header">
                    <i class="fas fa-hashtag me-1"></i>
                    @L["Numeración de Diezmos"]
                </div>
                <div class="card-body">
                    <p class="text-muted small mb-3">
                        @L["Define el prefijo que se añadirá antes del número al generar identificadores de diezmo. Por ejemplo, con prefijo"] <strong>M</strong> @L["el número quedará como"] <strong>M0001</strong>.
                    </p>

                    <div class="mb-3">
                        <label for="txtPrefijoIndividual" class="form-label">@L["Prefijo Diezmo Individual"]</label>
                        <div class="input-group">
                            <input id="txtPrefijoIndividual" type="text" class="form-control" maxlength="10"
                                   placeholder="@L["Ej: M, IND, VFF..."]" />
                            <span class="input-group-text text-muted" id="previewIndividual"></span>
                        </div>
                        <div class="form-text">@L["Máximo 10 caracteres."]</div>
                    </div>

                    <div class="mb-3">
                        <label for="txtPrefijoFamiliar" class="form-label">@L["Prefijo Diezmo Familiar"]</label>
                        <div class="input-group">
                            <input id="txtPrefijoFamiliar" type="text" class="form-control" maxlength="10"
                                   placeholder="@L["Ej: F, FAM, VFF..."]" />
                            <span class="input-group-text text-muted" id="previewFamiliar"></span>
                        </div>
                        <div class="form-text">@L["Máximo 10 caracteres."]</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card mb-4">
                <div class="card-header">
                    <i class="fas fa-id-card me-1"></i>
                    @L["Numeración de Miembros"]
                </div>
                <div class="card-body">
                    <p class="text-muted small mb-3">
                        @L["Define el prefijo que se mostrará delante del número de miembro. El número se sigue guardando sin prefijo; este solo se aplica al visualizarlo. Por ejemplo, con prefijo"] <strong>M</strong> @L["el miembro 25 se mostrará como"] <strong>M0025</strong>.
                    </p>

                    <div class="mb-3">
                        <label for="txtPrefijoMiembro" class="form-label">@L["Prefijo Número de Miembro"]</label>
                        <div class="input-group">
                            <input id="txtPrefijoMiembro" type="text" class="form-control" maxlength="10"
                                   placeholder="@L["Ej: M, MBR..."]" />
                            <span class="input-group-text text-muted" id="previewMiembro"></span>
                        </div>
                        <div class="form-text">@L["Máximo 10 caracteres."]</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <button id="btnGuardar" class="btn btn-primary mb-4">
        <i class="fas fa-save me-1"></i> @L["Guardar configuración"]
    </button>
</div>

@section scripts {
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
    const urlObtener = '@Url.Action("ObtenerConfigDiezmo", "Ajustes")';
    const urlGuardar = '@Url.Action("GuardarConfigDiezmo", "Ajustes")';

    function actualizarPreview(inputId, previewId) {
        const prefijo = $(inputId).val().trim().toUpperCase();
        $(previewId).text(prefijo ? prefijo + '0001' : '');
        $(inputId).val(prefijo);
    }

    $(document).ready(function () {
        $.get(urlObtener, function (res) {
            if (res.success && res.data) {
                $('#txtPrefijoIndividual').val(res.data.prefijo_individual || '');
                $('#txtPrefijoFamiliar').val(res.data.prefijo_familiar || '');
                $('#txtPrefijoMiembro').val(res.data.prefijo_miembro || '');
                actualizarPreview('#txtPrefijoIndividual', '#previewIndividual');
                actualizarPreview('#txtPrefijoFamiliar', '#previewFamiliar');
                actualizarPreview('#txtPrefijoMiembro', '#previewMiembro');
            }
        });

        $('#txtPrefijoIndividual').on('input', function () {
            actualizarPreview('#txtPrefijoIndividual', '#previewIndividual');
        });

        $('#txtPrefijoFamiliar').on('input', function () {
            actualizarPreview('#txtPrefijoFamiliar', '#previewFamiliar');
        });

        $('#txtPrefijoMiembro').on('input', function () {
            actualizarPreview('#txtPrefijoMiembro', '#previewMiembro');
        });

        $('#btnGuardar').on('click', function () {
            const prefijo_individual = $('#txtPrefijoIndividual').val().trim();
            const prefijo_familiar = $('#txtPrefijoFamiliar').val().trim();
            const prefijo_miembro = $('#txtPrefijoMiembro').val().trim();

            $.ajax({
                url: urlGuardar,
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify({ prefijo_individual, prefijo_familiar, prefijo_miembro }),
                success: function (res) {
                    Swal.fire({
                        toast: true,
                        position: 'top-end',
                        icon: res.success ? 'success' : 'error',
                        title: res.mensaje,
                        showConfirmButton: false,
                        timer: 3000,
                        timerProgressBar: true
                    });
                },
                error: function () {
                    Swal.fire('Error', 'No se pudo guardar la configuración.', 'error');
                }
            });
        });
    });
</script>
}
