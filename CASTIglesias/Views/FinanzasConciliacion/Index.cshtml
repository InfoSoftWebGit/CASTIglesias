@using CapaEntidad.Financiero
@{
    ViewBag.Title = L["Conciliación bancaria"].Value;
    Layout = "~/Views/Shared/_Layout.cshtml";

    var cuentas = ViewBag.Cuentas as List<TreasuryAccount> ?? new List<TreasuryAccount>();
}

<link href="https://cdn.datatables.net/2.0.3/css/dataTables.bootstrap5.min.css" rel="stylesheet" />

<ol class="breadcrumb mb-4 mt-4">
    <li class="breadcrumb-item"><a href="@Url.Action("Index", "Finanzas")">@L["Panel financiero"]</a></li>
    <li class="breadcrumb-item active">@L["Conciliación bancaria"]</li>
</ol>

<div class="alert alert-info d-flex align-items-start">
    <i class="fas fa-info-circle me-2 mt-1"></i>
    <div>
        @L["El saldo que dice Congrega y el que dice el banco casi nunca coinciden al día. La diferencia tiene dos causas: movimientos que el banco aún no ha reflejado, que es normal, o movimientos que nadie ha registrado, que es un agujero. Conciliar separa lo uno de lo otro."]
        <div class="mt-1">
            <strong>@L["Pide a tu banco el fichero en Norma 43."]</strong>
            @L["Es el formato estándar que todas las entidades españolas saben exportar. Si no lo tienes, vale un CSV con fecha, concepto e importe."]
        </div>
    </div>
</div>

@if (cuentas.Count == 0)
{
    <div class="card mb-4">
        <div class="card-body text-center py-5">
            <i class="fas fa-building-columns fa-3x text-muted mb-3"></i>
            <h5>@L["No hay ninguna cuenta bancaria"]</h5>
            <p class="text-muted">
                @L["Solo se concilian las cuentas de banco. Una caja de efectivo no tiene extracto: se cuenta a mano, y eso es el arqueo."]
            </p>
            <a href="@Url.Action("Index", "FinanzasTesoreria")" class="btn btn-primary">@L["Ir a cajas y bancos"]</a>
        </div>
    </div>
}
else
{
    <div class="card mb-4">
        <div class="card-header"><i class="fas fa-file-import me-1"></i> @L["Importar un extracto"]</div>
        <div class="card-body">
            <form id="formImportar" enctype="multipart/form-data">
                <div class="row g-3 align-items-end">
                    <div class="col-sm-5">
                        <label for="impCuenta" class="form-label">@L["Cuenta"]</label>
                        <select id="impCuenta" name="idCaja" class="form-select">
                            @foreach (var c in cuentas)
                            {
                                <option value="@c.id">@c.name</option>
                            }
                        </select>
                    </div>
                    <div class="col-sm-5">
                        <label for="impFichero" class="form-label">@L["Fichero del banco"]</label>
                        <input type="file" id="impFichero" name="fichero" class="form-control"
                               accept=".txt,.csv,.n43,.q43,.c43" />
                        <div class="form-text">@L["Norma 43 o CSV. El formato se detecta solo."]</div>
                    </div>
                    <div class="col-sm-2">
                        <button type="submit" class="btn btn-primary w-100">
                            <i class="fas fa-upload me-1"></i> @L["Importar"]
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>
}

<div class="card mb-4">
    <div class="card-header"><i class="fas fa-layer-group me-1"></i> @L["Extractos importados"]</div>
    <div class="table-responsive">
        <table id="tablaExtractos" class="table table-bordered table-striped border-top" style="width:100%">
            <thead>
                <tr>
                    <th>@L["Cuenta"]</th>
                    <th>@L["Periodo"]</th>
                    <th class="text-end">@L["Saldo final"]</th>
                    <th class="text-end">@L["Movimientos"]</th>
                    <th class="text-end">@L["Sin conciliar"]</th>
                    <th>@L["Acciones"]</th>
                </tr>
            </thead>
            @* Sin fila de "no hay datos" escrita a mano: DataTables leería ese colspan
               como un registro. El mensaje lo pone language.emptyTable. *@
            <tbody></tbody>
        </table>
    </div>
</div>

<div class="card mb-4 d-none" id="tarjetaLineas">
    <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
        <span><i class="fas fa-code-compare me-1"></i> @L["Cruce con lo registrado"]</span>
        <div class="small">
            <span class="me-3">@L["Banco"]: <strong id="resSaldoBanco">—</strong></span>
            <span class="me-3">@L["Congrega"]: <strong id="resSaldoNuestro">—</strong></span>
            <span>@L["Diferencia"]: <strong id="resDiferencia">—</strong></span>
        </div>
    </div>
    <div class="table-responsive">
        <table id="tablaLineas" class="table table-bordered table-striped border-top" style="width:100%">
            <thead>
                <tr>
                    <th>@L["Fecha"]</th>
                    <th>@L["Concepto del extracto"]</th>
                    <th class="text-end">@L["Importe"]</th>
                    <th>@L["Propuesta de Congrega"]</th>
                    <th>@L["Confianza"]</th>
                    <th>@L["Acciones"]</th>
                </tr>
            </thead>
            <tbody></tbody>
        </table>
    </div>
</div>

@section scripts {
    <script src="https://cdn.datatables.net/2.0.3/js/dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/2.0.3/js/dataTables.bootstrap5.min.js"></script>
    <script>
        window.T = Object.assign(window.T || {}, {
            sinExtractos:  @Json.Serialize(L["Todavía no has importado ningún extracto."].Value),
            sinLineas:     @Json.Serialize(L["Este extracto no tiene movimientos."].Value),
            error:         @Json.Serialize(L["Error"].Value),
            si:            @Json.Serialize(L["Sí"].Value),
            no:            @Json.Serialize(L["No"].Value),
            ver:           @Json.Serialize(L["Ver el cruce"].Value),
            conciliar:     @Json.Serialize(L["Conciliar"].Value),
            deshacer:      @Json.Serialize(L["Deshacer"].Value),
            sinPareja:     @Json.Serialize(L["Sin coincidencia"].Value),
            yaConciliado:  @Json.Serialize(L["Conciliado"].Value),
            eligeFichero:  @Json.Serialize(L["Elige un fichero."].Value),
            crearGasto:    @Json.Serialize(L["Nadie ha registrado este movimiento en Congrega. Regístralo desde Ingresos o Gastos y vuelve a conciliar."].Value)
        });

        const CONFIANZA = {
            alta:    { texto: @Json.Serialize(L["Alta"].Value),    clase: "bg-success" },
            media:   { texto: @Json.Serialize(L["Media"].Value),   clase: "bg-warning text-dark" },
            ninguna: { texto: @Json.Serialize(L["Ninguna"].Value), clase: "bg-secondary" }
        };

        let tablaExtractos, tablaLineas, extractoActual = 0;

        function dinero(v) {
            return (v || 0).toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 });
        }
        function escapar(t) { return $('<div>').text(t || '').html(); }

        function cargarLineas(idExtracto) {
            extractoActual = idExtracto;
            $('#tarjetaLineas').removeClass('d-none');

            $.get('@Url.Action("Lineas", "FinanzasConciliacion")', { idExtracto: idExtracto }, function (res) {
                $('#resSaldoBanco').text(dinero(res.saldoBanco));
                $('#resSaldoNuestro').text(dinero(res.saldoNuestro));
                $('#resDiferencia')
                    .text(dinero(res.diferencia))
                    .removeClass('text-danger text-success')
                    .addClass(Math.abs(res.diferencia) < 0.005 ? 'text-success' : 'text-danger');

                tablaLineas.clear().rows.add(res.data).draw();
                // La tabla acaba de aparecer: sin esto las columnas salen amontonadas
                tablaLineas.columns.adjust();
            });
        }

        $(document).ready(function () {
            tablaExtractos = $('#tablaExtractos').DataTable({
                responsive: true,
                ajax: { url: '@Url.Action("ListarExtractos", "FinanzasConciliacion")', dataSrc: 'data' },
                columns: [
                    { data: 'caja' },
                    {
                        data: null,
                        render: function (f) {
                            return new Date(f.period_start).toLocaleDateString() + ' – ' +
                                   new Date(f.period_end).toLocaleDateString();
                        }
                    },
                    { data: 'closing_balance', className: 'text-end', render: dinero },
                    { data: 'lineas', className: 'text-end' },
                    {
                        data: 'sin_conciliar', className: 'text-end',
                        render: function (v, t) {
                            if (t !== 'display') return v;
                            if (v === 0) return '<span class="badge bg-success">0</span>';
                            return '<span class="badge bg-warning text-dark">' + v + '</span>';
                        }
                    },
                    {
                        data: null, orderable: false, className: 'text-center',
                        render: function (f) {
                            return '<button class="btn btn-sm btn-primary btn-ver" data-id="' + f.id + '">' +
                                   '<i class="fas fa-code-compare me-1"></i>' + T.ver + '</button>';
                        }
                    }
                ],
                language: {
                    url: '@(System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "en" ? "" : "https://cdn.datatables.net/plug-ins/2.0.3/i18n/es-ES.json")',
                    emptyTable: T.sinExtractos
                }
            });

            tablaLineas = $('#tablaLineas').DataTable({
                responsive: true,
                pageLength: 25,
                data: [],
                columns: [
                    {
                        data: 'booking_date',
                        render: function (d) { return d ? new Date(d).toLocaleDateString() : ''; }
                    },
                    { data: 'description', defaultContent: '', render: escapar },
                    {
                        data: 'amount', className: 'text-end',
                        render: function (v, t) {
                            if (t !== 'display') return v;
                            // El signo importa más que el número: entra o sale
                            const clase = v < 0 ? 'text-danger' : '';
                            return '<span class="' + clase + '">' + dinero(v) + '</span>';
                        }
                    },
                    {
                        data: 'propuesta_texto',
                        render: function (v, t, fila) {
                            if (fila.reconciliation_status === 'reconciled') {
                                return '<span class="text-success"><i class="fas fa-check me-1"></i>' +
                                       T.yaConciliado + '</span>';
                            }
                            if (!v) return '<em class="text-muted">' + T.sinPareja + '</em>';
                            return escapar(v) + '<div class="small text-muted">' +
                                   new Date(fila.propuesta_fecha).toLocaleDateString() + '</div>';
                        }
                    },
                    {
                        data: 'confianza',
                        render: function (v, t, fila) {
                            if (fila.reconciliation_status === 'reconciled') return '';
                            const c = CONFIANZA[v] || CONFIANZA.ninguna;
                            return '<span class="badge ' + c.clase + '">' + c.texto + '</span>';
                        }
                    },
                    {
                        data: null, orderable: false, className: 'text-center',
                        render: function (fila) {
                            if (fila.reconciliation_status === 'reconciled') {
                                return '<button class="btn btn-sm btn-outline-secondary btn-deshacer" data-id="' +
                                       fila.id + '">' + T.deshacer + '</button>';
                            }
                            if (!fila.propuesta_movimiento_id) {
                                return '<button class="btn btn-sm btn-outline-secondary btn-sinpareja">' +
                                       '<i class="fas fa-circle-question"></i></button>';
                            }
                            return '<button class="btn btn-sm btn-success btn-conciliar" data-id="' + fila.id +
                                   '" data-mov="' + fila.propuesta_movimiento_id + '">' +
                                   '<i class="fas fa-link me-1"></i>' + T.conciliar + '</button>';
                        }
                    }
                ],
                language: {
                    url: '@(System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "en" ? "" : "https://cdn.datatables.net/plug-ins/2.0.3/i18n/es-ES.json")',
                    emptyTable: T.sinLineas
                }
            });

            $('#tablaExtractos tbody').on('click', '.btn-ver', function () {
                cargarLineas($(this).data('id'));
            });

            $('#tablaLineas tbody').on('click', '.btn-conciliar', function () {
                const b = $(this);
                $.post('@Url.Action("Conciliar", "FinanzasConciliacion")',
                    { idLinea: b.data('id'), idMovimiento: b.data('mov') }, function (r) {
                        if (r.resultado) {
                            cargarLineas(extractoActual);
                            tablaExtractos.ajax.reload(null, false);
                        } else {
                            Swal.fire(T.error, r.mensaje, 'error');
                        }
                    });
            });

            $('#tablaLineas tbody').on('click', '.btn-deshacer', function () {
                $.post('@Url.Action("Desconciliar", "FinanzasConciliacion")',
                    { idLinea: $(this).data('id') }, function (r) {
                        if (r.resultado) {
                            cargarLineas(extractoActual);
                            tablaExtractos.ajax.reload(null, false);
                        } else {
                            Swal.fire(T.error, r.mensaje, 'error');
                        }
                    });
            });

            $('#tablaLineas tbody').on('click', '.btn-sinpareja', function () {
                Swal.fire({ icon: 'info', text: T.crearGasto });
            });

            $('#formImportar').on('submit', function (e) {
                e.preventDefault();

                const fichero = $('#impFichero')[0].files[0];
                if (!fichero) { Swal.fire(T.error, T.eligeFichero, 'error'); return; }

                const datos = new FormData();
                datos.append('fichero', fichero);
                datos.append('idCaja', $('#impCuenta').val());

                $.ajax({
                    url: '@Url.Action("Importar", "FinanzasConciliacion")',
                    type: 'POST',
                    data: datos,
                    processData: false,
                    contentType: false,
                    success: function (r) {
                        if (r.resultado) {
                            Swal.fire({ icon: 'success', title: r.mensaje, timer: 3000, showConfirmButton: false });
                            $('#impFichero').val('');
                            tablaExtractos.ajax.reload(null, false);
                            cargarLineas(r.id);
                        } else {
                            Swal.fire(T.error, r.mensaje, 'error');
                        }
                    }
                });
            });
        });
    </script>
}
