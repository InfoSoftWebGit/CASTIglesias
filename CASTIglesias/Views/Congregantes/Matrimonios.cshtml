@{
    ViewBag.Title = L["Matrimonios"].Value;
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<link rel="stylesheet" href="https://cdn.datatables.net/2.0.3/css/dataTables.bootstrap5.min.css" />

<ol class="breadcrumb mb-4 mt-4">
    <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">@L["Información"]</a></li>
    <li class="breadcrumb-item active">@L["Matrimonios"]</li>
</ol>

<div class="card">
    <div class="card-header">
        <i class="fas fa-ring me-1"></i> @L["Lista de Matrimonios"]
    </div>
    <div class="table-responsive">
        <div class="row mb-3">
            <div class="col-12">
                <button data-permiso="MatrimoniosCrearEditar" type="button" class="btn btn-success" onclick="abrirModalMatrimonios()">@L["Añadir matrimonio"]</button>
            </div>
        </div>

        <table id="tablaMatrimonios" class="table table-bordered table-striped border-top" style="width: 100%">
            <thead>
                <tr>
                    <th>@L["Esposo"]</th>
                    <th>@L["Esposa"]</th>
                    <th>@L["Líderes"]</th>
                    <th>@L["Seguidor"]</th>
                    <th>@L["Acciones"]</th>
                </tr>
            </thead>
            <tbody></tbody>
        </table>
    </div>
</div>

<!-- MODAL -->
<div class="modal fade" id="FormModalMatrimonios" tabindex="-1" aria-hidden="true" data-bs-backdrop="static">
    <div class="modal-dialog modal-md">
        <div class="modal-content">
            <div class="modal-header text-white" style="background-color: #1E3A8A;">
                <h5 class="modal-title" id="tituloModalMatrimonios">@L["Nuevo matrimonio"]</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="@L["Cerrar"]"></button>
            </div>
            <div class="modal-body">
                <input id="txtIdMatrimonio" type="hidden" value="0" />
                <div class="row g-3">
                    <div class="col-12">
                        <label class="form-label">@L["Esposo"] <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" id="txtEsposoMatrimonio"
                               placeholder="@L["Ej: Rubén"]" autocomplete="off" />
                        <div class="form-text">@L["Escribe al menos 2 letras y elige al miembro de la lista."]</div>
                    </div>
                    <div class="col-12">
                        <label class="form-label">@L["Esposa"] <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" id="txtEsposaMatrimonio"
                               placeholder="@L["Ej: Sady"]" autocomplete="off" />
                        <div class="form-text">@L["Escribe al menos 2 letras y elige al miembro de la lista."]</div>
                    </div>
                    <div class="col-sm-6">
                        <label class="form-label">@L["Líderes"]</label>
                        <select id="cboLideres" class="form-select">
                            <option value="No">@L["No"]</option>
                            <option value="Si">@L["Sí"]</option>
                        </select>
                    </div>
                    <div class="col-sm-6">
                        <label class="form-label">@L["Seguidor"]</label>
                        <select id="cboSeguidor" class="form-select">
                            <option value="">@L["— Sin seguidor —"]</option>
                        </select>
                        <div class="form-text">@L["Pareja que les hace seguimiento."]</div>
                    </div>
                </div>
                <div class="row mt-3">
                    <div class="col-12">
                        <div id="mensajeErrorMatrimonio" class="alert alert-danger d-none"></div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">@L["Cerrar"]</button>
                <button type="button" class="btn btn-primary" onclick="guardarMatrimonio()">@L["Guardar"]</button>
            </div>
        </div>
    </div>
</div>

@section scripts {
    <script src="https://cdn.datatables.net/2.0.3/js/dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/2.0.3/js/dataTables.bootstrap5.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="https://cdn.jsdelivr.net/npm/gasparesganga-jquery-loading-overlay@2.1.7/dist/loadingoverlay.min.js"></script>
    <script src="https://code.jquery.com/ui/1.14.0/jquery-ui.min.js"></script>

    <script>
        // Textos traducidos que consume el JavaScript de esta vista.
        //
        // Se AMPLÍA window.T (ya declarado en el layout) en lugar de declarar un
        // "const T" propio: comparten ámbito global y una segunda declaración
        // const lanza SyntaxError que tumba este bloque <script> entero.
        window.T = Object.assign(window.T || {}, {
            eliminarMatrimonio: @Json.Serialize(L["¿Desea eliminar el matrimonio \"{0}\"?"].Value),
            eliminado:   @Json.Serialize(L["Eliminado"].Value),
            error:       @Json.Serialize(L["Error"].Value),
            estasSeguro: @Json.Serialize(L["¿Estás seguro?"].Value),
            guardado:    @Json.Serialize(L["Guardado"].Value),
            no:          @Json.Serialize(L["No"].Value),
            si:          @Json.Serialize(L["Sí"].Value),
            conyugesObligatorios: @Json.Serialize(L["Debes seleccionar al esposo y a la esposa."].Value),
            sinSeguidor: @Json.Serialize(L["— Sin seguidor —"].Value)
        });

        let tablaMatrimonios;
        let filaSeleccionada;
        let listaMatrimonios = [];

        // Nombre con el que se identifica una pareja en los listados, en el selector
        // de seguidor y en los avisos. Se compone al mostrar y no se guarda en la
        // base de datos, para que no haya dos versiones del mismo texto.
        function nombrePareja(esposo, esposa) {
            return [esposo, esposa].filter(n => n).join(" y ");
        }

        // Alta del buscador de miembros sobre un input del modal. Guarda el nombre
        // completo tal cual, que es lo que viaja a las columnas Esposo y Esposa.
        function activarBuscadorMiembro(selectorInput) {
            $(selectorInput).autocomplete({
                appendTo: "#FormModalMatrimonios .modal-body",
                source: function (req, resp) {
                    $.get('@Url.Action("BuscarMiembros", "Congregantes")', { term: req.term }, function (res) {
                        resp((res.data || []).map(function (m) {
                            const nombre = ((m.nombre_miembro || '') + ' ' + (m.apellidos_miembro || '')).trim();
                            return { label: nombre, value: nombre };
                        }));
                    });
                },
                minLength: 2
            });
        }

        $(document).ready(function () {
            activarBuscadorMiembro("#txtEsposoMatrimonio");
            activarBuscadorMiembro("#txtEsposaMatrimonio");

            tablaMatrimonios = $("#tablaMatrimonios").DataTable({
                responsive: true,
                ordering: false,
                ajax: {
                    url: '@Url.Action("ListarMatrimonios", "Congregantes")',
                    type: "GET",
                    dataType: "json",
                    dataSrc: function (json) {
                        listaMatrimonios = json.data || [];
                        return listaMatrimonios;
                    }
                },
                columns: [
                    { data: "esposo", defaultContent: "" },
                    { data: "esposa", defaultContent: "" },
                    {
                        data: "lideres",
                        render: function (data) {
                            return data === "Si"
                                ? '<span class="badge bg-success">' + T.si + '</span>'
                                : '<span class="badge bg-secondary">No</span>';
                        }
                    },
                    {
                        data: null,
                        render: function (data, type, row) {
                            const nombre = nombrePareja(row.esposo_seguidor, row.esposa_seguidor);
                            return nombre || '<span class="text-muted">—</span>';
                        }
                    },
                    {
                        defaultContent: `
                            <div class="d-flex justify-content-center gap-2">
                                <button data-permiso="MatrimoniosCrearEditar" type="button" class="btn btn-primary btn-sm btn-editarMatrimonio">
                                    <i class="fas fa-pen"></i>
                                </button>
                                <button data-permiso="MatrimoniosEliminar" type="button" class="btn btn-danger btn-sm btn-eliminarMatrimonio">
                                    <i class="fas fa-trash"></i>
                                </button>
                            </div>`,
                        orderable: false,
                        searchable: false,
                        width: "100px"
                    }
                ],
                language: window.dtLang ? { url: window.dtLang } : {},
                initComplete: function () {
                    $('#tablaMatrimonios thead').css({
                        'background-color': '#1E3A8A',
                        'color': 'white',
                        'text-align': 'center'
                    });
                }
            });

            $("#tablaMatrimonios tbody").on("click", ".btn-editarMatrimonio", function () {
                filaSeleccionada = $(this).closest("tr");
                const data = tablaMatrimonios.row(filaSeleccionada).data();
                abrirModalMatrimonios(data);
            });

            $("#tablaMatrimonios tbody").on("click", ".btn-eliminarMatrimonio", function () {
                const fila = $(this).closest("tr");
                const data = tablaMatrimonios.row(fila).data();

                Swal.fire({
                    title: T.estasSeguro,
                    text: fmt(T.eliminarMatrimonio, nombrePareja(data.esposo, data.esposa)),
                    icon: "warning",
                    showCancelButton: true,
                    confirmButtonText: T.si,
                    cancelButtonText: T.no
                }).then(result => {
                    if (result.isConfirmed) {
                        $.ajax({
                            url: '@Url.Action("EliminarMatrimonio", "Congregantes")',
                            type: "POST",
                            data: { id: data.iD_matrimonio },
                            success: function (res) {
                                if (res.resultado) {
                                    tablaMatrimonios.ajax.reload();
                                    Swal.fire(T.eliminado, res.mensaje, "success");
                                } else {
                                    Swal.fire(T.error, res.mensaje, "error");
                                }
                            },
                            error: function () {
                                Swal.fire(T.error, T.mNoEliminarPunto, "error");
                            }
                        });
                    }
                });
            });
        });

        function poblarSelectSeguidor(idExcluir) {
            const select = $("#cboSeguidor");
            select.empty().append($("<option>").val("").text(T.sinSeguidor));
            listaMatrimonios.forEach(function (m) {
                if (m.iD_matrimonio !== idExcluir) {
                    select.append($("<option>").val(m.iD_matrimonio).text(nombrePareja(m.esposo, m.esposa)));
                }
            });
        }

        function abrirModalMatrimonios(json = null) {
            $("#mensajeErrorMatrimonio").addClass("d-none").text("");

            if (json) {
                $("#txtIdMatrimonio").val(json.iD_matrimonio);
                $("#txtEsposoMatrimonio").val(json.esposo || "");
                $("#txtEsposaMatrimonio").val(json.esposa || "");
                $("#cboLideres").val(json.lideres || "No");
                poblarSelectSeguidor(json.iD_matrimonio);
                $("#cboSeguidor").val(json.iD_pareja_seguidor || "");
                $("#tituloModalMatrimonios").text("Editar matrimonio: " + nombrePareja(json.esposo, json.esposa));
            } else {
                $("#txtIdMatrimonio").val(0);
                $("#txtEsposoMatrimonio").val("");
                $("#txtEsposaMatrimonio").val("");
                $("#cboLideres").val("No");
                poblarSelectSeguidor(0);
                $("#cboSeguidor").val("");
                $("#tituloModalMatrimonios").text("Nuevo matrimonio");
            }

            const modal = new bootstrap.Modal(document.getElementById("FormModalMatrimonios"));
            modal.show();
        }

        function guardarMatrimonio() {
            const obj = {
                iD_matrimonio: parseInt($("#txtIdMatrimonio").val()) || 0,
                esposo: $("#txtEsposoMatrimonio").val().trim(),
                esposa: $("#txtEsposaMatrimonio").val().trim(),
                lideres: $("#cboLideres").val(),
                iD_pareja_seguidor: parseInt($("#cboSeguidor").val()) || null
            };

            if (!obj.esposo || !obj.esposa) {
                $("#mensajeErrorMatrimonio").removeClass("d-none").text(T.conyugesObligatorios);
                return;
            }

            $(".modal-body").LoadingOverlay("show", { text: "Guardando..." });

            $.ajax({
                url: '@Url.Action("GuardarMatrimonio", "Congregantes")',
                type: "POST",
                data: JSON.stringify(obj),
                contentType: "application/json",
                dataType: "json",
                success: function (res) {
                    $(".modal-body").LoadingOverlay("hide");

                    if (res.resultado !== 0 && res.resultado !== false) {
                        bootstrap.Modal.getInstance(document.getElementById("FormModalMatrimonios")).hide();
                        tablaMatrimonios.ajax.reload();
                        Swal.fire(T.guardado, res.mensaje, "success");
                    } else {
                        $("#mensajeErrorMatrimonio").removeClass("d-none").text(res.mensaje);
                    }
                },
                error: function () {
                    $(".modal-body").LoadingOverlay("hide");
                    $("#mensajeErrorMatrimonio").removeClass("d-none").text(T.mErrorSolicitud);
                }
            });
        }
    </script>
}
