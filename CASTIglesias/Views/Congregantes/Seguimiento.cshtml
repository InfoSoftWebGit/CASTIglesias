@{
    ViewBag.Title = L["Seguimiento"].Value;
    Layout = "~/Views/Shared/_Layout.cshtml";

    var loggedInSedeID = ViewBag.sedeID ?? 0;
    var loggedInSedeNombre = ViewBag.nombre_sede?.ToString() ?? "Sede Desconocida";
}
<link href="https://cdn.datatables.net/1.13.6/css/dataTables.bootstrap5.min.css" rel="stylesheet" />
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">

<style>
    .autocomplete-dropdown {
        position: absolute;
        z-index: 1055;
        width: 100%;
        max-height: 220px;
        overflow-y: auto;
        border: 1px solid #dee2e6;
        border-radius: 0 0 .375rem .375rem;
        background: #fff;
        box-shadow: 0 4px 12px rgba(0,0,0,.1);
    }
    .autocomplete-wrapper { position: relative; }
    .col-obs {
        max-width: min(160px, 30vw);
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }
    .badge-visita     { background-color: #0d6efd; }
    .badge-llamada    { background-color: #198754; }
    .badge-consejeria { background-color: #fd7e14; }
</style>

<ol class="breadcrumb mb-4 mt-4">
    <li class="breadcrumb-item"><a href="#">@L["Resumen"]</a></li>
    <li class="breadcrumb-item active">@L["Seguimiento de congregantes"]</li>
</ol>

<div class="card">
    <div class="card-header">
        <i class="fas fa-clipboard-list me-1"></i> @L["Seguimiento de congregantes"]
    </div>

    <div class="table-responsive p-3">
        <div class="row mb-2">
            <div class="col-12">
                <button data-permiso="MiembrosCrearEditar" type="button" class="btn btn-success" onclick="abrirModal(null)">
                    <i class="fas fa-plus me-1"></i> @L["Nuevo seguimiento"]
                </button>
            </div>
        </div>
        <hr />
        <table id="tablaSeguimiento" class="table table-bordered table-striped border-top" style="width:100%">
            <thead>
                <tr>
                    <th>@L["Miembro"]</th>
                    <th>@L["Tipo"]</th>
                    <th>@L["Fecha"]</th>
                    <th>@L["Persona a cargo"]</th>
                    <th>@L["Observaciones"]</th>
                    <th></th>
                </tr>
            </thead>
            <tbody></tbody>
        </table>
    </div>
</div>

<!-- MODAL SEGUIMIENTO -->
<div class="modal fade" id="modalSeguimiento" tabindex="-1" aria-hidden="true" data-bs-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header text-white" style="background-color: #1E3A8A;">
                <h5 class="modal-title" id="modalTitulo">@L["Nuevo seguimiento"]</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="@L["Cerrar"]"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="hiddenID" value="0" />
                <input type="hidden" id="hiddenIdMiembro" value="0" />
                <input type="hidden" id="hiddenIdPersonaCargo" value="0" />

                <h6 class="mb-3">@L["Información del miembro"]</h6>
                <div class="row g-3">
                    <div class="col-sm-6">
                        <label class="form-label">@L["Nombre del miembro"] <span class="text-danger">*</span></label>
                        <div class="autocomplete-wrapper">
                            <input type="text" class="form-control" id="txtNombreMiembro"
                                   autocomplete="off" placeholder="@L["Buscar por nombre..."]">
                            <div id="dropdownNombreMiembro" class="autocomplete-dropdown list-group" style="display:none;"></div>
                        </div>
                    </div>
                    <div class="col-sm-6">
                        <label class="form-label">@L["Apellidos del miembro"]</label>
                        <input type="text" class="form-control" id="txtApellidosMiembro"
                               autocomplete="off" placeholder="@L["Se rellena al seleccionar..."]" readonly>
                    </div>
                </div>

                <hr />
                <h6 class="mb-3">@L["Datos del seguimiento"]</h6>
                <div class="row g-3">
                    <div class="col-sm-6">
                        <label class="form-label">@L["Tipo de seguimiento"] <span class="text-danger">*</span></label>
                        <select class="form-select" id="selectTipoSeguimiento">
                            <option value="">@L["-- Selecciona un tipo --"]</option>
                            <option value="Llamada">@L["Llamada"]</option>
                            <option value="Consejeria">@L["Consejería"]</option>
                            <option value="Visita">@L["Visita"]</option>
                        </select>
                    </div>

                    <div class="col-sm-6">
                        <label class="form-label">@L["Fecha del seguimiento"] <span class="text-danger">*</span></label>
                        <input type="date" class="form-control" id="txtFechaSeguimiento">
                    </div>

                    <div class="col-sm-6">
                        <label class="form-label">@L["Persona a cargo"] <span class="text-danger">*</span></label>
                        <div class="autocomplete-wrapper">
                            <input type="text" class="form-control" id="txtPersonaCargo"
                                   autocomplete="off" placeholder="@L["Buscar líder..."]">
                            <div id="dropdownPersonaCargo" class="autocomplete-dropdown list-group" style="display:none;"></div>
                        </div>
                    </div>

                    <div class="col-12">
                        <label class="form-label">@L["Observaciones"]</label>
                        <textarea class="form-control" id="txtObservaciones" rows="3"
                                  maxlength="255" placeholder="@L["Máx. 255 caracteres..."]"></textarea>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">@L["Cancelar"]</button>
                <button type="button" class="btn btn-primary" onclick="guardarSeguimiento()">
                    <i class="fas fa-save me-1"></i> @L["Guardar"]
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
<script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap5.min.js"></script>

<script>
    var tablaSeguimiento;

    $(document).ready(function () {
        tablaSeguimiento = $('#tablaSeguimiento').DataTable({
            ajax: {
                url: '@Url.Action("ListarSeguimientos", "Congregantes")',
                type: 'GET',
                dataSrc: 'data'
            },
            columns: [
                {
                    data: null,
                    render: function (data) {
                        return (data.nombre_miembro || '') + ' ' + (data.apellidos_miembro || '');
                    }
                },
                {
                    data: 'tipo_seguimiento',
                    render: function (val) {
                        var cls   = val === 'Visita'    ? 'badge-visita'
                                  : val === 'Llamada'   ? 'badge-llamada'
                                  : 'badge-consejeria';
                        var label = val === 'Consejeria' ? 'Consejería' : (val || '');
                        return '<span class="badge ' + cls + '">' + label + '</span>';
                    }
                },
                {
                    data: 'fecha_seguimiento',
                    render: function (val) { return val ? val.substring(0, 10) : '—'; }
                },
                { data: 'persona_cargo', defaultContent: '' },
                {
                    data: 'observaciones',
                    defaultContent: '',
                    createdCell: function (td) { $(td).addClass('col-obs'); },
                    render: function (val) {
                        if (!val) return '';
                        return '<span title="' + val.replace(/"/g, '&quot;') + '">' + val + '</span>';
                    }
                },
                {
                    data: null,
                    orderable: false,
                    render: function (data) {
                        return '<button data-permiso="MiembrosCrearEditar" class="btn btn-sm btn-warning me-1" onclick=\'abrirModal(' + JSON.stringify(data) + ')\'>' +
                               '<i class="fas fa-edit"></i></button>' +
                               '<button data-permiso="MiembrosEliminar" class="btn btn-sm btn-danger" onclick="eliminarSeguimiento(' + data.id + ')">' +
                               '<i class="fas fa-trash"></i></button>';
                    }
                }
            ],
            language: window.dtLang ? { url: window.dtLang } : {},
            responsive: true
        });
    });

    // ─── MODAL ABRIR ──────────────────────────────────────────────
    function abrirModal(data) {
        limpiarModal();
        if (data) {
            $('#modalTitulo').text('Editar seguimiento');
            $('#hiddenID').val(data.id);
            $('#hiddenIdMiembro').val(data.iD_miembro);
            $('#txtNombreMiembro').val(data.nombre_miembro || '');
            $('#txtApellidosMiembro').val(data.apellidos_miembro || '');
            $('#selectTipoSeguimiento').val(data.tipo_seguimiento || '');
            if (data.fecha_seguimiento) $('#txtFechaSeguimiento').val(data.fecha_seguimiento.substring(0, 10));
            $('#txtPersonaCargo').val(data.persona_cargo || '');
            $('#hiddenIdPersonaCargo').val(-1); // cargado desde BD, válido
            $('#txtObservaciones').val(data.observaciones || '');
        } else {
            $('#modalTitulo').text('Nuevo seguimiento');
        }
        $('#modalSeguimiento').modal('show');
    }

    function limpiarModal() {
        $('#hiddenID').val(0);
        $('#hiddenIdMiembro').val(0);
        $('#txtNombreMiembro').val('');
        $('#txtApellidosMiembro').val('');
        $('#selectTipoSeguimiento').val('');
        $('#txtFechaSeguimiento').val('');
        $('#txtPersonaCargo').val('');
        $('#hiddenIdPersonaCargo').val(0);
        $('#txtObservaciones').val('');
        $('#dropdownNombreMiembro').hide().empty();
        $('#dropdownPersonaCargo').hide().empty();
    }

    // ─── GUARDAR ──────────────────────────────────────────────────
    function guardarSeguimiento() {
        var idMiembro = parseInt($('#hiddenIdMiembro').val());
        var nombre = $('#txtNombreMiembro').val().trim();
        var apellidos = $('#txtApellidosMiembro').val().trim();
        var tipo = $('#selectTipoSeguimiento').val();
        var fecha = $('#txtFechaSeguimiento').val();
        var personaCargo = $('#txtPersonaCargo').val().trim();

        if (idMiembro <= 0 || nombre === '') {
            Swal.fire(T.mAtencion, T.mDebesSeleccionarMiembro, 'warning');
            return;
        }
        if (!tipo) {
            Swal.fire(T.mAtencion, T.mTipoSeguimientoObligatorio, 'warning');
            return;
        }
        if (!fecha) {
            Swal.fire(T.mAtencion, T.mFechaSeguimientoObligatoria, 'warning');
            return;
        }
        if (personaCargo === '') {
            Swal.fire(T.mAtencion, T.mPersonaCargoObligatoria, 'warning');
            return;
        }
        if (parseInt($('#hiddenIdPersonaCargo').val()) === 0) {
            Swal.fire(T.mAtencion, T.mPersonaCargoLista, 'warning');
            $('#txtPersonaCargo').focus();
            return;
        }

        var esEdicion = parseInt($('#hiddenID').val()) > 0;
        Swal.fire({
            title: T.mConfirmar,
            text: esEdicion ? T.mDeseasGuardarCambios : T.mDeseasRegistrarSeguimiento,
            icon: 'question',
            showCancelButton: true,
            confirmButtonText: T.mSiGuardar,
            cancelButtonText: 'Cancelar'
        }).then(function (result) {
            if (!result.isConfirmed) return;

            var payload = {
                ID: parseInt($('#hiddenID').val()),
                ID_miembro: idMiembro,
                Nombre_miembro: nombre,
                Apellidos_miembro: apellidos,
                Tipo_seguimiento: tipo,
                Fecha_seguimiento: fecha,
                Persona_cargo: personaCargo,
                Observaciones: $('#txtObservaciones').val().trim() || null
            };

            $.ajax({
                url: '@Url.Action("RegistrarSeguimiento", "Congregantes")',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(payload),
                success: function (res) {
                    if (res.resultado && res.resultado !== 0 && res.resultado !== false) {
                        Swal.fire(T.mExito, res.mensaje, 'success');
                        $('#modalSeguimiento').modal('hide');
                        tablaSeguimiento.ajax.reload();
                    } else {
                        Swal.fire('Error', res.mensaje || T.mNoGuardar, 'error');
                    }
                },
                error: function () {
                    Swal.fire('Error', T.mErrorConexionPunto, 'error');
                }
            });
        });
    }

    // ─── ELIMINAR ─────────────────────────────────────────────────
    function eliminarSeguimiento(id) {
        Swal.fire({
            title: T.mEstasSeguro,
            text: T.mDeseasEliminarSeguimiento,
            icon: 'warning',
            showCancelButton: true,
            confirmButtonText: T.mSiEliminar,
            cancelButtonText: 'Cancelar',
            confirmButtonColor: '#d33'
        }).then(function (result) {
            if (!result.isConfirmed) return;
            $.ajax({
                url: '@Url.Action("EliminarSeguimiento", "Congregantes")',
                type: 'POST',
                data: { id: id },
                success: function (res) {
                    if (res.resultado) {
                        Swal.fire('Eliminado', res.mensaje, 'success');
                        tablaSeguimiento.ajax.reload();
                    } else {
                        Swal.fire('Error', res.mensaje, 'error');
                    }
                },
                error: function () {
                    Swal.fire('Error', T.mErrorConexionPunto, 'error');
                }
            });
        });
    }

    // ─── AUTOCOMPLETE: NOMBRE DEL MIEMBRO ─────────────────────────
    var timerMiembro;
    $('#txtNombreMiembro').on('input', function () {
        var term = $(this).val().trim();
        $('#hiddenIdMiembro').val(0);
        $('#txtApellidosMiembro').val('');
        clearTimeout(timerMiembro);
        if (term.length < 2) { $('#dropdownNombreMiembro').hide().empty(); return; }
        timerMiembro = setTimeout(function () {
            $.ajax({
                url: '@Url.Action("BuscarMiembros", "Congregantes")',
                type: 'GET',
                data: { term: term },
                success: function (res) {
                    var dd = $('#dropdownNombreMiembro');
                    dd.empty();
                    if (res.data && res.data.length > 0) {
                        res.data.forEach(function (m) {
                            var nombreCompleto = ((m.nombre_miembro || '') + ' ' + (m.apellidos_miembro || '')).trim();
                            $('<button type="button">')
                                .addClass('list-group-item list-group-item-action')
                                .text(nombreCompleto)
                                .on('click', function () {
                                    $('#hiddenIdMiembro').val(m.id_miembro);
                                    $('#txtNombreMiembro').val(m.nombre_miembro || '');
                                    $('#txtApellidosMiembro').val(m.apellidos_miembro || '');
                                    dd.hide().empty();
                                })
                                .appendTo(dd);
                        });
                        dd.show();
                    } else {
                        dd.hide();
                    }
                }
            });
        }, 300);
    });

    // ─── AUTOCOMPLETE: PERSONA A CARGO (solo líderes) ─────────────
    var timerLider;
    $('#txtPersonaCargo').on('input', function () {
        var term = $(this).val().trim();
        $('#hiddenIdPersonaCargo').val(0); // invalidar selección previa si el usuario escribe
        clearTimeout(timerLider);
        if (term.length < 2) { $('#dropdownPersonaCargo').hide().empty(); return; }
        timerLider = setTimeout(function () {
            $.ajax({
                url: '@Url.Action("BuscarLideres", "Congregantes")',
                type: 'GET',
                data: { term: term },
                success: function (res) {
                    var dd = $('#dropdownPersonaCargo');
                    dd.empty();
                    if (res.data && res.data.length > 0) {
                        res.data.forEach(function (m) {
                            var nombreCompleto = ((m.nombre || '') + ' ' + (m.apellidos || '')).trim();
                            $('<button type="button">')
                                .addClass('list-group-item list-group-item-action')
                                .text(nombreCompleto)
                                .on('click', function () {
                                    $('#txtPersonaCargo').val(nombreCompleto);
                                    $('#hiddenIdPersonaCargo').val(m.id);
                                    dd.hide().empty();
                                })
                                .appendTo(dd);
                        });
                        dd.show();
                    } else {
                        dd.hide();
                    }
                }
            });
        }, 300);
    });

    // Cerrar dropdowns al hacer clic fuera
    $(document).on('click', function (e) {
        if (!$(e.target).closest('.autocomplete-wrapper').length) {
            $('.autocomplete-dropdown').hide().empty();
        }
    });
</script>
}
