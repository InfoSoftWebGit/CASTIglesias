@*
    Informe de encargados y personas a cargo.

    Lo comparten las pantallas de Seguimiento, Líderes y Detalle de seguimiento:
    quien revisa que el seguimiento se esté haciendo y quien lo hace necesitan ver
    el mismo reparto, y poder llevárselo en un fichero.

    Este listado NO se pagina ni se recorta (al contrario que los listados de
    congregantes): sale el reparto completo, con todos los encargados, incluidos
    los que todavía no tienen a nadie asignado.

    Los matrimonios salen en un solo bloque, y lo mismo las personas a cargo que
    son pareja; el emparejamiento lo hace el servidor comparando con la tabla
    matrimonios (ver CN_Lideres.ListarEncargadosAgrupados).

    Se incluye DENTRO de @@section scripts, porque usa jQuery y ExportarTabla, que
    el layout carga al final de la página. La vista solo tiene que poner un botón
    con id="btnVerEncargados".
*@
<div class="modal fade" id="modalEncargados" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header text-white" style="background-color:#1E3A8A;">
                <h5 class="modal-title">
                    <i class="fas fa-user-shield me-1"></i> @L["Encargados y personas a cargo"]
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="@L["Cerrar"]"></button>
            </div>
            <div class="modal-body">
                <p class="text-muted small" id="resumenEncargados"></p>
                <div id="listaEncargados"></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">@L["Cerrar"]</button>
                <button type="button" class="btn btn-outline-primary" id="btnImprimirEncargados">
                    <i class="fas fa-file-pdf me-1"></i> @L["Imprimir o guardar en PDF"]
                </button>
                @* La descarga a Excel la monta el servidor con el listado completo
                   (Congregantes/ExportarEncargadosExcel): una fila por persona, para
                   poder filtrarlo y ordenarlo en la hoja de cálculo. *@
                <a class="btn btn-success" id="btnExcelEncargados"
                   href="@Url.Action("ExportarEncargadosExcel", "Congregantes")">
                    <i class="fas fa-file-excel me-1"></i> @L["Descargar Excel"]
                </a>
            </div>
        </div>
    </div>
</div>

<script>
    // Último reparto cargado. Se guarda para imprimirlo sin volver a pedirlo.
    var encargadosCargados = [];

    function escaparTextoEncargados(valor) {
        return $('<div>').text(valor == null ? '' : valor).html();
    }

    // Zona, grupo y ministerio de un encargado, ya unidos para mostrarlos como
    // subtítulo. En un bloque de pareja el servidor ya los ha unido con " / ".
    function contextoEncargado(encargado) {
        return [encargado.nombre_zona, encargado.descripcion_grupo, encargado.descripcion_ministerio]
            .filter(function (v) { return v; })
            .join(' · ');
    }

    // LoadingOverlay lo carga cada vista por su cuenta, no el layout: aquí se usa
    // solo si está disponible, para que el parcial valga en las tres pantallas.
    function esperaEncargados(mostrar) {
        if ($.LoadingOverlay) $.LoadingOverlay(mostrar ? 'show' : 'hide');
    }

    $(document).on('click', '#btnVerEncargados', function () {
        esperaEncargados(true);
        $.get('@Url.Action("ListarEncargados", "Congregantes")', function (res) {
            esperaEncargados(false);
            encargadosCargados = (res && res.data) ? res.data : [];
            pintarEncargados();
            new bootstrap.Modal(document.getElementById('modalEncargados')).show();
        }).fail(function () {
            esperaEncargados(false);
            Swal.fire(T.error, T.xNoCargarEncargados, 'error');
        });
    });

    function pintarEncargados() {
        var contenedor = $('#listaEncargados').empty();

        if (encargadosCargados.length === 0) {
            $('#resumenEncargados').text('');
            contenedor.append('<div class="alert alert-warning mb-0">' +
                escaparTextoEncargados(T.xSinEncargados) + '</div>');
            return;
        }

        var totalPersonas = encargadosCargados.reduce(function (suma, e) { return suma + e.total_personas; }, 0);
        $('#resumenEncargados').text(
            encargadosCargados.length + ' · ' + fmt(T.xTotalACargo, totalPersonas));

        encargadosCargados.forEach(function (encargado) {
            var contexto = contextoEncargado(encargado);
            // Los encargados sin nadie asignado se marcan en ámbar: es el hueco
            // que busca quien revisa el reparto.
            var sinNadie = encargado.personas.length === 0;

            var html = '<div class="card mb-2">' +
                '<div class="card-header d-flex justify-content-between align-items-center' +
                    (sinNadie ? ' bg-warning-subtle' : '') + '">' +
                  '<span>' +
                    (encargado.es_pareja ? '<i class="fas fa-ring me-1 text-secondary"></i>' : '') +
                    '<strong>' + escaparTextoEncargados(encargado.titulo) + '</strong>' +
                    (contexto ? ' <small class="text-muted">' + escaparTextoEncargados(contexto) + '</small>' : '') +
                  '</span>' +
                  '<span class="badge ' + (sinNadie ? 'bg-warning text-dark' : 'bg-primary') + '">' +
                    escaparTextoEncargados(fmt(T.xTotalACargo, encargado.total_personas)) +
                  '</span>' +
                '</div>';

            if (sinNadie) {
                html += '<div class="card-body py-2 text-muted fst-italic">' +
                    escaparTextoEncargados(T.xSinPersonasACargo) + '</div>';
            } else {
                html += '<div class="table-responsive"><table class="table table-sm mb-0">' +
                    '<thead><tr>' +
                      '<th>' + escaparTextoEncargados(T.xPersonasACargo) + '</th>' +
                      '<th>' + escaparTextoEncargados(@Json.Serialize(L["Estado"].Value)) + '</th>' +
                      '<th>' + escaparTextoEncargados(@Json.Serialize(L["Teléfono"].Value)) + '</th>' +
                      '<th>' + escaparTextoEncargados(@Json.Serialize(L["Correo electrónico"].Value)) + '</th>' +
                    '</tr></thead><tbody>';

                encargado.personas.forEach(function (persona) {
                    html += '<tr>' +
                        '<td>' + (persona.es_pareja ? '<i class="fas fa-ring me-1 text-secondary"></i>' : '') +
                            escaparTextoEncargados(persona.titulo) + '</td>' +
                        '<td>' + escaparTextoEncargados(window.tDato(persona.estado)) + '</td>' +
                        '<td>' + escaparTextoEncargados(persona.telefono_movil || '—') + '</td>' +
                        '<td>' + escaparTextoEncargados(persona.correo_electronico || '—') + '</td>' +
                    '</tr>';
                });

                html += '</tbody></table></div>';
            }

            contenedor.append(html + '</div>');
        });
    }

    // PDF: se imprime desde el navegador (no hay librería de PDF en el proyecto).
    // El documento va agrupado por encargado, que es como se reparte en papel,
    // mientras que el Excel va plano para poder filtrarlo.
    $(document).on('click', '#btnImprimirEncargados', function () {
        if (encargadosCargados.length === 0) {
            Swal.fire(T.mAtencion, T.xSinEncargados, 'info');
            return;
        }

        var cuerpo = '';
        encargadosCargados.forEach(function (encargado) {
            var contexto = contextoEncargado(encargado);
            cuerpo += '<h2>' + escaparTextoEncargados(encargado.titulo) +
                ' (' + escaparTextoEncargados(fmt(T.xTotalACargo, encargado.total_personas)) + ')' +
                (contexto ? ' — ' + escaparTextoEncargados(contexto) : '') + '</h2>';

            if (encargado.personas.length === 0) {
                cuerpo += '<p><em>' + escaparTextoEncargados(T.xSinPersonasACargo) + '</em></p>';
                return;
            }

            cuerpo += '<table><thead><tr>' +
                '<th>' + escaparTextoEncargados(T.xPersonasACargo) + '</th>' +
                '<th>' + escaparTextoEncargados(@Json.Serialize(L["Estado"].Value)) + '</th>' +
                '<th>' + escaparTextoEncargados(@Json.Serialize(L["Teléfono"].Value)) + '</th>' +
                '<th>' + escaparTextoEncargados(@Json.Serialize(L["Correo electrónico"].Value)) + '</th>' +
                '</tr></thead><tbody>';

            encargado.personas.forEach(function (persona) {
                cuerpo += '<tr>' +
                    '<td>' + escaparTextoEncargados(persona.titulo) + '</td>' +
                    '<td>' + escaparTextoEncargados(window.tDato(persona.estado)) + '</td>' +
                    '<td>' + escaparTextoEncargados(persona.telefono_movil || '') + '</td>' +
                    '<td>' + escaparTextoEncargados(persona.correo_electronico || '') + '</td>' +
                '</tr>';
            });

            cuerpo += '</tbody></table>';
        });

        ExportarTabla.imprimirHtml(T.xEncargados, $('#resumenEncargados').text(), cuerpo);
    });
</script>
