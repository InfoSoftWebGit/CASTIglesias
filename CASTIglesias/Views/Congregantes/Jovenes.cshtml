@using CapaEntidad
@{
    ViewBag.Title = L["Jóvenes"].Value;
    Layout = "~/Views/Shared/_Layout.cshtml";

    var config = ViewBag.ConfigJovenes as ConfigJovenes ?? new ConfigJovenes { edad_minima = 14, edad_maxima = 24 };
    var grupos = ViewBag.GruposJovenes as List<Grupos> ?? new List<Grupos>();
    bool zonaSinConfigurar = !config.id_zona_jovenes.HasValue;
}
<link rel="stylesheet" href="https://cdn.datatables.net/2.0.3/css/dataTables.bootstrap5.min.css" />

<ol class="breadcrumb mb-4 mt-4">
    <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">@L["Información"]</a></li>
    <li class="breadcrumb-item active">@L["Jóvenes"]</li>
</ol>

@if (zonaSinConfigurar)
{
    <div class="alert alert-warning d-flex align-items-center mb-4">
        <i class="fas fa-exclamation-triangle me-2"></i>
        <span>@L["No hay una zona de jóvenes configurada. Ve a"] <a href="@Url.Action("Jovenes", "Ajustes")"><strong>@L["Ajustes → Jóvenes"]</strong></a> @L["para configurar el rango de edad y la zona."]</span>
    </div>
}

<div class="card mb-4">
    <div class="card-header d-flex justify-content-between align-items-center">
        <span><i class="fas fa-user-friends me-1"></i> @L["Lista de Jóvenes &nbsp;"]<span class="badge bg-secondary">Rango: @config.edad_minima – @config.edad_maxima años</span>
        </span>
        @if (!zonaSinConfigurar)
        {
            <button type="button" class="btn btn-success btn-sm" onclick="abrirModalJoven()">
                <i class="fas fa-plus me-1"></i> @L["Añadir joven"]
            </button>
        }
    </div>
    <div class="table-responsive">
        <table id="tablaJovenes" class="table table-bordered table-striped border-top" style="width:100%">
            <thead>
                <tr>
                    <th>@L["Nombre"]</th>
                    <th>@L["Apellidos"]</th>
                    <th>@L["Teléfono"]</th>
                    <th>@L["Edad"]</th>
                    <th>@L["Grupo"]</th>
                    <th>@L["Acciones"]</th>
                </tr>
            </thead>
            <tbody></tbody>
        </table>
    </div>
</div>

<!-- Tabla de próximos a salir -->
<div class="card">
    <div class="card-header text-warning" style="background-color:#1E3A8A;">
        <i class="fas fa-hourglass-end me-1"></i>
        @L["Próximos a salir del rango"]
        <span class="badge bg-warning text-dark ms-2">Edad entre @(config.edad_maxima - 1) y @config.edad_maxima años</span>
    </div>
    <div class="table-responsive">
        <table id="tablaProximos" class="table table-bordered table-striped border-top" style="width:100%">
            <thead>
                <tr>
                    <th>@L["Nombre"]</th>
                    <th>@L["Apellidos"]</th>
                    <th>@L["Teléfono"]</th>
                    <th>@L["Edad"]</th>
                    <th>@L["Grupo"]</th>
                </tr>
            </thead>
            <tbody></tbody>
        </table>
    </div>
</div>

<!-- MODAL CAMBIAR GRUPO -->
<div class="modal fade" id="FormModalEditarGrupo" tabindex="-1" aria-hidden="true" data-bs-backdrop="static">
    <div class="modal-dialog modal-sm">
        <div class="modal-content">
            <div class="modal-header text-white" style="background-color: #1E3A8A;">
                <h5 class="modal-title"><i class="fas fa-users-cog me-1"></i> @L["Cambiar grupo"]</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="@L["Cerrar"]"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="hdnIdZgm" value="0" />
                <div class="mb-3">
                    <label class="form-label">@L["Joven"]</label>
                    <input type="text" id="txtNombreJovenEditar" class="form-control" readonly />
                </div>
                <div class="mb-3">
                    <label class="form-label">@L["Grupo"]</label>
                    <select id="cboGrupoEditar" class="form-select">
                        <option value="0">@L["— Sin grupo —"]</option>
                        @foreach (var g in grupos)
                        {
                            <option value="@g.ID_grupo">@g.Descripcion</option>
                        }
                    </select>
                </div>
                <div id="mensajeErrorEditar" class="alert alert-danger d-none"></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">@L["Cerrar"]</button>
                <button type="button" class="btn btn-primary" onclick="guardarCambioGrupo()">
                    <i class="fas fa-save me-1"></i> @L["Guardar"]
                </button>
            </div>
        </div>
    </div>
</div>

<!-- MODAL AÑADIR JOVEN -->
<div class="modal fade" id="FormModalJoven" tabindex="-1" aria-hidden="true" data-bs-backdrop="static">
    <div class="modal-dialog modal-md">
        <div class="modal-content">
            <div class="modal-header text-white" style="background-color: #1E3A8A;">
                <h5 class="modal-title">@L["Añadir joven"]</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="@L["Cerrar"]"></button>
            </div>
            <div class="modal-body">
                <div class="row g-3">
                    <div class="col-12">
                        <label class="form-label">@L["Buscar miembro"] <span class="text-danger">*</span></label>
                        <input type="text" id="txtBuscarJoven" class="form-control" placeholder="@L["Escribe el nombre…"]" autocomplete="off" />
                        <input type="hidden" id="hdnIdMiembroJoven" value="0" />
                    </div>
                    <div class="col-sm-4">
                        <label class="form-label">@L["Edad"]</label>
                        <input type="text" id="txtEdadJoven" class="form-control" readonly />
                    </div>
                    <div class="col-sm-8">
                        <label class="form-label">@L["Teléfono"]</label>
                        <input type="text" id="txtTelefonoJoven" class="form-control" readonly />
                    </div>
                    <div id="alertaEdadJoven" class="col-12 d-none">
                        <div class="alert alert-warning mb-0 py-2">
                            <i class="fas fa-exclamation-triangle me-1"></i>
                            <span id="textoAlertaEdad"></span>
                        </div>
                    </div>
                    <div class="col-12">
                        <label class="form-label">@L["Grupo"]</label>
                        <select id="cboGrupoJoven" class="form-select">
                            <option value="0">@L["— Sin grupo —"]</option>
                            @foreach (var g in grupos)
                            {
                                <option value="@g.ID_grupo">@g.Descripcion</option>
                            }
                        </select>
                    </div>
                </div>
                <div class="row mt-3">
                    <div class="col-12">
                        <div id="mensajeErrorJoven" class="alert alert-danger d-none"></div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">@L["Cerrar"]</button>
                <button type="button" class="btn btn-primary" id="btnGuardarJoven" onclick="guardarJoven()">@L["Guardar"]</button>
            </div>
        </div>
    </div>
</div>

@section scripts {
    <script src="https://cdn.datatables.net/2.0.3/js/dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/2.0.3/js/dataTables.bootstrap5.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="https://cdn.jsdelivr.net/npm/gasparesganga-jquery-loading-overlay@2.1.7/dist/loadingoverlay.min.js"></script>
    <script src="https://code.jquery.com/ui/1.14.0/jquery-ui.min.js"></script>

    <script>
        // Textos traducidos que consume el JavaScript de esta vista.
        //
        // Se AMPLÍA window.T (ya declarado en el layout) en lugar de declarar un
        // "const T" propio: comparten ámbito global y una segunda declaración
        // const lanza SyntaxError que tumba este bloque <script> entero.
        window.T = Object.assign(window.T || {}, {
            avisoRangoEdad:      @Json.Serialize(L["Este miembro tiene {0} años, fuera del rango configurado ({1}–{2}). Se pedirá confirmación al guardar."].Value),
            confirmaRangoEdad:   @Json.Serialize(L["Este miembro tiene {0} años y está fuera del rango de jóvenes ({1}–{2}). ¿Deseas añadirlo igualmente?"].Value),
            quitarDeZonaJovenes: @Json.Serialize(L["Se eliminará a \"{0}\" de la zona de jóvenes. Sus otros datos no se verán afectados."].Value),
            cancelar:         @Json.Serialize(L["Cancelar"].Value),
            eliminado:        @Json.Serialize(L["Eliminado"].Value),
            error:            @Json.Serialize(L["Error"].Value),
            guardado:         @Json.Serialize(L["Guardado"].Value),
            quitarDeJovenes:  @Json.Serialize(L["Quitar de jóvenes"].Value),
            quitarDeJovenesQ: @Json.Serialize(L["¿Quitar de jóvenes?"].Value),
            siAnadir:         @Json.Serialize(L["Sí, añadir"].Value),
            siQuitar:         @Json.Serialize(L["Sí, quitar"].Value)
        });

        const edadMinima = @config.edad_minima;
        const edadMaxima = @config.edad_maxima;
        let edadFueraRango = false;

        const dtOptions = {
            responsive: true,
            ordering: false,
            language: window.dtLang ? { url: window.dtLang } : {},
            initComplete: function () {
                $(this.api().table().header()).css({ 'background-color': '#1E3A8A', 'color': 'white', 'text-align': 'center' });
            }
        };

        const columnas = [
            { data: "nombre_miembro", defaultContent: "" },
            { data: "apellidos_miembro", defaultContent: "" },
            { data: "telefono_movil", defaultContent: '<span class="text-muted">—</span>' },
            {
                data: "edad",
                defaultContent: '<span class="text-muted">—</span>',
                render: function (d) { return d != null ? d + ' años' : '<span class="text-muted">—</span>'; }
            },
            { data: "nombre_grupo", defaultContent: '<span class="text-muted">—</span>' }
        ];

        let tablaJovenes, tablaProximos;

        $(document).ready(function () {
            tablaJovenes = $("#tablaJovenes").DataTable({
                ...dtOptions,
                ajax: {
                    url: '@Url.Action("ListarJovenes", "Congregantes")',
                    type: "GET",
                    dataType: "json",
                    dataSrc: "data"
                },
                columns: [
                    ...columnas,
                    {
                        defaultContent: `
                            <div class="d-flex justify-content-center gap-2">
                                <button type="button" class="btn btn-warning btn-sm btn-editarGrupo" title="Cambiar grupo">
                                    <i class="fas fa-users-cog"></i>
                                </button>
                                <button type="button" class="btn btn-danger btn-sm btn-eliminarJoven" title=T.quitarDeJovenes>
                                    <i class="fas fa-user-minus"></i>
                                </button>
                            </div>`,
                        orderable: false,
                        searchable: false,
                        width: "100px"
                    }
                ]
            });

            tablaProximos = $("#tablaProximos").DataTable({
                ...dtOptions,
                ajax: {
                    url: '@Url.Action("ListarJovenesProximosSalir", "Congregantes")',
                    type: "GET",
                    dataType: "json",
                    dataSrc: "data"
                },
                columns: columnas
            });

            $("#tablaJovenes tbody").on("click", ".btn-editarGrupo", function () {
                const data = tablaJovenes.row($(this).closest("tr")).data();
                abrirEditarGrupo(data);
            });

            $("#tablaJovenes tbody").on("click", ".btn-eliminarJoven", function () {
                const data = tablaJovenes.row($(this).closest("tr")).data();
                Swal.fire({
                    title: T.quitarDeJovenesQ,
                    text: fmt(T.quitarDeZonaJovenes, `${data.nombre_miembro} ${data.apellidos_miembro}`),
                    icon: "warning",
                    showCancelButton: true,
                    confirmButtonText: T.siQuitar,
                    cancelButtonText: T.cancelar
                }).then(result => {
                    if (result.isConfirmed) {
                        $.post('@Url.Action("EliminarJoven", "Congregantes")', { idZgm: data.id_zgm }, function (res) {
                            if (res.resultado) {
                                tablaJovenes.ajax.reload();
                                tablaProximos.ajax.reload();
                                Swal.fire(T.eliminado, res.mensaje, "success");
                            } else {
                                Swal.fire(T.error, res.mensaje, "error");
                            }
                        });
                    }
                });
            });

            // Autocomplete búsqueda de miembros
            $("#txtBuscarJoven").autocomplete({
                appendTo: "#FormModalJoven .modal-body",
                source: function (req, resp) {
                    $.get('@Url.Action("BuscarMiembros", "Congregantes")', { term: req.term }, function (res) {
                        const items = (res.data || []).map(function (m) {
                            return {
                                label: (m.nombre_miembro || '') + ' ' + (m.apellidos_miembro || ''),
                                value: (m.nombre_miembro || '') + ' ' + (m.apellidos_miembro || ''),
                                id: m.id_miembro,
                                edad: m.edad,
                                telefono: m.telefono_movil
                            };
                        });
                        resp(items);
                    });
                },
                minLength: 2,
                select: function (event, ui) {
                    $("#hdnIdMiembroJoven").val(ui.item.id);
                    $("#txtEdadJoven").val(ui.item.edad != null ? ui.item.edad : '');
                    $("#txtTelefonoJoven").val(ui.item.telefono || '');
                    comprobarEdad(ui.item.edad);
                }
            });
        });

        function comprobarEdad(edad) {
            const alerta = $("#alertaEdadJoven");
            if (edad == null) {
                alerta.addClass("d-none");
                edadFueraRango = false;
                return;
            }
            if (edad < edadMinima || edad > edadMaxima) {
                $("#textoAlertaEdad").text(fmt(T.avisoRangoEdad, edad, edadMinima, edadMaxima));
                alerta.removeClass("d-none");
                edadFueraRango = true;
            } else {
                alerta.addClass("d-none");
                edadFueraRango = false;
            }
        }

        function abrirModalJoven() {
            $("#hdnIdMiembroJoven").val(0);
            $("#txtBuscarJoven").val('');
            $("#txtEdadJoven").val('');
            $("#txtTelefonoJoven").val('');
            $("#alertaEdadJoven").addClass("d-none");
            $("#mensajeErrorJoven").addClass("d-none").text('');
            edadFueraRango = false;
            new bootstrap.Modal(document.getElementById("FormModalJoven")).show();
        }

        const urlCambiarGrupo = '@Url.Action("CambiarGrupoJoven", "Congregantes")';

        function abrirEditarGrupo(data) {
            $("#hdnIdZgm").val(data.id_zgm);
            $("#txtNombreJovenEditar").val((data.nombre_miembro || '') + ' ' + (data.apellidos_miembro || ''));
            $("#cboGrupoEditar").val(data.id_grupo > 0 ? data.id_grupo : 0);
            $("#mensajeErrorEditar").addClass("d-none").text('');
            new bootstrap.Modal(document.getElementById("FormModalEditarGrupo")).show();
        }

        function guardarCambioGrupo() {
            const idZgm = parseInt($("#hdnIdZgm").val()) || 0;
            const idGrupo = parseInt($("#cboGrupoEditar").val()) || 0;
            $(".modal-body").LoadingOverlay("show", { text: "Guardando..." });
            $.post(urlCambiarGrupo, { idZgm, idGrupo }, function (res) {
                $(".modal-body").LoadingOverlay("hide");
                if (res.resultado) {
                    bootstrap.Modal.getInstance(document.getElementById("FormModalEditarGrupo")).hide();
                    tablaJovenes.ajax.reload();
                    tablaProximos.ajax.reload();
                    Swal.fire({ toast: true, position: 'top-end', icon: 'success', title: res.mensaje, showConfirmButton: false, timer: 3000, timerProgressBar: true });
                } else {
                    $("#mensajeErrorEditar").removeClass("d-none").text(res.mensaje);
                }
            }).fail(function () {
                $(".modal-body").LoadingOverlay("hide");
                $("#mensajeErrorEditar").removeClass("d-none").text("Error en la solicitud.");
            });
        }

        function guardarJoven() {
            const idMiembro = parseInt($("#hdnIdMiembroJoven").val()) || 0;
            if (idMiembro === 0) {
                $("#mensajeErrorJoven").removeClass("d-none").text("Selecciona un miembro de la lista.");
                return;
            }

            const doGuardar = function () {
                const idGrupo = parseInt($("#cboGrupoJoven").val()) || 0;
                $(".modal-body").LoadingOverlay("show", { text: "Guardando..." });
                $.post('@Url.Action("AgregarJoven", "Congregantes")', { idMiembro, idGrupo }, function (res) {
                    $(".modal-body").LoadingOverlay("hide");
                    if (res.resultado && res.resultado !== 0) {
                        bootstrap.Modal.getInstance(document.getElementById("FormModalJoven")).hide();
                        tablaJovenes.ajax.reload();
                        tablaProximos.ajax.reload();
                        Swal.fire(T.guardado, res.mensaje, "success");
                    } else {
                        $("#mensajeErrorJoven").removeClass("d-none").text(res.mensaje);
                    }
                }).fail(function () {
                    $(".modal-body").LoadingOverlay("hide");
                    $("#mensajeErrorJoven").removeClass("d-none").text("Error en la solicitud.");
                });
            };

            if (edadFueraRango) {
                const edad = parseInt($("#txtEdadJoven").val());
                Swal.fire({
                    title: "Edad fuera del rango",
                    text: fmt(T.confirmaRangoEdad, edad, edadMinima, edadMaxima),
                    icon: "warning",
                    showCancelButton: true,
                    confirmButtonText: T.siAnadir,
                    cancelButtonText: T.cancelar
                }).then(result => {
                    if (result.isConfirmed) doGuardar();
                });
            } else {
                doGuardar();
            }
        }
    </script>
}
