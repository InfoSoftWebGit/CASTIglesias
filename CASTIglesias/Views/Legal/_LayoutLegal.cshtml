@* Layout de las páginas legales. Ligero y con los mismos colores que la landing.
   Incluye Google Tag Manager condicionado y el banner de cookies, para que desde
   la propia política de cookies se pueda cambiar la elección. *@
<!DOCTYPE html>
<html lang="@IdiomasSoportados.Actual">
<head>
    <partial name="_GoogleTagManager" />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — Congrega CRM</title>
    <link rel="icon" type="image/png" href="~/favicon.png" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <style>
        :root { --primary: #1E3A8A; --primary-dark: #0D1B3D; --teal: #00BFA5; --text: #1F2937; --text-light: #6B7280; --bg-light: #F0F4FF; }
        body { font-family: 'Inter', sans-serif; color: var(--text); background: #fff; margin: 0; }
        .legal-nav { background: var(--primary-dark); padding: 14px 0; }
        .legal-nav .marca { color: #fff; font-weight: 800; font-size: 1.2rem; text-decoration: none; }
        .legal-nav .marca span { color: var(--teal); }
        .lang-switch { display: inline-flex; gap: 2px; border: 1px solid rgba(255,255,255,0.2); border-radius: 8px; padding: 2px; }
        .lang-switch a { color: rgba(255,255,255,0.75); text-decoration: none; font-size: 0.8rem; font-weight: 700; padding: 4px 10px; border-radius: 6px; }
        .lang-switch a.activo { background: var(--teal); color: #fff; }
        .legal-cabecera { background: var(--bg-light); padding: 40px 0 28px; }
        .legal-cabecera h1 { font-weight: 800; font-size: 2rem; margin: 0 0 6px; }
        .legal-cabecera .fecha { color: var(--text-light); font-size: 0.9rem; }
        .legal-cuerpo { max-width: 820px; padding: 32px 16px 56px; line-height: 1.7; font-size: 0.97rem; }
        .legal-cuerpo h2 { font-size: 1.25rem; font-weight: 700; margin: 32px 0 10px; color: var(--primary); }
        .legal-cuerpo h3 { font-size: 1.05rem; font-weight: 700; margin: 20px 0 8px; }
        .legal-cuerpo table { font-size: 0.88rem; }
        .legal-cuerpo th { background: var(--bg-light); }
        .legal-cuerpo a { color: var(--primary); }
        .aviso-pendiente { background: #FEE2E2; color: #991B1B; border: 2px solid #DC2626; border-radius: 10px; padding: 12px 16px; font-weight: 600; margin-bottom: 24px; }
        .legal-pie { background: var(--primary-dark); color: rgba(255,255,255,0.7); font-size: 0.85rem; padding: 24px 0; }
        .legal-pie a { color: rgba(255,255,255,0.85); text-decoration: none; }
        .legal-pie a:hover { color: var(--teal); }
    </style>
</head>
<body>
<nav class="legal-nav">
    <div class="container d-flex justify-content-between align-items-center">
        <a class="marca" href="/">Congrega <span>CRM</span></a>
        <div class="lang-switch" role="group" aria-label="@L["Idioma"]">
            @foreach (var codigo in IdiomasSoportados.Codigos)
            {
                <a href="@Url.Action("CambiarIdioma", "Acceso", new { lang = codigo, returnUrl = Context.Request.Path.Value })"
                   class="@(codigo == IdiomasSoportados.Actual ? "activo" : "")"
                   title="@IdiomasSoportados.Nombres[codigo]"
                   hreflang="@codigo">@codigo.ToUpperInvariant()</a>
            }
        </div>
    </div>
</nav>

<header class="legal-cabecera">
    <div class="container" style="max-width:820px;">
        <h1>@ViewData["Title"]</h1>
        <div class="fecha">@L["Última actualización"]: @DatosLegales.FechaActualizacion.ToString("dd/MM/yyyy")</div>
    </div>
</header>

<main class="container legal-cuerpo">
    @if (!DatosLegales.Completos)
    {
        <div class="aviso-pendiente">⚠ Faltan datos del titular (NIF o domicilio) en Models/DatosLegales.cs. No publicar así.</div>
    }
    @RenderBody()
</main>

<footer class="legal-pie">
    <div class="container d-flex flex-column flex-md-row justify-content-between gap-3">
        <span>@L["© 2025 Congrega CRM. Todos los derechos reservados."]</span>
        <span class="d-flex flex-wrap gap-3">
            <a href="/aviso-legal">@L["Aviso legal"]</a>
            <a href="/privacidad">@L["Política de privacidad"]</a>
            <a href="/cookies">@L["Política de cookies"]</a>
            <a href="#configurar-cookies" data-abrir-cookies>@L["Configurar cookies"]</a>
        </span>
    </div>
</footer>

<partial name="_BannerCookies" />
</body>
</html>
